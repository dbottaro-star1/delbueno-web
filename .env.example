# Copy to .env for local overrides. All values are optional.
# Production defaults are used when a variable is not set.

# Origin the build is served from.
SITE_URL=https://delbuenostudio.com

# Path prefix the build is served under. Use / for the custom domain.
BASE_PATH=/

# Set to true for the GitHub Pages preview: adds meta robots noindex and a Disallow all robots.txt.
PREVIEW=false
