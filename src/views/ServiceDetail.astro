---
import Faq from '../components/Faq.astro';
import Art from '../components/services/Art.astro';
import CaseCard from '../components/services/CaseCard.astro';
import InnerCta from '../components/services/InnerCta.astro';
import InnerHero from '../components/services/InnerHero.astro';
import NextRows from '../components/services/NextRows.astro';
import Process from '../components/services/Process.astro';
import { casesFor } from '../components/services/related';
import '../components/services/inner.css';
import { getServices, type Service } from '../data/services';
import type { Lang } from '../i18n/config';
import { fill, t } from '../i18n';
import { innerCopy } from '../i18n/pages/services';
import { pagePath, servicePath } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { crumbs, serviceSchema } from '../lib/schema';

interface Props {
  lang: Lang;
  service: Service;
}
const { lang, service } = Astro.props;
const c = innerCopy[lang].detail;
const services = getServices(lang);
const path = servicePath(service.slug, lang);
const trail = crumbs(
  lang,
  { name: t(lang, 'pageName.services'), path: pagePath('services', lang) },
  { name: service.name, path },
);
const no = String(services.findIndex((s) => s.slug === service.slug) + 1).padStart(2, '0');
const cases = await casesFor(service.cases, lang);
const others = services.filter((s) => s.slug !== service.slug);
---

<BaseLayout
  lang={lang}
  title={fill(c.title, { name: service.name })}
  description={service.seoDescription}
  breadcrumbs={trail}
  jsonLd={[serviceSchema({ path, name: service.name, description: service.answer })]}
>
  <InnerHero
    lang={lang}
    crumbs={trail}
    label={fill(c.label, { no, total: services.length })}
    title={service.name}
    headline={service.headline}
    answer={service.answer}
    secondary={{ label: c.secondary, href: pagePath('engagements', lang) }}
  >
    <div class="in-hero__art">
      <Art lang={lang} slug={service.slug} />
    </div>
  </InnerHero>

  <section class="in-sec" aria-labelledby="who-h">
    <div class="in-split">
      <div class="in-split__a">
        <p class="label" data-rv>
          {c.whoLabel}
        </p>
        <h2 class="in-h2" id="who-h" data-split>
          {c.whoHeading}
        </h2>
        <p class="in-lead" data-rv style="margin-top: 28px">
          {service.whoFor.lead}
        </p>
      </div>
      <div class="in-split__b">
        <ul class="in-rows in-rows--big" data-rv>
          {service.whoFor.points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="in-sec" aria-labelledby="inc-h">
    <div class="in-head">
      <p class="label">{c.includedLabel}</p>
      <h2 class="in-h2" id="inc-h" data-split>
        {c.includedHeading}
      </h2>
    </div>
    <div class="in-split">
      <div class="in-split__a">
        <h3 class="in-h3" data-rv>
          {c.cover}
        </h3>
        <ul class="in-rows" data-rv>
          {service.covers.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
      <div class="in-split__b">
        <h3 class="in-h3" data-rv>
          {c.deliverables}
        </h3>
        <ul class="in-rows in-rows--mute" data-rv>
          {service.deliverables.map((d) => (
            <li>{d}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Process lang={lang} service={service} />

  {cases.length > 0 && (
    <section class="in-sec" aria-labelledby="out-h">
      <div class="in-head">
        <p class="label">{c.outcomesLabel}</p>
        <h2 class="in-h2" id="out-h" data-split>
          {c.outcomesHeading}
        </h2>
        <p class="in-sub" data-rv>
          {fill(c.outcomesSub, { name: service.name.toLowerCase() })}
        </p>
      </div>
      <div class="in-cases">
        {cases.map((entry) => (
          <CaseCard lang={lang} entry={entry} />
        ))}
      </div>
    </section>
  )}

  <section class="in-sec in-faq">
    <Faq lang={lang} items={service.faqs} />
  </section>

  <NextRows
    lang={lang}
    label={c.otherLabel}
    heading={c.otherHeading}
    items={[
      ...others.map((s) => ({ name: s.name, summary: s.summary, href: servicePath(s.slug, lang) })),
      { name: c.engagementsName, summary: c.engagementsSummary, href: pagePath('engagements', lang) },
    ]}
  />

  <InnerCta lang={lang} />

  <script>
    import '../scripts/services';
  </script>
</BaseLayout>
