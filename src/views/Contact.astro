---
// BaseLayout is imported first on purpose: stylesheets are emitted in import order, and the base .btn rule has to come
// before the larger .ip-cta-btn on this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoHero from '../components/info/InfoHero.astro';
import { LANG_META, type Lang } from '../i18n/config';
import { fill, t } from '../i18n';
import { contactCopy } from '../i18n/pages/contact';
import { pagePath } from '../i18n/routes';
import { canonicalUrl } from '../lib/url';
import { FOUNDER_ID, ORG_ID, crumbs, websiteId } from '../lib/schema';
import { BRAND, LINKS, SOCIALS } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = contactCopy[lang];

const path = pagePath('contact', lang);
const trail = crumbs(lang, { name: t(lang, 'pageName.contact'), path });
const { description } = c.meta;
const mailto = `mailto:${BRAND.email}?subject=${encodeURIComponent(c.mailSubject)}`;
---

<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={description}
  breadcrumbs={trail}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      '@id': `${canonicalUrl(path)}#webpage`,
      url: canonicalUrl(path),
      name: fill(c.meta.schemaName, { brand: BRAND.name }),
      description,
      inLanguage: LANG_META[lang].tag,
      isPartOf: { '@id': websiteId(lang) },
      about: { '@id': ORG_ID },
      mainEntity: { '@id': ORG_ID },
      contributor: { '@id': FOUNDER_ID },
    },
  ]}
>
  <InfoHero
    lang={lang}
    eyebrow={c.eyebrow}
    title={c.title}
    lede={c.lede}
    crumbs={trail}
    size="clamp(2.3rem, 7.4vw, 8.4rem)"
    maxWidth="100%"
  >
    <div class="ct-book" data-reveal>
      <a class="btn btn-primary ip-cta-btn" data-magnetic href={LINKS.book} rel="noopener noreferrer">
        {t(lang, 'cta.book')}{' '}
        <svg class="arr" aria-hidden="true">
          <use href="#i-arr"></use>
        </svg>
      </a>
      <p class="ct-note">{c.bookNote}</p>
    </div>
  </InfoHero>

  <section class="ip-sec" aria-labelledby="ct-mail-h">
    <div class="wrap">
      <p class="label" id="ct-mail-h">
        {c.writeLabel}
      </p>
      <div class="ct-mail" data-reveal>
        <a class="ct-addr" href={mailto} aria-label={fill(c.emailAria, { email: BRAND.email })}>
          <span class="ct-a">
            hello@
            <wbr />
            delbuenostudio.com
            <span class="ct-fx" aria-hidden="true">
              hello@
              <wbr />
              delbuenostudio.com
            </span>
          </span>
        </a>
        <div class="ct-actions">
          <button
            class="btn btn-ghost btn-sm ct-copy"
            type="button"
            data-copy={BRAND.email}
            data-copy-status="ct-status"
            data-copied={c.copy.done}
            data-status-ok={c.copy.ok}
            data-status-fail={c.copy.fail}
            hidden
          >
            <svg class="ct-ico" viewBox="0 0 16 16" aria-hidden="true">
              <rect
                x="5.5"
                y="5.5"
                width="8"
                height="8"
                rx="1.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <path
                d="M10.5 3.5v-.2A1.8 1.8 0 0 0 8.7 1.5H3.3a1.8 1.8 0 0 0-1.8 1.8v5.4a1.8 1.8 0 0 0 1.8 1.8h.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              />
            </svg>
            <span data-copy-label>{c.copy.idle}</span>
          </button>
          <a class="btn btn-ghost btn-sm" href={mailto}>
            {c.openMail}
          </a>
        </div>
        <p class="sr-only" id="ct-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="ip-sec" aria-labelledby="ct-exp-h">
    <div class="wrap">
      <div class="ip-head">
        <p class="label">{c.expectLabel}</p>
        <h2 class="ip-h2" id="ct-exp-h" data-lines>
          {c.expectHeading}
        </h2>
      </div>
      <ol class="ct-exp">
        {c.expect.map((e) => (
          <li data-reveal>
            <p class="ct-k">{e.k}</p>
            <h3>{e.t}</h3>
            <p class="ct-d">{e.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ip-sec ct-where" aria-labelledby="ct-where-h">
    <div class="wrap ct-where-grid">
      <div>
        <p class="label">{c.whereLabel}</p>
        <h2 class="ct-where-h" id="ct-where-h" data-lines>
          {BRAND.locality}, {BRAND.country}.
        </h2>
        <p class="ct-d" data-reveal>
          {c.where.before}{' '}
          <span class="ct-now" data-clock>
            --:--
          </span>{' '}
          {c.where.after}
        </p>
      </div>
      <ul class="tags ct-tags" data-reveal>
        {SOCIALS.map((s) => (
          <li>
            <a class="tag ct-tag" href={s.href} rel="me noopener noreferrer">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script>
    import { initClock } from '../scripts/info/clock';
    import { initCopy } from '../scripts/info/copy';
    import { initInfoReveals } from '../scripts/info/reveal';
    initInfoReveals();
    initClock();
    initCopy();
  </script>
</BaseLayout>

<style>
  .ct-book {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px clamp(20px, 3vw, 40px);
    margin-top: clamp(32px, 4.4vw, 64px);
  }

  .ct-note {
    color: var(--mute);
  }

  .ct-mail {
    margin-top: clamp(24px, 3vw, 44px);
    container-type: inline-size;
  }

  .ct-addr {
    display: block;
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
  }

  .ct-a {
    position: relative;
    display: inline-block;
    font: 800 min(5.5cqw, 7rem) / 1.02 var(--display);
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }

  .ct-fx {
    position: absolute;
    inset: 0;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.1s var(--out);
  }

  .ct-addr:focus-visible .ct-fx {
    clip-path: inset(0 0 0 0);
  }

  @media (hover: hover) and (pointer: fine) {
    .ct-addr:hover .ct-fx {
      clip-path: inset(0 0 0 0);
    }
  }

  .ct-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .ct-copy[hidden] {
    display: none;
  }

  .ct-ico {
    width: 16px;
    height: 16px;
  }

  .ct-copy.is-done {
    border-color: var(--lime);
    color: var(--lime);
  }

  .ct-exp {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .ct-exp li {
    padding: clamp(28px, 3.4vw, 48px) clamp(16px, 2vw, 32px) 0 0;
    container-type: inline-size;
  }

  .ct-exp li + li {
    padding-left: clamp(16px, 2vw, 32px);
    border-left: 1px solid var(--line);
  }

  .ct-k {
    font: 800 clamp(1.6rem, 11cqw, 4.4rem) / 0.95 var(--display);
    letter-spacing: -0.05em;
    background: var(--grad-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    padding-right: 0.05em;
    overflow-wrap: anywhere;
  }

  .ct-exp h3 {
    margin-top: 22px;
  }

  .ct-d {
    margin-top: 10px;
    color: var(--mute);
    max-width: 34ch;
  }

  .ct-where-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    align-items: end;
  }

  .ct-where-grid > div {
    grid-column: 1 / 9;
    min-width: 0;
  }

  .ct-where-h {
    margin-top: 18px;
    font: 800 clamp(2rem, 1rem + 4.3vw, 5.2rem) / 0.96 var(--display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .ct-now {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .ct-tags {
    grid-column: 9 / 13;
    justify-content: flex-end;
  }

  .ct-tag {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 18px;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .ct-tag:hover {
    color: var(--ink);
    border-color: rgb(255 255 255 / 0.3);
  }

  @media (max-width: 900px) {
    .ct-exp {
      grid-template-columns: 1fr;
    }

    .ct-exp li,
    .ct-exp li + li {
      padding: 28px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }

    .ct-where-grid > div,
    .ct-tags {
      grid-column: 1 / -1;
    }

    .ct-tags {
      justify-content: flex-start;
    }
  }
</style>
