---
import '../components/info/info.css';
import type { Lang } from '../i18n/config';
import { notFoundCopy } from '../i18n/pages/notfound';
import { pagePath } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = notFoundCopy[lang];
---

<BaseLayout lang={lang} title={c.meta.title} description={c.meta.description} noindex>
  <section
    class="nf"
    data-es-prefix={lang === 'en' ? url('/es/') : undefined}
    data-es-page={lang === 'en' ? url('/es/404/') : undefined}
  >
    <div class="wrap">
      <p class="label">{c.label}</p>
      <div class="nf-stage" data-nf>
        <span class="nf-text" aria-hidden="true">
          404
        </span>
        <canvas aria-hidden="true"></canvas>
      </div>
      <h1 class="nf-h1" data-lines>
        {c.heading}
      </h1>
      <p class="ip-lede" data-reveal>
        {c.lede.before}{' '}
        <a class="nf-mail" href={url(pagePath('contact', lang))}>
          {c.lede.link}
        </a>{' '}
        {c.lede.after}
      </p>
      <ul class="nf-links">
        {c.links.map((l, i) => (
          <li data-reveal>
            <a href={url(pagePath(l.page, lang))}>
              <span class="ip-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="nf-t">{l.t}</span>
              <span class="nf-d">{l.d}</span>
              <svg class="arr nf-arr" aria-hidden="true">
                <use href="#i-arr"></use>
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="nf-more">
        {c.more.or} <a href={url(pagePath('home', lang))}>{c.more.home}</a>
        {c.more.see} <a href={url(pagePath('services', lang))}>{c.more.services}</a> {c.more.or2}{' '}
        <a href={url(pagePath('contact', lang))}>{c.more.contact}</a>.
      </p>
    </div>
  </section>

  <script>
    import { initInfoReveals } from '../scripts/info/reveal';
    import { initNotFound, sendSpanishMisses } from '../scripts/info/notfound';
    // GitHub Pages serves one 404 page, so a missing /es/ address is handed to the Spanish one before anything else runs.
    sendSpanishMisses();
    initInfoReveals();
    initNotFound();
  </script>
</BaseLayout>

<style>
  .nf {
    padding: calc(var(--nav-h) + clamp(36px, 6vw, 96px)) 0 clamp(72px, 10vw, 160px);
  }

  .nf-stage {
    position: relative;
    height: clamp(170px, 34vw, 470px);
    margin-top: clamp(20px, 3vw, 40px);
    touch-action: pan-y;
    overflow: clip;
  }

  .nf-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .nf-text {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 800 clamp(4.5rem, 28vw, 30rem) / 0.8 var(--display);
    letter-spacing: -0.06em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .nf-stage.has-field .nf-text {
    opacity: 0;
  }

  .nf-h1 {
    margin-top: clamp(24px, 3vw, 48px);
    max-width: 18ch;
    font: 800 clamp(1.9rem, 1rem + 3.6vw, 4.6rem) / 0.98 var(--display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .nf-mail {
    color: var(--ink);
    border-bottom: 1px solid var(--line-2);
  }

  .nf-links {
    margin-top: clamp(32px, 4vw, 64px);
    border-top: 1px solid var(--line);
  }

  .nf-links a {
    display: grid;
    grid-template-columns: 44px minmax(0, 0.9fr) minmax(0, 1.4fr) 28px;
    align-items: center;
    column-gap: var(--gap);
    min-height: 44px;
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .nf-t {
    font: 800 clamp(1.7rem, 1rem + 3vw, 3.6rem) / 1 var(--display);
    letter-spacing: -0.045em;
    transition: transform 0.8s var(--out);
  }

  .nf-d {
    color: var(--mute);
  }

  .nf-arr {
    width: 22px;
    height: 22px;
    color: var(--mute);
    transition:
      transform 0.7s var(--out),
      color 0.4s;
  }

  .nf-links a:focus-visible .nf-arr {
    color: var(--lime);
  }

  @media (hover: hover) and (pointer: fine) {
    .nf-links a:hover .nf-t {
      transform: translateX(12px);
    }

    .nf-links a:hover .nf-arr {
      transform: translateX(6px);
      color: var(--lime);
    }
  }

  .nf-more {
    margin-top: 32px;
    color: var(--mute);
  }

  .nf-more a {
    color: var(--ink);
    border-bottom: 1px solid var(--line-2);
  }

  @media (max-width: 760px) {
    .nf-links a {
      grid-template-columns: minmax(0, 1fr) 28px;
      row-gap: 6px;
    }

    .nf-links .ip-no {
      display: none;
    }

    .nf-d {
      grid-column: 1;
      grid-row: 2;
    }

    .nf-arr {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
