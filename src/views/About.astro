---
import AboutClients from '../components/about/AboutClients.astro';
import AboutLocation from '../components/about/AboutLocation.astro';
import AboutNumbers from '../components/about/AboutNumbers.astro';
import AboutQuotes from '../components/about/AboutQuotes.astro';
import AboutValues from '../components/about/AboutValues.astro';
import InfoCta from '../components/info/InfoCta.astro';
import InfoHero from '../components/info/InfoHero.astro';
import Steps from '../components/info/Steps.astro';
import type { Lang } from '../i18n/config';
import { fill, t } from '../i18n';
import { aboutCopy } from '../i18n/pages/about';
import { pagePath } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOUNDER_ID, ORG_ID, crumbs, websiteId } from '../lib/schema';
import { BRAND, FOUNDER, LINKS } from '../lib/site';
import { LANG_META } from '../i18n/config';
import { canonicalUrl } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = aboutCopy[lang];

const path = pagePath('about', lang);
const trail = crumbs(lang, { name: t(lang, 'pageName.about'), path });
const { description } = c.meta;
---

<BaseLayout
  lang={lang}
  title={c.meta.title}
  description={description}
  breadcrumbs={trail}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      '@id': `${canonicalUrl(path)}#webpage`,
      url: canonicalUrl(path),
      name: fill(c.meta.schemaName, { brand: BRAND.name }),
      description,
      inLanguage: LANG_META[lang].tag,
      isPartOf: { '@id': websiteId(lang) },
      about: { '@id': ORG_ID },
      mainEntity: { '@id': FOUNDER_ID },
    },
  ]}
>
  <InfoHero
    lang={lang}
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    accent={c.hero.accent}
    lede={fill(c.hero.ledeTemplate, {
      brand: BRAND.name,
      founder: BRAND.founder,
      locality: BRAND.locality,
      country: BRAND.country,
    })}
    crumbs={trail}
    size="clamp(2.3rem, 7.2vw, 8rem)"
    maxWidth="100%"
  />

  <AboutNumbers lang={lang} />

  <section class="ip-sec" aria-labelledby="fo-h">
    <div class="wrap fo">
      <div class="fo-lead">
        <p class="label">{c.founder.label}</p>
        <h2 class="ip-h2" id="fo-h" data-lines>
          {fill(c.founder.heading, { name: FOUNDER.name })}
        </h2>
      </div>
      <div class="fo-body" data-reveal>
        <p class="fo-bio">{t(lang, 'founder.bio')}</p>
        <p class="fo-links">
          <a class="btn btn-ghost btn-sm" href={FOUNDER.linkedin} rel="me noopener noreferrer">
            LinkedIn
          </a>
          <a class="btn btn-ghost btn-sm" href={LINKS.dribbble} rel="me noopener noreferrer">
            Dribbble
          </a>
          <a class="btn btn-ghost btn-sm" href={LINKS.clutch} rel="me noopener noreferrer">
            Clutch
          </a>
        </p>
      </div>
    </div>
  </section>

  <AboutValues lang={lang} />
  <section class="ip-sec" aria-labelledby="ap-h">
    <div class="wrap">
      <div class="ip-head">
        <p class="label">{c.how.label}</p>
        <h2 class="ip-h2" id="ap-h" data-lines>
          {c.how.heading}
        </h2>
      </div>
      <Steps lang={lang} steps={c.how.steps} />
    </div>
  </section>
  <AboutLocation lang={lang} />
  <AboutClients lang={lang} />
  <AboutQuotes lang={lang} />
  <InfoCta lang={lang} heading={c.cta.heading} sub={c.cta.sub} />

  <script>
    import { initClock } from '../scripts/info/clock';
    import { initInfoReveals } from '../scripts/info/reveal';
    initInfoReveals();
    initClock();
  </script>
</BaseLayout>

<style>
  .fo {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(32px, 5vw, 64px);
  }

  .fo-lead {
    grid-column: 1 / 7;
  }

  .fo-lead .ip-h2 {
    grid-column: auto;
  }

  .fo-body {
    grid-column: 7 / 13;
    align-self: end;
  }

  .fo-bio {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.5;
    color: rgb(242 242 245 / 0.82);
    text-wrap: pretty;
  }

  .fo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  @media (max-width: 1000px) {
    .fo-lead,
    .fo-body {
      grid-column: 1 / -1;
    }
  }
</style>
