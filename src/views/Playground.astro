---
import { getImage } from 'astro:assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookCta from '../components/BookCta.astro';
import ShotCard from '../components/playground/ShotCard.astro';
import ShotLightbox from '../components/playground/ShotLightbox.astro';
import '../components/playground/shots.css';
import type { Lang } from '../i18n/config';
import { t } from '../i18n';
import { playgroundCopy } from '../i18n/pages/playground';
import { pagePath } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getShots, shotText, shotVideoSrc } from '../lib/content';
import { crumbs, playgroundSchema } from '../lib/schema';
import { LINKS } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = playgroundCopy[lang];

const shots = await getShots();
const path = pagePath('playground', lang);
const trail = crumbs(lang, { name: t(lang, 'pageName.playground'), path });

const { title, description } = c.meta;

const tagCounts = new Map<string, number>();
shots.forEach((shot) => shotText(shot, lang).tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
// Only tags that group at least three shots become filter chips, so the filter stays short.
const tags = [...tagCounts.entries()]
  .filter(([, n]) => n >= 3)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([t]) => t);

const items = await Promise.all(
  shots.map(async (s) => {
    const img = await getImage({ src: s.data.image, width: 1200, format: 'webp' });
    return {
      title: s.data.title,
      url: s.data.url,
      image: new URL(img.src, Astro.site).toString(),
      alt: shotText(s, lang).alt,
      width: s.data.width,
      height: s.data.height,
      video: (() => {
        const src = shotVideoSrc(s.data.video);
        return src ? new URL(src, Astro.site).toString() : undefined;
      })(),
      publishedAt: s.data.publishedAt,
      tags: shotText(s, lang).tags,
    };
  }),
);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  breadcrumbs={trail}
  jsonLd={[playgroundSchema(path, title, description, items, lang)]}
>
  <header class="page-top pgp-head">
    <div class="wrap stack">
      <Breadcrumbs lang={lang} items={trail} />
      <p class="label">{c.label}</p>
      <h1 data-reveal>{c.heading}</h1>
      <p class="lede" data-reveal>
        {c.lede}
      </p>
      <p data-reveal>
        <a class="pgp-follow" href={LINKS.dribbble} target="_blank" rel="noopener me">
          {c.follow}
          <svg class="arr" aria-hidden="true">
            <use href="#i-arr"></use>
          </svg>
        </a>
      </p>
    </div>
  </header>

  {shots.length > 0 ? (
    <section class="pgp" aria-label={c.shots}>
      <div class="wrap">
        {tags.length > 1 && (
          <div class="pgp-filter" role="group" aria-label={c.filterGroup}>
            <button type="button" class="chip" data-filter="all" aria-pressed="true">
              {c.all} <span class="chip__n">{shots.length}</span>
            </button>
            {tags.map((t) => (
              <button type="button" class="chip" data-filter={t} aria-pressed="false">
                {t} <span class="chip__n">{tagCounts.get(t)}</span>
              </button>
            ))}
          </div>
        )}
        <p
          class="sr-only"
          role="status"
          aria-live="polite"
          data-filter-status
          data-all={c.statusAll}
          data-one={c.statusOne}
          data-many={c.statusMany}
        />
        <ul class="pgp-grid">
          {shots.map((shot, i) => (
            <ShotCard lang={lang} shot={shot} variant="grid" eager={i < 3} />
          ))}
        </ul>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap">
        <p class="lede">{c.empty}</p>
      </div>
    </section>
  )}

  <BookCta lang={lang} heading={c.bookCta} />
  <ShotLightbox lang={lang} />

  <script>
    import { initPlayground } from '../scripts/playground';
    initPlayground();
  </script>
</BaseLayout>

<style is:global>
  .pgp-head {
    padding-bottom: var(--space-7);
  }

  .pgp-head h1 {
    font-size: min(var(--fs-2xl), 9.2vw);
    max-width: 18ch;
  }

  .pgp-follow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 44px;
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mute);
    transition: color 0.4s;
  }

  .pgp-follow .arr {
    width: 1.25em;
    height: 1.25em;
    color: var(--lime);
  }

  .pgp-follow:hover {
    color: var(--ink);
  }

  .pgp {
    padding-bottom: var(--space-9);
  }

  .pgp-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(24px, 3vw, 44px);
  }

  /* Phones: one swipeable row instead of a wall of chips above the shots. */
  @media (max-width: 760px) {
    .pgp-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter, 20px) * -1);
      padding-inline: var(--gutter, 20px);
      mask-image: linear-gradient(90deg, transparent, #000 var(--gutter, 20px), #000 calc(100% - 40px), transparent);
    }

    .pgp-filter::-webkit-scrollbar {
      display: none;
    }

    .chip {
      flex: 0 0 auto;
    }
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--mute);
    font: 400 0.875rem / 1 var(--sans);
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .chip__n {
    font: 400 0.6875rem / 1 var(--mono);
    color: var(--dim);
  }

  @media (hover: hover) {
    .chip:hover {
      color: var(--ink);
      border-color: rgb(255 255 255 / 0.3);
    }
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    color: #0a0a0f;
    border-color: var(--ink);
  }

  .chip[aria-pressed='true'] .chip__n {
    color: rgb(10 10 15 / 0.6);
  }

  /* masonry-ish: CSS columns keep each card's own aspect ratio */
  .pgp-grid {
    column-count: 1;
    column-gap: var(--gap);
  }

  .pgp-grid > .shot {
    break-inside: avoid;
    margin-bottom: var(--gap);
    width: 100%;
  }

  @media (min-width: 600px) {
    .pgp-grid {
      column-count: 2;
    }
  }

  @media (min-width: 1000px) {
    .pgp-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1500px) {
    .pgp-grid {
      column-count: 4;
    }
  }
</style>
