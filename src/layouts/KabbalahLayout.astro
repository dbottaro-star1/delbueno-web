---
/**
 * Layout for the Kabbalah app pages (/kabbalah/). Spanish only, with the app's own look (src/styles/kabbalah.css).
 * It keeps what every page of the site needs (the CSP meta tag, Seo tags, sitewide and breadcrumb JSON-LD) and leaves
 * out the studio shell: no studio nav, no motion bootstrap and no analytics or ads pixels on these pages.
 */
import '../styles/kabbalah.css';
import garamond from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';

import JsonLd from '../components/JsonLd.astro';
import LogoVasija from '../components/kabbalah/LogoVasija.astro';
import Seo from '../components/Seo.astro';
import { APP, KABBALAH_PATHS } from '../kabbalah/app';
import { breadcrumbSchema, sitewideSchema, type Crumb, type JsonLdNode } from '../lib/schema';
import { BRAND, IS_PREVIEW } from '../lib/site';
import { cspString } from '../../security/csp.mjs';
import { absoluteUrl, stripBase, url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Trail below the Kabbalah home. The home page passes nothing. */
  trail?: Crumb[];
  /** Links in the header. The landing shows its sections; the other pages link back to it. */
  nav?: { label: string; href: string }[];
  jsonLd?: JsonLdNode[];
}

const { title, description, trail = [], nav, jsonLd = [] } = Astro.props;

const path = stripBase(Astro.url.pathname);
const ogImage = absoluteUrl('/kabbalah/og.png', Astro.site);
const ogAlt = `${APP.storeName}, con el método de ${APP.teacher}. El Árbol de la Vida pintándose.`;
const crumbs: Crumb[] = [{ name: BRAND.name, path: '/es/' }, { name: APP.name, path: KABBALAH_PATHS.home }, ...trail];
const graph: JsonLdNode[] = [sitewideSchema('es'), breadcrumbSchema(crumbs), ...jsonLd];

const enlaces = nav ?? [{ label: `Volver a ${APP.name}`, href: KABBALAH_PATHS.home }];
const pie = [
  { label: 'Privacidad', href: KABBALAH_PATHS.privacy },
  { label: 'Soporte', href: KABBALAH_PATHS.support },
  { label: 'Borrar cuenta', href: KABBALAH_PATHS.deleteAccount },
];
const copyright = `© ${new Date().getFullYear()} ${APP.publisher}, ${APP.publisherCountry}.`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={cspString({ meta: true })} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F2F3F3" />
    <meta name="color-scheme" content="light" />

    <Seo
      title={title}
      description={description}
      lang="es"
      path={path}
      image={ogImage}
      imageAlt={ogAlt}
      siteName={APP.name}
      brandSuffix={false}
    />

    <link rel="icon" href={url('/kabbalah/icono.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/kabbalah/apple-touch-icon.png')} />
    {!IS_PREVIEW && <link rel="sitemap" href={url('/sitemap-index.xml')} />}

    <link rel="preload" as="font" type="font/woff2" href={garamond} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={plexMono} crossorigin />

    <JsonLd data={graph} />
  </head>
  <body>
    <a class="k-salto" href="#main">
      Saltar al contenido
    </a>
    <div class="k-grano" aria-hidden="true"></div>

    <header class="k-cabecera" data-cabecera>
      <div class="k-envoltura k-cabecera-in">
        <a class="k-marca" href={url(KABBALAH_PATHS.home)} aria-label={`${APP.name}, inicio`}>
          <LogoVasija size={34} />
          <span class="k-marca-nombre">{APP.name}</span>
        </a>
        <nav class="k-nav" aria-label="Principal">
          {enlaces.map((l) => (
            <a href={url(l.href)}>{l.label}</a>
          ))}
          <slot name="cta" />
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="k-pie">
      <div class="k-envoltura k-pie-in">
        <div class="k-pie-marca">
          <span class="k-marca">
            <LogoVasija size={30} />
            <span class="k-marca-nombre">{APP.name}</span>
          </span>
          <p>
            {APP.tagline}. El método y los textos son de {APP.teacher}.
          </p>
        </div>
        <ul class="k-pie-links">
          {pie.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={path === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${APP.email}`}>Contacto</a>
          </li>
        </ul>
        <div class="k-pie-legal">
          <span>{copyright}</span>
          <span>
            Una app de <a href={url('/es/')}>{BRAND.name}</a>
          </span>
        </div>
      </div>
    </footer>

    <script>
      import { initKabbalah } from '../scripts/kabbalah/init';
      initKabbalah();
    </script>
  </body>
</html>
