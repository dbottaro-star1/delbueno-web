---
/**
 * Vasija's brand mark for web and social: "Tikún", the repaired vessel (the bowl with its golden repair and the
 * light above), as in the brand pack's horizontal logo (redes-y-web/logo-horizontal-claro). The app icon is a
 * different mark, "Recibir" (public/kabbalah/icono.svg).
 *
 * Decorative next to the name, so it is hidden from screen readers.
 */
interface Props {
  size?: number;
  /** "claro" for light backgrounds (the default), "oscuro" for night blue ones. */
  tono?: 'claro' | 'oscuro';
  /** Draws itself on load: the bowl traces, the repair shines and the light drops in. */
  animado?: boolean;
  class?: string;
}
const { size = 32, tono = 'claro', animado = false, class: className } = Astro.props;
const color =
  tono === 'claro'
    ? { trazo: '#2F4560', reparo: '#C9A75E', luz: '#2B4FB3' }
    : { trazo: '#F2F3F3', reparo: '#D8C29E', luz: '#F2EBA0' };
---

<svg
  class:list={['logo-vasija', { animado }, className]}
  viewBox="4 4 24 21"
  width={size}
  height={(size * 21) / 24}
  fill="none"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path class="arco" pathLength="1" d="M6 13 A10 10 0 0 0 10.1 21.1" stroke={color.trazo} stroke-width="1.6"></path>
  <path
    class="arco arco-2"
    pathLength="1"
    d="M12.2 22.2 A10 10 0 0 0 26 13"
    stroke={color.trazo}
    stroke-width="1.6"
  ></path>
  <path class="reparo" d="M10.1 21.1 L12.2 22.2" stroke={color.reparo} stroke-width="2.3"></path>
  <circle class="luz" cx="16" cy="8" r="2.4" fill={color.luz}></circle>
</svg>

<style>
  .logo-vasija {
    flex: none;
    display: block;
    overflow: visible;
  }

  .luz {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .animado .arco {
      stroke-dasharray: 1;
      animation: trazar 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.15s backwards;
    }

    .animado .arco-2 {
      animation-delay: 0.45s;
    }

    .animado .reparo {
      animation: brillar 0.6s ease-out 1.1s backwards;
    }

    .animado .luz {
      animation: caer 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s backwards;
    }

    /* The light hops when the brand is hovered (header and footer). */
    :global(.k-marca:hover) .luz {
      animation: saltar 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }

  @keyframes trazar {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes brillar {
    from {
      opacity: 0;
    }
  }

  @keyframes caer {
    from {
      opacity: 0;
      transform: translateY(-9px) scale(0.6);
    }
  }

  @keyframes saltar {
    40% {
      transform: translateY(-3px) scale(1.15);
    }
  }
</style>
