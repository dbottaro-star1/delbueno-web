---
/**
 * Vasija's brand mark for web and social: "Tikún", the repaired vessel (the bowl with its golden repair and the
 * light above), as in the brand pack's horizontal logo (redes-y-web/logo-horizontal-claro). The app icon is a
 * different mark, "Recibir" (public/kabbalah/icono.svg).
 *
 * Decorative next to the name, so it is hidden from screen readers.
 */
interface Props {
  size?: number;
  /** "claro" for light backgrounds (the default), "oscuro" for night blue ones. */
  tono?: 'claro' | 'oscuro';
  class?: string;
}
const { size = 32, tono = 'claro', class: className } = Astro.props;
const color =
  tono === 'claro'
    ? { trazo: '#2F4560', reparo: '#C9A75E', luz: '#2B4FB3' }
    : { trazo: '#F2F3F3', reparo: '#D8C29E', luz: '#F2EBA0' };
---

<svg
  class:list={['logo-vasija', className]}
  viewBox="4 4 24 21"
  width={size}
  height={(size * 21) / 24}
  fill="none"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d="M6 13 A10 10 0 0 0 10.1 21.1" stroke={color.trazo} stroke-width="1.6"></path>
  <path d="M12.2 22.2 A10 10 0 0 0 26 13" stroke={color.trazo} stroke-width="1.6"></path>
  <path d="M10.1 21.1 L12.2 22.2" stroke={color.reparo} stroke-width="2.3"></path>
  <circle cx="16" cy="8" r="2.4" fill={color.luz}></circle>
</svg>

<style>
  .logo-vasija {
    flex: none;
    display: block;
  }
</style>
