---
/**
 * Waitlist for the Kabbalah app. Posts to Web3Forms, which forwards each signup to the studio inbox
 * (hello@delbuenostudio.com), the same account as the free UX audit form. With scripts it submits in place
 * (src/scripts/kabbalah/lista.ts); without them Web3Forms redirects back with ?enviado=1.
 *
 * Spam: `botcheck` is a honeypot hidden from people. The access key is public by design.
 * api.web3forms.com is already allowed in security/csp.json (form-action and connect-src).
 */
import { APP, KABBALAH_PATHS } from '../../kabbalah/app';
import { canonicalUrl, url } from '../../lib/url';

const endpoint = 'https://api.web3forms.com/submit';
const ACCESS_KEY = '9184f1f3-9b78-4c90-914a-22a74f0ea081';
const next = `${canonicalUrl(KABBALAH_PATHS.home)}?enviado=1#lista`;
---

<div class="lista" data-lista-root>
  <form class="lista-form" action={endpoint} method="POST" data-lista data-ajax={endpoint} data-enviando="Anotando…">
    <input type="hidden" name="access_key" value={ACCESS_KEY} />
    <input type="hidden" name="subject" value={`${APP.name}: nueva persona en la lista de espera`} />
    <input type="hidden" name="from_name" value={`${APP.name} (delbuenostudio.com)`} />
    <input type="hidden" name="redirect" value={next} />
    <input type="hidden" name="origen" value="" data-lista-origen />
    <div class="lista-trampa" aria-hidden="true">
      <label>
        Dejá esto sin marcar
        <input type="checkbox" name="botcheck" tabindex="-1" />
      </label>
    </div>

    <div class="lista-campo">
      <label for="lista-email">Tu correo</label>
      <input id="lista-email" name="email" type="email" required autocomplete="email" placeholder="nombre@correo.com" />
    </div>

    <div class="lista-campo">
      <label for="lista-nombre">
        Tu nombre <span class="lista-opcional">(opcional)</span>
      </label>
      <input id="lista-nombre" name="name" type="text" autocomplete="given-name" placeholder="Cómo te llamamos" />
    </div>

    <fieldset class="lista-campo">
      <legend>
        ¿Ya hiciste algo con {APP.teacher}? <span class="lista-opcional">(opcional)</span>
      </legend>
      <div class="lista-opciones">
        <label>
          <input type="radio" name="experiencia" value="Cuaderno de trabajo" /> El cuaderno de trabajo
        </label>
        <label>
          <input type="radio" name="experiencia" value="Curso" /> Un curso
        </label>
        <label>
          <input type="radio" name="experiencia" value="Lo sigo en redes" /> Lo sigo en redes
        </label>
        <label>
          <input type="radio" name="experiencia" value="Todavía no" /> Todavía no
        </label>
      </div>
    </fieldset>

    <button class="k-boton lista-boton" type="submit">
      <span data-lista-label>Anotarme</span>
    </button>
    <p class="lista-nota">
      Te escribimos solo para avisarte cuando salga. Podés pedir que te saquemos cuando quieras. Más en la{' '}
      <a href={url(KABBALAH_PATHS.privacy)}>política de privacidad</a>.
    </p>
    <p class="lista-error" role="alert" hidden data-lista-error>
      No se pudo enviar. Probá de nuevo en un rato o escribinos a <a href={`mailto:${APP.email}`}>{APP.email}</a>.
    </p>
  </form>

  <div class="lista-hecho" role="status" tabindex="-1" hidden data-lista-hecho>
    <p class="k-mano">¡Listo, ya estás!</p>
    <p>Te avisamos por correo apenas la app esté en las tiendas.</p>
  </div>
</div>

<style>
  .lista-form,
  .lista-hecho {
    display: grid;
    gap: 20px;
  }

  .lista-campo {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .lista-campo > label,
  .lista-campo legend {
    padding: 0;
    font: 500 0.75rem/1.3 var(--k-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-tinta-suave);
  }

  .lista-campo legend {
    margin-bottom: 10px;
  }

  .lista-opcional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--k-tinta-apagada);
  }

  .lista-campo input[type='email'],
  .lista-campo input[type='text'] {
    width: 100%;
    min-height: 54px;
    padding: 12px 16px;
    border: 1px solid var(--k-borde-fuerte);
    border-radius: 4px;
    background: var(--k-papel);
    color: var(--k-tinta);
    font: 400 1.1875rem/1.3 var(--k-serif);
    transition: border-color 0.2s;
  }

  .lista-campo input::placeholder {
    color: var(--k-tinta-apagada);
  }

  .lista-campo input:focus-visible {
    outline: none;
    border-color: var(--k-acento);
    box-shadow: 0 0 0 3px rgba(43, 79, 179, 0.15);
  }

  .lista-opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lista-opciones label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--k-borde-fuerte);
    border-radius: 999px;
    font-size: 1.0625rem;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .lista-opciones input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .lista-opciones label:has(input:checked) {
    background: var(--k-pizarra);
    border-color: var(--k-pizarra);
    color: var(--k-papel);
  }

  .lista-opciones label:has(input:focus-visible) {
    outline: 2px solid var(--k-acento);
    outline-offset: 2px;
  }

  .lista-boton {
    width: 100%;
  }

  .lista-nota {
    font-size: 0.9375rem;
    color: var(--k-tinta-secundaria);
  }

  .lista-nota a,
  .lista-error a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .lista-error {
    color: #a3352a;
    font-size: 1rem;
  }

  .lista-hecho {
    gap: 8px;
  }

  .lista-hecho:focus {
    outline: none;
  }

  .lista-hecho .k-mano {
    font-size: 2.25rem;
    line-height: 1;
  }

  .lista [hidden] {
    display: none;
  }

  .lista-trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
