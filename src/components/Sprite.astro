---
/** Shared SVG symbols: arrow, bolt and the bolt gradient. Rendered once per page by BaseLayout. */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="gBolt" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7B6BFF"></stop>
      <stop offset="1" stop-color="#BAFB44"></stop>
    </linearGradient>
  </defs>
  <symbol id="bolt" viewBox="0 0 24 32">
    <path d="M14.5 0 0 18.5h9.2L6.5 32 24 12.2h-9.6z"></path>
  </symbol>
  <symbol id="i-arr" viewBox="0 0 16 16">
    <path
      d="M2.5 8h11M9 3.5 13.5 8 9 12.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </symbol>
  <symbol id="i-x" viewBox="0 0 16 16">
    <path d="M3 3l10 10M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
  </symbol>
</svg>
