---
import type { Lang } from '../i18n/config';
import { translator } from '../i18n';
import { pagePath } from '../i18n/routes';
import { BRAND, FOOTER_LINKS, LINKS, NAV_LINKS, SOCIALS, type SiteLink } from '../lib/site';
import LangSwitch from './LangSwitch.astro';
import Recognition from './Recognition.astro';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
  /** Site-relative path of the equivalent page in each language, for the language switcher. */
  switchTo: Record<Lang, string>;
}
const { lang, switchTo } = Astro.props;
const t = translator(lang);
const year = new Date().getFullYear();
const link = (l: SiteLink) => ({
  href: url(pagePath(l.page, lang)),
  label: t(l.label),
});
---

<footer class="foot">
  <div class="foot-grid">
    <div class="foot-brand">
      <b>{BRAND.name}</b>
      {BRAND.locality}, {BRAND.country}. {t('footer.blurb')}
      <Recognition lang={lang} height={52} class="foot-badge" />
    </div>

    <nav class="foot-col" aria-label={t('footer.explore')}>
      <h2>{t('footer.explore')}</h2>
      {NAV_LINKS.map((l) => (
        <a href={link(l).href}>{link(l).label}</a>
      ))}
    </nav>

    <nav class="foot-col" aria-label={t('footer.studio')}>
      <h2>{t('footer.studio')}</h2>
      {FOOTER_LINKS.studio.map((l) => (
        <a href={link(l).href}>{link(l).label}</a>
      ))}
    </nav>

    <div class="foot-col foot-col--wide">
      <h2>{t('footer.contact')}</h2>
      <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
      <a href={LINKS.book} rel="noopener">
        {t('cta.book')}
      </a>
    </div>

    <div class="foot-col">
      <h2>{t('footer.elsewhere')}</h2>
      {SOCIALS.map((s) => (
        <a href={s.href} rel="noopener me" target="_blank">
          {s.label}
        </a>
      ))}
    </div>
  </div>

  <div class="foot-legal">
    <span>
      © {year} {BRAND.name}
    </span>
    <LangSwitch lang={lang} switchTo={switchTo} variant="footer" />
    <ul>
      {FOOTER_LINKS.legal.map((l) => (
        <li>
          <a href={link(l).href}>{link(l).label}</a>
        </li>
      ))}
    </ul>
  </div>

  <p class="foot-big" id="footBig" aria-hidden="true">
    delbueno<sup>™</sup>
  </p>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    padding: clamp(48px, 6vw, 88px) var(--pad) 0;
    border-top: 1px solid var(--line);
    background: var(--bg);
    overflow: hidden;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 36px;
  }

  .foot-brand {
    grid-column: 1 / 4;
    max-width: 34ch;
    color: var(--mute);
  }

  .foot-brand :global(.foot-badge) {
    margin-top: 24px;
  }

  .foot-brand b {
    display: block;
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .foot-col {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .foot-col--wide {
    grid-column: span 3;
  }

  .foot-col h2 {
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 8px;
  }

  .foot-col a {
    color: var(--ink);
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    min-width: 44px;
    padding-block: 8px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s;
  }

  .foot-col a:hover {
    border-color: var(--ink);
  }

  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .foot-legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .foot-legal a {
    display: inline-block;
    min-width: 44px;
    padding-block: 16px;
    transition: color 0.4s;
  }

  .foot-legal a:hover {
    color: var(--ink);
  }

  .foot-legal span {
    padding-block: 16px;
  }

  .foot-big {
    font: 800 13.2vw / 0.8 var(--display);
    letter-spacing: -0.07em;
    margin: clamp(32px, 5vw, 80px) 0 0 -0.05em;
    white-space: nowrap;
    user-select: none;
    padding-bottom: 0.02em;
  }

  .foot-big sup {
    font: 600 0.16em / 1 var(--sans);
    letter-spacing: 0;
    vertical-align: top;
    position: relative;
    top: 0.9em;
    margin-left: 0.1em;
  }

  @media (pointer: coarse) {
    .foot-col a {
      padding-block: 12px;
    }

    .foot-col {
      gap: 0;
    }
  }

  @media (max-width: 1023px) {
    .foot-brand {
      grid-column: 1 / -1;
    }

    .foot-col,
    .foot-col--wide {
      grid-column: span 6;
    }
  }

  @media (max-width: 560px) {
    .foot-col,
    .foot-col--wide {
      grid-column: 1 / -1;
    }

    .foot-col a {
      padding-block: 12px;
    }
  }
</style>
