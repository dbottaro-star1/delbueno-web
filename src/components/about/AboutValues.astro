---
/** Four values as a ruled list of huge words. Hover (fine pointers only) sweeps the gradient through the word. */
import type { Lang } from '../../i18n/config';
import { aboutCopy } from '../../i18n/pages/about';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { label, heading, items: values } = aboutCopy[lang].values;
---

<section class="ip-sec" aria-labelledby="av-h">
  <div class="wrap">
    <div class="ip-head">
      <p class="label">{label}</p>
      <h2 class="ip-h2" id="av-h" data-lines>
        {heading}
      </h2>
    </div>
    <ol class="av">
      {values.map((v) => (
        <li class="av-row" data-reveal>
          <h3 class="av-name">
            <span>{v.name}</span>
          </h3>
          <div class="av-body">
            <p class="av-line">{v.line}</p>
            <p class="av-text">{v.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .av {
    border-top: 1px solid var(--line);
  }

  .av-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: center;
    padding-block: clamp(28px, 3.6vw, 56px);
    border-bottom: 1px solid var(--line);
  }

  .av-name {
    grid-column: 1 / 9;
    container-type: inline-size;
  }

  .av-name span {
    font: 800 min(7.6cqw, 5.4rem) / 1.05 var(--display);
    letter-spacing: -0.05em;
  }

  .av-name span {
    display: inline-block;
    background: var(--grad) 100% 0 / 220% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--ink);
    -webkit-text-fill-color: var(--ink);
    transition:
      background-position 1.2s var(--out),
      transform 0.9s var(--out);
    padding-right: 0.04em;
  }

  .av-body {
    grid-column: 9 / 13;
  }

  .av-line {
    font: 600 var(--fs-md) / 1.25 var(--sans);
    letter-spacing: -0.02em;
  }

  .av-text {
    margin-top: 10px;
    color: var(--mute);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .av-row:hover .av-name span {
      background-position: 0 0;
      -webkit-text-fill-color: transparent;
      color: transparent;
      transform: translateX(14px);
    }
  }

  @media (max-width: 1000px) {
    .av-name {
      grid-column: 1 / -1;
    }

    .av-body {
      grid-column: 1 / 10;
      margin-top: 20px;
    }
  }

  @media (max-width: 700px) {
    .av-body {
      grid-column: 1 / -1;
    }
  }
</style>
