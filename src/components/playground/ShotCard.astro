---
/**
 * One Dribbble shot. Renders as a real link to the shot (works without JS); scripts/playground/shots.ts upgrades it
 * to a lightbox trigger and loads the optional mp4 only when the visitor shows intent.
 */
import { Image, getImage } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { playgroundCopy } from '../../i18n/pages/playground';
import { shotText, shotVideoSrc, type ShotEntry } from '../../lib/content';

interface Props {
  lang: Lang;
  shot: ShotEntry;
  variant: 'strip' | 'grid';
  /** Load the still eagerly (first cards of a strip). */
  eager?: boolean;
}
const { lang, shot, variant, eager = false } = Astro.props;
const { data } = shot;
const c = playgroundCopy[lang].card;
const { alt, tags } = shotText(shot, lang);

const full = await getImage({ src: data.image, width: 1600, format: 'webp' });
const sizes =
  variant === 'strip'
    ? '(max-width: 760px) 78vw, 480px'
    : '(min-width: 1500px) 25vw, (min-width: 1000px) 33vw, (min-width: 600px) 50vw, 100vw';
---

<li
  class={`shot shot--${variant}`}
  data-shot-item
  data-tags={tags.join('|')}
  style={`--ar:${data.width} / ${data.height};--ar-n:${(data.width / data.height).toFixed(4)}`}
>
  <a
    class="shot__link"
    href={data.url}
    target="_blank"
    rel="noopener"
    aria-label={`${data.title}, ${c.dribbbleShot}`}
    draggable="false"
    data-shot
    data-title={data.title}
    data-alt={alt}
    data-full={full.src}
    data-video={shotVideoSrc(data.video)}
    data-tags={tags.join('|')}
    data-w={data.width}
    data-h={data.height}
  >
    <span class="shot__media">
      <Image
        src={data.image}
        alt={alt}
        widths={[600, 960, 1400]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        draggable="false"
      />
      {data.video && (
        <video
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
          data-src={shotVideoSrc(data.video)}
        />
      )}
    </span>
    <span class="shot__chip" aria-hidden="true">
      <span class="shot__chip-t">{data.title}</span>
      {data.video && <span class="shot__chip-k">{c.motion}</span>}
    </span>
  </a>
</li>
