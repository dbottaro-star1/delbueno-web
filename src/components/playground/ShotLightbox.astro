---
/** Lightweight lightbox shared by the homepage strip and /playground. Driven by scripts/playground/lightbox.ts. */
import { LINKS } from '../../lib/site';
---

<dialog class="lb" id="lightbox" aria-labelledby="lb-title" data-lightbox>
  <div class="lb__panel" data-lb-panel>
    <button class="lb__close" type="button" aria-label="Close preview" data-lb-close>
      <svg class="arr" aria-hidden="true"><use href="#i-x"></use></svg>
    </button>
    <div class="lb__stage" data-lb-stage>
      <img class="lb__img" alt="" draggable="false" />
      <video class="lb__video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    </div>
    <div class="lb__bar">
      <div class="lb__meta">
        <h2 class="lb__title" id="lb-title" data-lb-title></h2>
        <ul class="lb__tags" data-lb-tags></ul>
      </div>
      <div class="lb__actions">
        <a class="btn btn-primary btn-sm lb__link" href={LINKS.dribbble} target="_blank" rel="noopener" data-lb-link>
          View on Dribbble <svg class="arr" aria-hidden="true"><use href="#i-arr"></use></svg>
        </a>
        <div class="lb__nav">
          <button class="lb__btn" type="button" aria-label="Previous shot" data-lb-prev>
            <svg class="arr lb__flip" aria-hidden="true"><use href="#i-arr"></use></svg>
          </button>
          <span class="lb__count" aria-live="polite" data-lb-count></span>
          <button class="lb__btn" type="button" aria-label="Next shot" data-lb-next>
            <svg class="arr" aria-hidden="true"><use href="#i-arr"></use></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  html.lb-open {
    overflow: hidden;
  }

  .lb {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    width: min(100vw - 2 * var(--pad), 1280px);
    max-width: none;
    max-height: none;
    overflow: visible;
    touch-action: none;
  }

  .lb::backdrop {
    background: rgb(5 5 8 / 0.86);
    animation: lb-fade 0.3s ease both;
  }

  .lb[open] .lb__panel {
    animation: lb-in 0.5s var(--out) both;
  }

  .lb.is-closing::backdrop {
    animation: lb-fade 0.2s ease reverse both;
  }

  .lb.is-closing .lb__panel {
    animation: lb-out 0.2s ease both;
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }

  @keyframes lb-out {
    to {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  .lb__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: 100vh;
    max-height: 100dvh;
    padding-block: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-bottom));
    will-change: transform;
  }

  .lb__stage {
    position: relative;
    flex: 0 1 auto;
    min-height: 0;
    margin-inline: auto;
    width: 100%;
    max-height: calc(100dvh - 190px);
    aspect-ratio: var(--lb-ar, 16 / 9);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--bg-2);
    touch-action: none;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8), inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .lb__stage img,
  .lb__stage video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lb__stage video {
    opacity: 0;
    transition: opacity 0.5s var(--out);
  }

  .lb__stage video.is-playing {
    opacity: 1;
  }

  .lb__close {
    position: absolute;
    top: max(24px, env(safe-area-inset-top));
    right: 12px;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(10 10 15 / 0.72);
    border: 1px solid var(--line-2);
    color: var(--ink);
    transition: background 0.3s;
  }

  .lb__close:hover {
    background: rgb(10 10 15 / 0.95);
  }

  .lb__bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-inline: 4px;
  }

  .lb__title {
    font: 700 clamp(1.25rem, 2vw, 1.75rem) / 1.1 var(--display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lb__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .lb__tags li {
    font: 400 0.6875rem / 1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 10px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--mute);
  }

  .lb__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .lb__nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lb__btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    transition: background 0.3s, border-color 0.3s;
  }

  .lb__btn:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.3);
  }

  .lb__btn[disabled] {
    opacity: 0.35;
    pointer-events: none;
  }

  .lb__flip {
    transform: scaleX(-1);
  }

  .lb__count {
    min-width: 5ch;
    text-align: center;
    font: 500 0.8125rem / 1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 560px) {
    .lb {
      width: calc(100vw - 24px);
    }

    .lb__stage {
      max-height: calc(100dvh - 230px);
    }
  }

  @media (max-height: 520px) {
    .lb__stage {
      max-height: calc(100dvh - 120px);
    }

    .lb__tags {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb::backdrop,
    .lb[open] .lb__panel,
    .lb.is-closing .lb__panel,
    .lb.is-closing::backdrop {
      animation: none;
    }
  }
</style>
