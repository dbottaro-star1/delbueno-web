---
import type { Lang } from '../i18n/config';
import type { Crumb } from '../lib/schema';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  lang: Lang;
  title: string;
  eyebrow?: string;
  lede?: string;
  crumbs?: Crumb[];
}
const { lang, title, eyebrow, lede, crumbs } = Astro.props;
---

<header class="page-top section-head">
  <div class="wrap stack">
    {crumbs && <Breadcrumbs lang={lang} items={crumbs} />}
    {eyebrow && <p class="label">{eyebrow}</p>}
    <h1 data-reveal>{title}</h1>
    {lede && (
      <p class="lede" data-reveal>
        {lede}
      </p>
    )}
    <slot />
  </div>
</header>

<style>
  .section-head {
    padding-bottom: var(--space-8);
  }

  h1 {
    font-size: min(var(--fs-2xl), 9.2vw);
    max-width: 18ch;
    overflow-wrap: break-word;
  }
</style>
