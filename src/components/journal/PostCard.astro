---
/** Journal card: image, meta line, title and a two line summary. Used for related posts. */
import { Image } from 'astro:assets';
import { formatShortDate, readingMinutes } from './reading';
import type { JournalEntry } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  entry: JournalEntry;
}
const { entry } = Astro.props;
const { data } = entry;
const minutes = readingMinutes(entry.body);
---

<a class="pc" href={url(`/${entry.id}/`)}>
  <span class="pc-media">
    {data.heroImage && (
      <Image
        src={data.heroImage}
        alt={data.heroAlt ?? ''}
        widths={[420, 640, 900]}
        sizes="(min-width: 900px) 30vw, 92vw"
        loading="lazy"
      />
    )}
  </span>
  <span class="pc-meta">
    <span>{data.category}</span>
    <span>
      <time datetime={data.pubDate.toISOString()}>{formatShortDate(data.pubDate)}</time>
    </span>
    <span>{minutes} min read</span>
  </span>
  <h3 class="pc-title">{data.title}</h3>
  <p class="pc-desc">{data.description}</p>
</a>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .pc-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .pc-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--out);
  }

  .pc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 6px;
    font: 400 var(--fs-xs) / 1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pc-meta span:first-child {
    color: var(--violet-2);
  }

  .pc-title {
    font: 700 clamp(1.1rem, 1rem + 0.45vw, 1.4rem) / 1.2 var(--display);
    letter-spacing: -0.025em;
    text-wrap: balance;
    background: linear-gradient(var(--ink), var(--ink)) no-repeat 0 100% / 0 1px;
    transition: background-size 0.7s var(--out);
    width: fit-content;
    max-width: 100%;
    padding-bottom: 2px;
  }

  .pc-desc {
    color: var(--mute);
    font-size: var(--fs-sm);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .pc:hover .pc-media img {
      transform: scale(1.05);
    }

    .pc:hover .pc-title {
      background-size: 100% 1px;
    }
  }
</style>
