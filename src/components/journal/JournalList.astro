---
/** Category filter plus the editorial list of posts. Pagination goes in the slot. */
import CategoryNav from './CategoryNav.astro';
import PostRow from './PostRow.astro';
import type { Lang } from '../../i18n/config';
import { translator } from '../../i18n';
import type { PostEntry } from '../../lib/content';

interface Props {
  lang: Lang;
  entries: PostEntry[];
  /** Show the category filter. The Spanish blog index has none: the category pages exist in English only. */
  categories?: boolean;
  active?: string;
  heading?: string;
}
const { lang, entries, categories = true, active, heading } = Astro.props;
const t = translator(lang);
---

<section class="jl" aria-labelledby="jl-h">
  <div class="wrap">
    <h2 class="sr-only" id="jl-h">
      {heading ?? t('journal.all')}
    </h2>
    {categories && <CategoryNav active={active} />}
    {entries.length > 0 ? (
      <ol class="jl-list">
        {entries.map((entry) => (
          <PostRow lang={lang} entry={entry} />
        ))}
      </ol>
    ) : (
      <p class="lede jl-empty">{t('journal.empty')}</p>
    )}
    <slot />
  </div>
</section>

<style>
  .jl {
    padding-block: clamp(24px, 4vw, 56px) clamp(72px, 10vw, 160px);
    border-top: 1px solid var(--line);
  }

  .jl-list {
    margin-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--line);
  }

  .jl-empty {
    margin-top: var(--space-7);
  }
</style>
