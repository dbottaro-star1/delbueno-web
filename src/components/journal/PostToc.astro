---
/**
 * Table of contents built from the post's h2 headings. Sticky beside the article on desktop, a collapsible
 * panel above it on narrow screens. scripts/journal/post.ts marks the section being read.
 */
interface Props {
  headings: { slug: string; text: string }[];
}
const { headings } = Astro.props;
---

{headings.length >= 2 && (
  <aside class="toc" aria-label="Table of contents" data-toc>
    <details class="toc-box" data-toc-box>
      <summary>
        <span class="label">In this article</span>
        <span class="toc-n ip-no">{String(headings.length).padStart(2, '0')}</span>
        <svg class="toc-chev" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M3.5 6 8 10.5 12.5 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </summary>
      <ol>
        {headings.map((h, i) => (
          <li>
            <a href={`#${h.slug}`} data-toc-link>
              <span class="ip-no" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>
    <p class="toc-read ip-no" aria-hidden="true">
      <span data-read-pct>0</span>% read
    </p>
  </aside>
)}

<style>
  .toc {
    min-width: 0;
  }

  .toc-box {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 20px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toc-n {
    margin-left: auto;
  }

  .toc-chev {
    width: 16px;
    height: 16px;
    color: var(--mute);
    transition: transform 0.5s var(--out);
  }

  [open] > summary .toc-chev {
    transform: rotate(180deg);
  }

  ol {
    padding: 4px 8px 12px;
    max-height: 60svh;
    overflow-y: auto;
  }

  a {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 8px;
    min-height: 44px;
    padding: 12px 12px;
    border-radius: 8px;
    font-size: var(--fs-sm);
    line-height: 1.35;
    color: var(--mute);
    transition:
      color 0.3s,
      background 0.3s;
  }

  a .ip-no {
    padding-top: 0.25em;
  }

  a:hover {
    color: var(--ink);
  }

  a[aria-current='true'] {
    color: var(--ink);
    background: rgb(255 255 255 / 0.05);
  }

  a[aria-current='true'] .ip-no {
    color: var(--lime);
  }

  .toc-read {
    display: none;
  }

  /* desktop: always open, pinned beside the article */
  @media (min-width: 1100px) {
    .toc {
      position: sticky;
      top: calc(var(--nav-h) + 24px);
      align-self: start;
    }

    .toc-box {
      border: 0;
      border-left: 1px solid var(--line);
      border-radius: 0;
      background: none;
    }

    summary {
      min-height: 0;
      padding: 0 12px 14px;
      pointer-events: none;
      cursor: default;
    }

    .toc-chev,
    .toc-n {
      display: none;
    }

    .toc-box::details-content {
      content-visibility: visible;
      display: block;
    }

    ol {
      max-height: calc(100svh - var(--nav-h) - 160px);
      padding: 0 0 0 4px;
    }

    .toc-read {
      display: block;
      margin: 18px 0 0 12px;
    }
  }
</style>
