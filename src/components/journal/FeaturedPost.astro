---
/** The latest post, set large: a wide image that opens with a clip reveal, then title, summary and the read link. */
import { Image } from 'astro:assets';
import { formatShortDate, readingMinutes } from './reading';
import type { Lang } from '../../i18n/config';
import { translator } from '../../i18n';
import { isSpanishPost, postHref, type PostEntry } from '../../lib/content';
import { url } from '../../lib/url';
import LangTag from '../LangTag.astro';

interface Props {
  lang: Lang;
  entry: PostEntry;
}
const { lang, entry } = Astro.props;
const t = translator(lang);
const { data } = entry;
const href = url(postHref(entry));
const minutes = readingMinutes(entry.body);
---

<article class="ft" aria-labelledby="ft-title">
  <div class="wrap">
    {data.heroImage && (
      <a class="ft-media" href={href} data-clip tabindex="-1" aria-hidden="true">
        <Image
          src={data.heroImage}
          alt=""
          widths={[800, 1200, 1800, 2400]}
          sizes="(min-width: 1440px) 1312px, 94vw"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    )}
    <div class="ft-grid">
      <p class="ft-meta">
        <span class="label">{t('journal.latest')}</span>
        <span>{data.category}</span>
        <time datetime={data.pubDate.toISOString()}>{formatShortDate(data.pubDate, lang)}</time>
        <span>{t('journal.minRead', { n: minutes })}</span>
        {lang !== 'en' && !isSpanishPost(entry) && <LangTag lang={lang} />}
      </p>
      <h2 class="ft-title" id="ft-title">
        <a href={href}>{data.title}</a>
      </h2>
      <div class="ft-side">
        <p>{data.description}</p>
        <a class="btn btn-primary" data-magnetic href={href}>
          {t('journal.read')}{' '}
          <svg class="arr" aria-hidden="true">
            <use href="#i-arr"></use>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .ft {
    padding-bottom: clamp(56px, 8vw, 120px);
  }

  .ft-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    max-height: 72svh;
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .ft-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ft-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 24px;
    margin-top: clamp(28px, 4vw, 56px);
  }

  .ft-meta {
    grid-column: 1 / 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    font: 400 var(--fs-xs) / 1.3 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .ft-meta .label {
    color: var(--lime);
  }

  .ft-meta .label::before {
    background: var(--lime);
  }

  .ft-title {
    grid-column: 4 / 10;
    font: 800 clamp(1.8rem, 1.1rem + 2.3vw, 3.5rem) / 1 var(--display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .ft-title a {
    background: var(--grad) no-repeat 0 100% / 0 3px;
    transition: background-size 1s var(--out);
    padding-bottom: 0.08em;
  }

  .ft-side {
    grid-column: 10 / 13;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    color: var(--mute);
  }

  @media (hover: hover) and (pointer: fine) {
    .ft:hover .ft-title a {
      background-size: 100% 3px;
    }
  }

  @media (max-width: 1100px) {
    .ft-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 20px;
    }

    .ft-title {
      grid-column: 1 / -1;
    }

    .ft-side {
      grid-column: 1 / 10;
    }
  }

  @media (max-width: 700px) {
    .ft-media {
      aspect-ratio: 4 / 3;
    }

    .ft-side {
      grid-column: 1 / -1;
    }
  }
</style>
