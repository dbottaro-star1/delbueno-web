---
/**
 * Author box at the end of a post. Only shown for the founder, whose profile lives in src/lib/site.ts and src/i18n.
 * Posts are published in English only, so this box is English too.
 */
import { t } from '../../i18n';
import { pagePath } from '../../i18n/routes';
import { FOUNDER } from '../../lib/site';
import { url } from '../../lib/url';
---

<aside class="au" aria-label="About the author">
  <span class="au-mark" aria-hidden="true">
    DB
  </span>
  <div class="au-body">
    <p class="label">Written by</p>
    <p class="au-name">
      <a href={url(pagePath('author', 'en'))} rel="author">
        {FOUNDER.name}
      </a>
    </p>
    <p class="au-role">{t('en', 'founder.jobTitle')}, delbueno™ Studio</p>
    <p class="au-bio">{t('en', 'founder.bio')}</p>
    <p class="au-links">
      <a class="btn btn-ghost btn-sm" href={FOUNDER.linkedin} rel="me noopener noreferrer">
        LinkedIn
      </a>
      <a class="btn btn-ghost btn-sm" href={url(pagePath('author', 'en'))}>
        All articles by Dani
      </a>
      <a class="btn btn-ghost btn-sm" href={url(pagePath('about', 'en'))}>
        About the studio
      </a>
    </p>
  </div>
</aside>

<style>
  .au {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: clamp(16px, 2.4vw, 32px);
    margin-top: clamp(56px, 7vw, 96px);
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }

  .au-mark {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    font: 800 1.4rem / 1 var(--display);
    letter-spacing: -0.04em;
    color: var(--ink);
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 1.5px solid transparent;
  }

  .au-body > * + * {
    margin-top: 10px;
  }

  .au-name {
    margin-top: 16px;
    font: 800 clamp(1.5rem, 1.2rem + 1vw, 2.1rem) / 1 var(--display);
    letter-spacing: -0.04em;
  }

  .au-name a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  @media (hover: hover) and (pointer: fine) {
    .au-name a:hover {
      border-color: var(--ink);
    }
  }

  .au-role {
    font: 400 var(--fs-xs) / 1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .au-bio {
    color: var(--mute);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 60ch;
  }

  .au-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  @media (max-width: 560px) {
    .au {
      grid-template-columns: 1fr;
    }
  }
</style>
