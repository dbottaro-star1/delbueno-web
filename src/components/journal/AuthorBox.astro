---
/**
 * Author box at the end of a post. Only shown for the founder, whose profile lives in src/lib/site.ts and src/i18n.
 * It speaks the language of the post.
 */
import type { Lang } from '../../i18n/config';
import { translator } from '../../i18n';
import { postCopy } from '../../i18n/pages/post';
import { pagePath } from '../../i18n/routes';
import { FOUNDER } from '../../lib/site';
import { url } from '../../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = postCopy[lang].author;
---

<aside class="au" aria-label={c.label}>
  <span class="au-mark" aria-hidden="true">
    DB
  </span>
  <div class="au-body">
    <p class="label">{c.writtenBy}</p>
    <p class="au-name">
      <a href={url(pagePath('author', lang))} rel="author">
        {FOUNDER.name}
      </a>
    </p>
    <p class="au-role">{t('founder.jobTitle')}, delbueno™ Studio</p>
    <p class="au-bio">{t('founder.bio')}</p>
    <p class="au-links">
      <a class="btn btn-ghost btn-sm" href={FOUNDER.linkedin} rel="author me noopener noreferrer">
        LinkedIn
      </a>
      <a class="btn btn-ghost btn-sm" href={url(pagePath('author', lang))}>
        {c.allByAuthor}
      </a>
      <a class="btn btn-ghost btn-sm" href={url(pagePath('about', lang))}>
        {c.aboutStudio}
      </a>
    </p>
  </div>
</aside>

<style>
  .au {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: clamp(16px, 2.4vw, 32px);
    margin-top: clamp(56px, 7vw, 96px);
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }

  .au-mark {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    font: 800 1.4rem / 1 var(--display);
    letter-spacing: -0.04em;
    color: var(--ink);
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 1.5px solid transparent;
  }

  .au-body > * + * {
    margin-top: 10px;
  }

  .au-name {
    margin-top: 16px;
    font: 800 clamp(1.5rem, 1.2rem + 1vw, 2.1rem) / 1 var(--display);
    letter-spacing: -0.04em;
  }

  .au-name a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  @media (hover: hover) and (pointer: fine) {
    .au-name a:hover {
      border-color: var(--ink);
    }
  }

  .au-role {
    font: 400 var(--fs-xs) / 1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .au-bio {
    color: var(--mute);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 60ch;
  }

  .au-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  @media (max-width: 560px) {
    .au {
      grid-template-columns: 1fr;
    }
  }
</style>
