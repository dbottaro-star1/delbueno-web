---
/** One technology: its brand mark and name. A tool without a Simple Icons mark gets a tile with its initials. */
import type { StackItem } from '../../data/stack';

interface Props {
  item: StackItem;
}
const { item } = Astro.props;

/** WCAG relative luminance of a hex colour such as "F24E1E". */
function luminance(hex: string): number {
  const [r, g, b] = [0, 2, 4].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

const { icon, mono, name } = item;
// Brand colours too dark for the near-black page fall back to the ink colour.
const fill = icon ? (luminance(icon.hex) < 0.12 ? 'currentColor' : `#${icon.hex}`) : undefined;
---

<li class="st-chip">
  {icon ? (
    <svg class="st-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d={icon.path} fill={fill} />
    </svg>
  ) : (
    <span class="st-mark st-mono" aria-hidden="true">
      {mono}
    </span>
  )}
  <span class="st-label">{name}</span>
</li>
