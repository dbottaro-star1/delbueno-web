---
/** Closing call to action for the info pages, in the homepage final CTA language. */
import { BRAND, LINKS } from '../../lib/site';
import './info.css';

interface Props {
  heading?: string;
  label?: string;
  sub?: string;
}
const { heading = 'Let’s build something people get instantly.', label = 'Next', sub } = Astro.props;
---

<section class="ip-cta" aria-labelledby="ip-cta-h">
  <div class="wrap">
    <p class="label">{label}</p>
    <h2 class="ip-cta-h" id="ip-cta-h" data-lines>
      {heading}
    </h2>
    {sub && (
      <p class="ip-lede" data-reveal>
        {sub}
      </p>
    )}
    <div class="ip-cta-row" data-reveal>
      <a class="btn btn-primary ip-cta-btn" data-magnetic href={LINKS.book} rel="noopener">
        Book a call{' '}
        <svg class="arr" aria-hidden="true">
          <use href="#i-arr"></use>
        </svg>
      </a>
      <p class="ip-cta-alt">
        or <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
      </p>
    </div>
  </div>
</section>
