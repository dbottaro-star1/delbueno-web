---
import { Image } from 'astro:assets';
import { formatDate, type JournalEntry } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  entry: JournalEntry;
}
const { entry } = Astro.props;
const { data } = entry;
---

<a class="card post" href={url(`/${entry.id}/`)}>
  {
    data.heroImage && (
      <Image src={data.heroImage} alt={data.heroAlt ?? ''} widths={[400, 800]} sizes="(min-width: 900px) 33vw, 100vw" />
    )
  }
  <p class="label">{data.category}</p>
  <h3>{data.title}</h3>
  <p>{data.description}</p>
  <p class="meta"><time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time></p>
</a>

<style>
  .post img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius) - 4px);
  }

  .meta {
    font: 400 var(--fs-xs) / 1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--dim);
  }
</style>
