---
import type { Lang } from '../i18n/config';
import { translator } from '../i18n';
import { pagePath } from '../i18n/routes';
import { BRAND, LINKS, NAV_LINKS } from '../lib/site';
import { stripBase, url } from '../lib/url';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  /** Site-relative path of the equivalent page in each language, for the language switcher. */
  switchTo: Record<Lang, string>;
}
const { lang, switchTo } = Astro.props;
const t = translator(lang);

const current = stripBase(Astro.url.pathname);
const links = NAV_LINKS.map((link) => ({ label: t(link.label), href: pagePath(link.page, lang) }));
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="nav" id="nav" data-nav>
  <a class="wordmark" href={url(pagePath('home', lang))} aria-label={t('a11y.homeLink', { brand: BRAND.name })}>
    delbueno<sup>™</sup>
  </a>

  <nav aria-label={t('nav.primary')}>
    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={url(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
            <span class="roll">
              <span>{link.label}</span>
              <span aria-hidden="true">{link.label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="nav-right">
    <LangSwitch lang={lang} switchTo={switchTo} />
    <a class="btn btn-primary btn-sm" data-magnetic href={LINKS.book} rel="noopener">
      {t('cta.book')}
    </a>
    <button
      class="burger"
      id="burger"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label={t('nav.menu')}
      data-label-open={t('nav.menu')}
      data-label-close={t('nav.closeMenu')}
      data-nav-toggle
    >
      <i></i>
      <i></i>
    </button>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={t('nav.menu')} data-menu>
  <nav aria-label={t('nav.mobile')}>
    {links.map((link) => (
      <a class="m-link" href={url(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="menu-foot">
    <LangSwitch lang={lang} switchTo={switchTo} variant="menu" />
    <a class="btn btn-primary" href={LINKS.book} rel="noopener">
      {t('cta.book')}
    </a>
    <a class="menu-mail" href={`mailto:${BRAND.email}`}>
      {BRAND.email}
    </a>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--pad);
    transition: background 0.5s;
  }

  .nav.is-solid,
  .rm .nav {
    background: rgb(10 10 15 / 0.88);
  }

  .nav.is-solid::after,
  .rm .nav::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--line);
  }

  .wordmark {
    font: 800 1.5rem / 1 var(--display);
    letter-spacing: -0.05em;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .wordmark sup {
    font: 600 0.45em / 1 var(--sans);
    vertical-align: top;
    position: relative;
    top: -0.15em;
    margin-left: 0.1em;
    letter-spacing: 0;
  }

  .nav-links {
    display: flex;
    gap: clamp(20px, 2.6vw, 40px);
    font-size: 0.9375rem;
    color: var(--mute);
  }

  .nav-links a {
    display: inline-block;
    min-width: 44px;
    padding-block: 12px;
    transition: color 0.4s;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    position: relative;
  }

  .burger i {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.6s var(--out);
  }

  .burger i:first-child {
    top: 18px;
  }

  .burger i:last-child {
    top: 25px;
  }

  .burger[aria-expanded='true'] i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .burger[aria-expanded='true'] i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--bg);
    padding: calc(var(--nav-h) + 24px) var(--pad) max(32px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.9s var(--in-out),
      visibility 0s 0.9s;
  }

  .menu.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 0.9s var(--in-out),
      visibility 0s;
  }

  .m-link {
    display: block;
    font: 800 clamp(1.9rem, 8.2vw, 4rem) / 1.1 var(--display);
    overflow-wrap: anywhere;
    letter-spacing: -0.04em;
    padding: 0.18em 0;
    border-bottom: 1px solid var(--line);
  }

  .m-link[aria-current='page'] {
    color: var(--lime);
  }

  .menu-foot {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
    color: var(--mute);
    font-size: 0.9375rem;
  }

  .menu-foot .btn {
    align-self: flex-start;
  }

  .menu-mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Seven links: tighten the gaps between 1024 and 1100 px so the row keeps room next to the wordmark and buttons.
     Below 1024 px the links move into the menu (see below). */
  @media (max-width: 1100px) {
    .nav-links {
      gap: clamp(14px, 1.9vw, 24px);
    }
  }

  @media (max-width: 1023px) {
    .nav-links {
      display: none;
    }

    .burger {
      display: block;
    }
  }

  @media (max-width: 860px) {
    :global(:root) {
      --nav-h: 64px;
    }

    .nav-right .btn {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .menu {
      display: none;
    }
  }
</style>
