---
import type { JournalEntry } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  entry: JournalEntry;
}
const { entry } = Astro.props;
const { data } = entry;
---

<a class="in-post" href={url(`/${entry.id}/`)} data-rv>
  <span class="in-post__cat">{data.category}</span>
  <span class="in-post__t">
    {data.title}
    <span class="in-post__d">{data.description}</span>
  </span>
  <svg class="arr" aria-hidden="true">
    <use href="#i-arr"></use>
  </svg>
</a>
