    <path class="a-s" pathLength="1" d="M42 232h44M42 246h28M146 232h44M146 246h28M250 232h44M250 246h28" />
  </svg>
)}
{slug === 'build' && (
  <svg class:list={['in-hero-art art', 'art-draw']} viewBox="0 0 360 300" aria-hidden="true" focusable="false">
    <rect class="a-s" pathLength="1" x="14" y="20" width="132" height="44" rx="6" />
    <path class="a-s" pathLength="1" d="M30 42h60" />
    <path class="a-s" pathLength="1" d="M80 64v36" />
    <path class="a-s" pathLength="1" d="m75 94 5 6 5-6" />
    <rect class="a-v" pathLength="1" x="14" y="100" width="132" height="44" rx="6" />
    <path class="a-s" pathLength="1" d="M30 122h84" />
    <path class="a-s" pathLength="1" d="M80 144v36" />
    <path class="a-s" pathLength="1" d="m75 174 5 6 5-6" />
    <rect class="a-l" pathLength="1" x="14" y="180" width="132" height="44" rx="6" />
    <path class="a-s" pathLength="1" d="M30 202h44" />
    <rect class="a-s" pathLength="1" x="176" y="20" width="170" height="204" rx="8" />
    <path class="a-s" pathLength="1" d="M176 46h170" />
    <text x="192" y="38" style="font-size:10px">
      {words.terminal}
    </text>
    <text x="192" y="76">
      {words.build}
    </text>
    <text x="192" y="98">
      {words.test}
    </text>
    <text x="192" y="120">
      {words.automate}
    </text>
    <text x="192" y="142" style="fill:#BAFB44">
      ✓ {words.shipped}
    </text>
    <path class="a-s" pathLength="1" d="M14 252h332" />
    <path class="a-l" pathLength="1" d="M14 252h236" />
    <text x="14" y="276">
      {words.mvp}
    </text>
  </svg>
)}
