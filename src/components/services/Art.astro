---
import type { Lang } from '../../i18n/config';
import { innerCopy } from '../../i18n/pages/services';

interface Props {
  lang: Lang;
  slug: 'product-strategy' | 'product-design' | 'web-design' | 'build';
}
const { lang, slug } = Astro.props;
const words = innerCopy[lang].art;
---

{slug === 'product-strategy' && (
  <svg class:list={['in-hero-art art', 'art-draw']} viewBox="0 0 360 300" aria-hidden="true" focusable="false">
    <circle class="a-s" pathLength="1" cx="34" cy="150" r="8" />
    <path class="a-s" pathLength="1" d="M42 150C96 150 96 56 150 56" />
    <path class="a-s" pathLength="1" d="M42 150H150" />
    <path class="a-s" pathLength="1" d="M42 150C96 150 96 244 150 244" />
    <rect class="a-s" pathLength="1" x="150" y="40" width="76" height="32" rx="5" />
    <rect class="a-s" pathLength="1" x="150" y="134" width="76" height="32" rx="5" />
    <rect class="a-s" pathLength="1" x="150" y="228" width="76" height="32" rx="5" />
    <path class="a-s" pathLength="1" d="M162 52h30M162 62h46M162 146h38M162 156h24M162 240h34M162 250h50" />
    <path class="a-v" pathLength="1" d="M226 56C282 56 282 150 322 150" />
    <path class="a-v" pathLength="1" d="M226 150H322" />
    <path class="a-v" pathLength="1" d="M226 244C282 244 282 150 322 150" />
    <circle class="a-fl" cx="326" cy="150" r="6" />
    <text x="262" y="132">
      {words.decide}
    </text>
  </svg>
)}
{slug === 'product-design' && (
  <svg class:list={['in-hero-art art', 'art-draw']} viewBox="0 0 360 300" aria-hidden="true" focusable="false">
    <rect class="a-s" pathLength="1" x="14" y="14" width="160" height="124" rx="8" />
    <rect class="a-l" pathLength="1" x="32" y="36" width="76" height="28" rx="14" />
    <path class="a-s" pathLength="1" d="M46 50h48" />
    <rect class="a-s" pathLength="1" x="32" y="86" width="46" height="22" rx="11" />
    <circle class="a-fv" cx="67" cy="97" r="8" />
    <path class="a-s" pathLength="1" d="M96 97h58" />
    <rect class="a-s" pathLength="1" x="186" y="14" width="160" height="56" rx="8" />
    <path class="a-v" pathLength="1" d="M202 42h2" />
    <path class="a-s" pathLength="1" d="M202 32h60M202 52h36" />
    <path class="a-l" pathLength="1" d="M300 28v28" />
    <rect class="a-s" pathLength="1" x="186" y="82" width="160" height="56" rx="8" />
    <circle class="a-fv" cx="214" cy="110" r="14" fill-opacity=".35" />
    <circle class="a-fv" cx="248" cy="110" r="14" fill-opacity=".7" />
    <circle class="a-fl" cx="282" cy="110" r="14" />
    <rect class="a-s" pathLength="1" x="14" y="150" width="332" height="136" rx="8" />
    <text
      x="30"
      y="228"
      style="font-family:var(--display);font-weight:800;font-size:60px;fill:rgba(255,255,255,.9);letter-spacing:-3px"
    >
      Aa
    </text>
    <path class="a-s" pathLength="1" d="M190 190h130M190 212h104M190 234h118M190 256h72" />
    <path class="a-v" pathLength="1" d="M190 190h46" />
  </svg>
)}
{slug === 'web-design' && (
  <svg class:list={['in-hero-art art', 'art-draw']} viewBox="0 0 360 300" aria-hidden="true" focusable="false">
    <rect class="a-s" pathLength="1" x="12" y="12" width="336" height="276" rx="10" />
    <path class="a-s" pathLength="1" d="M12 44h336" />
    <circle class="a-s" pathLength="1" cx="30" cy="28" r="4" />
    <circle class="a-s" pathLength="1" cx="44" cy="28" r="4" />
    <circle class="a-s" pathLength="1" cx="58" cy="28" r="4" />
    <path class="a-s" pathLength="1" d="M30 86h130M30 104h170M30 122h96" />
    <path class="a-v" pathLength="1" d="M30 86h130" />
    <rect class="a-l" pathLength="1" x="30" y="146" width="84" height="30" rx="15" />
    <rect class="a-s" pathLength="1" x="216" y="70" width="116" height="116" rx="8" />
