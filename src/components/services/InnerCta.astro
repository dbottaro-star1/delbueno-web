---
import type { Lang } from '../../i18n/config';
import { innerCopy } from '../../i18n/pages/services';
import { translator } from '../../i18n';
import { BRAND, LINKS } from '../../lib/site';

interface Props {
  lang: Lang;
  heading?: string;
}
const { lang, heading = innerCopy[lang].cta.heading } = Astro.props;
const t = translator(lang);
---

<section class="in-cta" aria-labelledby="cta-h">
  <p class="label">{t('cta.next')}</p>
  <h2 class="in-h2" id="cta-h" data-split>
    {heading}
  </h2>
  <div class="in-cta__row" data-rv>
    <a class="btn btn-primary in-cta__btn" data-magnetic href={LINKS.book} rel="noopener noreferrer">
      {t('cta.book')}{' '}
      <svg class="arr" aria-hidden="true">
        <use href="#i-arr"></use>
      </svg>
    </a>
    <p class="in-cta__mail">
      {t('cta.or')} <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
    </p>
  </div>
</section>
