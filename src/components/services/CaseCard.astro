---
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { fill } from '../../i18n';
import { workCopy } from '../../i18n/pages/work';
import { workPath } from '../../i18n/routes';
import { workSlug, type WorkEntry } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  lang: Lang;
  entry: WorkEntry;
}
const { lang, entry } = Astro.props;
const { data } = entry;
const slug = workSlug(entry);
const c = workCopy[lang].inline;
const metric = data.metrics[0];
const concept = slug === 'toyota';
---

<a class="in-case" href={url(workPath(slug, lang))} data-rv>
  <div class="in-case__media">
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw"
    />
    {concept && <span class="in-case__flag">{c.conceptFlag}</span>}
  </div>
  <p class="in-case__meta">
    <span>{data.client}</span>
    <span>{data.industry}</span>
  </p>
  {metric && (
    <>
      <p class="in-case__num">{metric.value}</p>
      <p class="in-case__lab">{concept ? fill(c.projection, { label: metric.label }) : metric.label}</p>
    </>
  )}
</a>
