---
/** Title, description, canonical, robots, Open Graph and Twitter tags. */
import { DEFAULT_LANG, LANG_META, LANGS, type Lang } from '../i18n/config';
import { BRAND, IS_PREVIEW, TITLE_MAX, TITLE_SUFFIX } from '../lib/site';
import { canonicalUrl } from '../lib/url';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Site-relative path of the page, for example /services/. */
  path: string;
  /** The same page in each language (site-relative paths). Empty when the page has no translation. */
  alternates?: Partial<Record<Lang, string>>;
  /** Absolute image URL. */
  image: string;
  imageAlt: string;
  /** Pixel size of the image. Every card and hero image is cut at 1200 by 630. */
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  section?: string;
}

const {
  title: pageTitle,
  description,
  lang,
  path,
  alternates = {},
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  section,
} = Astro.props;

// The brand suffix is added only when the whole title still fits in TITLE_MAX characters. A title that already
// names the brand (the home page) is left alone.
const named = /delbueno/i.test(pageTitle);
const title = named || pageTitle.length + TITLE_SUFFIX.length > TITLE_MAX ? pageTitle : pageTitle + TITLE_SUFFIX;

const canonical = canonicalUrl(path);
// hreflang is published only for pages that exist in every language: each language, plus x-default (English).
const versions = LANGS.flatMap((code) => {
  const sitePath = alternates[code];
  return sitePath ? [{ code, href: canonicalUrl(sitePath) }] : [];
});
const translated = versions.length === LANGS.length;
const defaultHref = versions.find((v) => v.code === DEFAULT_LANG)?.href;
const otherLocales = translated ? LANGS.filter((code) => code !== lang).map((code) => LANG_META[code].og) : [];
const robots =
  noindex || IS_PREVIEW
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{translated && versions.map((v) => <link rel="alternate" hreflang={LANG_META[v.code].tag} href={v.href} />)}
{translated && defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={BRAND.name} />
<meta property="og:locale" content={LANG_META[lang].og} />
{otherLocales.map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
