---
/** Homepage Playground strip: featured Dribbble shots first, then the rest, ending in a link to /playground/. */
import type { Lang } from '../../i18n/config';
import { translator } from '../../i18n';
import { homeCopy } from '../../i18n/pages/home';
import { pagePath } from '../../i18n/routes';
import { LINKS } from '../../lib/site';
import type { ShotEntry } from '../../lib/content';
import { url } from '../../lib/url';
import ShotCard from '../playground/ShotCard.astro';
import '../playground/shots.css';

interface Props {
  lang: Lang;
  shots: ShotEntry[];
}
const { lang, shots } = Astro.props;
const c = homeCopy[lang].playground;
const t = translator(lang);
---

{shots.length > 0 && (
  <section class="pg" id="playground" aria-labelledby="pg-h">
    <div class="pg-head">
      <div>
        <p class="label">{c.label}</p>
        <h2 class="h2" id="pg-h" data-split>
          {c.heading}
        </h2>
      </div>
      <div class="pg-intro">
        <p data-rv>{c.intro}</p>
        <div class="pg-arrows" data-rv>
          <button class="pg-arrow" type="button" aria-label={c.back} data-strip-prev>
            <svg class="arr pg-flip" aria-hidden="true">
              <use href="#i-arr" />
            </svg>
          </button>
          <button class="pg-arrow" type="button" aria-label={c.forward} data-strip-next>
            <svg class="arr" aria-hidden="true">
              <use href="#i-arr" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="pg-strip" data-strip tabindex="0" role="region" aria-label={c.region}>
      <ul class="pg-track">
        {shots.map((shot, i) => (
          <ShotCard lang={lang} shot={shot} variant="strip" eager={i < 2} />
        ))}
        <li class="pg-cta">
          <a class="pg-cta__main stretch" href={url(pagePath('playground', lang))} data-cursor={t('cursor.open')}>
            <span class="label">{c.more}</span>
            <span class="pg-cta__t">{c.seeAll}</span>
            <span class="pg-cta__go">
              <svg class="arr" aria-hidden="true">
                <use href="#i-arr" />
              </svg>
            </span>
          </a>
          <a class="pg-cta__dribbble" href={LINKS.dribbble} target="_blank" rel="noopener me">
            {c.follow}
            <svg class="arr" aria-hidden="true">
              <use href="#i-arr" />
            </svg>
          </a>
        </li>
      </ul>
    </div>
    <div class="pg-prog" aria-hidden="true">
      <i data-strip-prog />
    </div>
  </section>
)}

<style is:global>
  .pg {
    padding: clamp(56px, 8vw, 120px) 0 clamp(72px, 10vw, 150px);
    background: var(--bg);
  }

  .pg-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding: 0 var(--pad);
    margin-bottom: clamp(32px, 4.5vw, 64px);
  }

  .pg-head .h2 {
    font-size: clamp(2.4rem, 5.6vw, 6rem);
    margin-top: 14px;
  }

  .pg-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    max-width: 38ch;
    text-align: right;
    color: var(--mute);
    padding-bottom: 0.4em;
  }

  .pg-arrows {
    display: flex;
    gap: 8px;
  }

  .pg-arrow {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    transition:
      background 0.4s,
      border-color 0.4s,
      opacity 0.3s;
  }

  .pg-arrow:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.3);
  }

  .pg-arrow[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }

  .pg-flip {
    transform: scaleX(-1);
  }

  .pg-strip {
    --shot-h: clamp(210px, 26vw, 400px);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 12px var(--pad) 28px;
    scroll-padding-inline: var(--pad);
    cursor: grab;
  }

  .pg-strip::-webkit-scrollbar {
    display: none;
  }

  .pg-strip.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .pg-strip.is-dragging a {
    pointer-events: none;
  }

  .pg-strip:focus-visible {
    outline-offset: -2px;
  }

  .pg-track {
    display: flex;
    gap: var(--gap);
    width: max-content;
  }

  .pg-track > .shot,
  .pg-track > .pg-cta {
    flex: none;
    height: var(--shot-h);
  }

  .pg-track > .shot {
    width: calc(var(--shot-h) * var(--ar-n, 1.5));
  }

  .pg-cta {
    position: relative;
    width: clamp(240px, 26vw, 400px);
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: var(--bg-1);
    overflow: hidden;
  }

  .pg-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1.2px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 100% 0%, #000, transparent 70%);
    mask-image: radial-gradient(ellipse 80% 70% at 100% 0%, #000, transparent 70%);
    opacity: 0.55;
  }

  .pg-cta__main {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(20px, 2vw, 30px);
    padding-bottom: 72px;
  }

  .pg-cta__t {
    font: 800 clamp(1.6rem, 2.4vw, 2.5rem) / 0.98 var(--display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .pg-cta__go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: #0a0a0f;
    transition:
      background 0.4s,
      transform 0.7s var(--out);
  }

  .pg-cta__main:hover .pg-cta__go {
    background: var(--lime);
    transform: translateX(6px);
  }

  .pg-cta__dribbble {
    position: absolute;
    left: clamp(20px, 2vw, 30px);
    bottom: 14px;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 44px;
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mute);
    transition: color 0.4s;
  }

  .pg-cta__dribbble:hover {
    color: var(--ink);
  }

  .pg-prog {
    height: 2px;
    margin: 0 var(--pad);
    background: var(--line);
    overflow: hidden;
  }

  .pg-prog i {
    display: block;
    height: 100%;
    background: var(--grad);
    transform-origin: left;
    transform: scaleX(0.1);
  }

  @media (hover: none) {
    .pg-strip {
      cursor: auto;
    }
  }

  @media (max-width: 860px) {
    .pg-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .pg-intro {
      align-items: flex-start;
      text-align: left;
      max-width: 46ch;
    }

    .pg-strip {
      --shot-h: clamp(190px, 52vw, 300px);
    }
  }
</style>
