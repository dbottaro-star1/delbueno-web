---
/** Client logos as text marks. The list is cloned by scripts/home/marquee.ts for the endless loop. */
const clients = ['BigID', 'JFrog', 'NetApp', 'Palo Alto Networks', 'Uleadz'];
---

<section class="trust" aria-labelledby="trust-h">
  <div class="wrap trust-head">
    <h2 class="label" id="trust-h">Trusted by</h2>
    <span class="label" aria-hidden="true">B2B SaaS teams</span>
  </div>
  <div class="marquee marquee--trust">
    <div class="marquee-track" id="marqueeTrack">
      <ul class="marquee-group">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style is:global>
  .trust {
    position: relative;
    padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 120px);
    border-top: 1px solid var(--line);
  }

  .trust-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: clamp(24px, 3vw, 44px);
    max-width: none;
  }

  .marquee--trust {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .marquee-group li {
    display: flex;
    align-items: center;
    font: 700 clamp(1.7rem, 3.4vw, 3.4rem) / 1 var(--display);
    letter-spacing: -0.035em;
    color: rgb(242 242 245 / 0.6);
    white-space: nowrap;
    padding-right: clamp(36px, 5vw, 84px);
    transition: color 0.5s;
  }

  .marquee-group li::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-left: clamp(36px, 5vw, 84px);
    border: 1px solid var(--line-2);
    transform: rotate(45deg);
    flex: none;
  }

  @media (hover: hover) {
    .marquee-group li:hover {
      color: var(--ink);
    }
  }

  html:not(.js) .marquee-track {
    width: auto;
  }

  html:not(.js) .marquee-group {
    flex-wrap: wrap;
    row-gap: 16px;
  }
</style>
