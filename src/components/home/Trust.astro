---
import type { Lang } from '../../i18n/config';
import { homeCopy } from '../../i18n/pages/home';
import { CLIENT_NAMES } from '../../i18n/pages/shared';
import Recognition from '../Recognition.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = homeCopy[lang].trust;

/** Client logos as text marks. The list is cloned by scripts/home/marquee.ts for the endless loop. */
const clients = CLIENT_NAMES;
---

<section class="trust" aria-labelledby="trust-h">
  <div class="wrap trust-head">
    <h2 class="label" id="trust-h">
      {c.trustedBy}
    </h2>
  </div>
  <div class="marquee marquee--trust">
    <div class="marquee-track" id="marqueeTrack">
      <ul class="marquee-group">
        {clients.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap trust-rec">
    <h2 class="label">{c.recognizedBy}</h2>
    <Recognition lang={lang} height={96} />
  </div>
</section>

<style is:global>
  .trust {
    position: relative;
    padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 120px);
    border-top: 1px solid var(--line);
  }

  .trust-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: clamp(24px, 3vw, 44px);
    max-width: none;
  }

  .trust-rec {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(18px, 3vw, 40px);
    max-width: none;
    margin-top: clamp(40px, 6vw, 88px);
    padding-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }

  /* Below desktop the badges sit on two rows: the three shields, then the two landscape items. A single
     wrapped row left one item alone on tablets and squeezed the wide pair on phones. The ul.rec
     selectors outrank the scoped styles in Recognition.astro. */
  @media (max-width: 1023px) {
    .trust-rec ul.rec {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 32px 16px;
      width: 100%;
      align-items: center;
      justify-items: center;
    }

    .trust-rec ul.rec > li {
      grid-column: span 2;
    }

    .trust-rec ul.rec > li.rec-wide {
      grid-column: span 3;
    }
  }

  /* Phones: the wide pair fills its half of the row, at the same height. */
  @media (max-width: 560px) {
    .trust-rec ul.rec {
      --rec-h: 76px !important;
    }

    .trust-rec ul.rec > li.rec-wide {
      justify-self: stretch;
    }

    .trust-rec ul.rec > .rec-wide .rec-item img {
      width: 100%;
      height: auto;
    }

    /* Same height as the TechBehemoths banner, which scales with its half of the row. */
    .trust-rec ul.rec > .rec-wide .rec-google {
      --rec-h: min(56px, calc((100vw - 2 * var(--pad) - 16px) / 2 / 2.97));
      justify-content: center;
    }
  }

  .marquee--trust {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .marquee-group li {
    display: flex;
    align-items: center;
    font: 700 clamp(1.7rem, 3.4vw, 3.4rem) / 1 var(--display);
    letter-spacing: -0.035em;
    color: rgb(242 242 245 / 0.6);
    white-space: nowrap;
    padding-right: clamp(36px, 5vw, 84px);
    transition: color 0.5s;
  }

  .marquee-group li::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-left: clamp(36px, 5vw, 84px);
    border: 1px solid var(--line-2);
    transform: rotate(45deg);
    flex: none;
  }

  @media (hover: hover) {
    .marquee-group li:hover {
      color: var(--ink);
    }
  }

  html:not(.js) .marquee-track {
    width: auto;
  }

  html:not(.js) .marquee-group {
    flex-wrap: wrap;
    row-gap: 16px;
  }
</style>
