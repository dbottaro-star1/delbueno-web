---
const steps = [
  {
    when: 'Today',
    title: 'Strategic kickoff',
    text: 'One focused call to align on goals and scope; we start the moment we hang up.',
  },
  {
    when: 'Within 24h',
    title: 'Your portal goes live',
    text: 'A dedicated Notion workspace with your backlog, plus a shared Slack channel. No email chains.',
  },
  { when: '48h later', title: 'First high-fidelity concepts', text: 'No waiting weeks for a big reveal.' },
];
---

<section class="speed" id="speed" aria-labelledby="speed-h">
  <p class="label">Process</p>
  <h2 class="h2" id="speed-h" data-split>
    Kickoff today. Concepts in 48 hours.
  </h2>
  <div class="steps" id="steps">
    <div class="rail" aria-hidden="true">
      <span class="rail-fill" id="railFill"></span>
    </div>
    <ol class="step-list">
      {steps.map((s, i) => (
        <li class="step" data-rv>
          <span class="step-no mono">Step {String(i + 1).padStart(2, '0')}</span>
          <p class="step-t">{s.when}</p>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .mono {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .speed {
    position: relative;
    padding: clamp(96px, 15vw, 220px) var(--pad) clamp(72px, 10vw, 150px);
    background: var(--bg);
  }

  .speed .h2 {
    margin-top: 18px;
    font-size: clamp(2.4rem, 6.6vw, 7.2rem);
  }

  .steps {
    position: relative;
    margin-top: clamp(56px, 8vw, 120px);
  }

  .step-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap);
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--line-2);
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--grad);
    transform-origin: left;
  }

  .js .rail-fill {
    transform: scaleX(0);
  }

  .step {
    position: relative;
    padding-top: clamp(36px, 4vw, 56px);
    padding-right: clamp(0px, 2vw, 40px);
  }

  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: -4.5px;
    z-index: 1;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--lime);
    border: 1px solid var(--lime);
    transition:
      background 0.7s var(--out),
      border-color 0.7s var(--out),
      transform 0.7s var(--out);
  }

  .js .step::before {
    background: var(--bg);
    border-color: var(--line-2);
  }

  .js .step.is-on::before {
    background: var(--lime);
    border-color: var(--lime);
    transform: scale(1.3);
  }

  .step-t {
    font: 500 clamp(1.5rem, 2.6vw, 2.6rem) / 1 var(--mono);
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .step-no {
    display: block;
    color: var(--dim);
    margin-bottom: 16px;
  }

  .step h3 {
    font: 700 clamp(1.4rem, 2vw, 2rem) / 1.05 var(--display);
    letter-spacing: -0.03em;
    margin: clamp(24px, 3vw, 44px) 0 14px;
  }

  .step p {
    color: var(--mute);
    max-width: 34ch;
  }

  .step .step-t {
    color: var(--ink);
    max-width: none;
  }

  @media (max-width: 860px) {
    .steps {
      padding-left: 32px;
      margin-top: 56px;
    }

    .step-list {
      grid-template-columns: 1fr;
      row-gap: 48px;
    }

    .rail {
      right: auto;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }

    .rail-fill {
      transform-origin: top;
    }

    .step {
      padding-top: 0;
    }

    .step::before {
      left: -37px;
      top: 2px;
    }
  }
</style>
