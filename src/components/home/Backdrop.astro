---
/** Fixed layers behind and in front of the first act: particle canvas, clarity readout and the flying screens. */
import type { Lang } from '../../i18n/config';
import { homeCopy } from '../../i18n/pages/home';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<canvas id="field" aria-hidden="true"></canvas>
<div class="clarity" id="clarityRail" aria-hidden="true">
  <span class="mono">
    <span>{homeCopy[lang].clarity}</span>
    <b>
      <span id="clarity">000</span>%
    </b>
  </span>
  <span class="bar">
    <i id="clarityBar"></i>
  </span>
</div>
<div class="fly-layer" id="flyLayer" aria-hidden="true"></div>

<style is:global>
  /* field: one fixed canvas behind the whole first act */
  #field {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
  }

  .rm #field {
    position: absolute;
    height: 100svh;
    min-height: 620px;
  }

  /* clarity readout (fixed rail, right edge) */
  .clarity {
    position: fixed;
    z-index: 60;
    right: clamp(10px, 1.5vw, 24px);
    top: 50%;
    transform: translateY(-50%);
    display: none;
    align-items: center;
    gap: 12px;
    pointer-events: none;
    opacity: 0;
  }

  @media (min-width: 1024px) and (hover: hover) {
    .js .clarity {
      display: flex;
    }
  }

  .clarity .mono {
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--mute);
    display: flex;
    gap: 0.9em;
    align-items: center;
    white-space: nowrap;
  }

  .clarity .mono b {
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .clarity .bar {
    display: block;
    width: 1px;
    height: clamp(90px, 16vh, 160px);
    background: var(--line-2);
    position: relative;
    overflow: hidden;
  }

  .clarity .bar i {
    position: absolute;
    inset: 0;
    background: var(--grad);
    transform-origin: bottom;
    transform: scaleY(0);
  }

  /* flying screens */
  .fly-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100svh;
    z-index: 20;
    pointer-events: none;
    perspective: 1700px;
    overflow-x: clip;
    overflow-y: visible;
  }

  .fly {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .fly__sh {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    box-shadow:
      0 50px 70px -26px rgb(0 0 0 / 0.85),
      0 0 90px -24px rgb(63 41 216 / 0.5);
  }

  .fly__im {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--bg-3);
  }

  .fly__im img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .fly__im::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
</style>
