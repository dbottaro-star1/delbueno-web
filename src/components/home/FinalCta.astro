---
import type { Lang } from '../../i18n/config';
import { translator } from '../../i18n';
import { homeCopy } from '../../i18n/pages/home';
import { BRAND, LINKS } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = homeCopy[lang].final;
const lastLine = c.lines.length - 1;
---

<section class="final" aria-labelledby="final-h">
  <p class="label">{c.label}</p>
  <h2 class="h2" id="final-h">
    {c.lines.map((line, i) => (
      <>
        {i > 0 && ' '}
        <span class="hl">
          <span class="hl-i">
            {i === lastLine ? (
              <span class="gw">
                {line}
                <span class="gw-fx" aria-hidden="true">
                  {line}
                </span>
              </span>
            ) : (
              line
            )}
          </span>
        </span>
      </>
    ))}
  </h2>
  <div class="final-row" data-rv>
    <a class="btn btn-primary btn-cta" data-magnetic href={LINKS.book} rel="noopener">
      {t('cta.book')}{' '}
      <svg class="arr" aria-hidden="true">
        <use href="#i-arr"></use>
      </svg>
    </a>
    <p class="final-mail">
      {c.or} <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
    </p>
  </div>
</section>

<style is:global>
  .final {
    position: relative;
    padding: clamp(100px, 16vw, 240px) var(--pad) clamp(72px, 10vw, 140px);
    border-top: 1px solid var(--line);
    overflow: hidden;
    background: var(--bg);
  }

  .final::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1.2px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 100%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 100%, #000, transparent 75%);
    opacity: 0.55;
  }

  .final > * {
    position: relative;
  }

  .final .h2 {
    font-size: clamp(2.6rem, 9.4vw, 10.6rem);
    line-height: 0.9;
    margin-top: 22px;
  }

  .gw {
    position: relative;
    display: inline-block;
  }

  .gw-fx {
    position: absolute;
    left: 0;
    top: -0.1em;
    padding: 0.1em 0.04em 0.28em 0;
    white-space: nowrap;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.2s var(--out);
  }

  .final:has(.btn-cta:hover) .gw-fx,
  .final:has(.btn-cta:focus-visible) .gw-fx {
    clip-path: inset(0 0 0 0);
  }

  .final-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 48px);
    margin-top: clamp(40px, 6vw, 96px);
  }

  .btn-cta {
    height: clamp(64px, 7vw, 96px);
    padding: 0 clamp(32px, 4vw, 64px);
    font-size: clamp(1.0625rem, 1.5vw, 1.5rem);
    gap: 0.9em;
  }

  .final-mail {
    color: var(--mute);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
  }

  .final-mail a {
    color: var(--ink);
    border-bottom: 1px solid var(--line-2);
    transition: border-color 0.4s;
  }

  .final-mail a:hover {
    border-color: var(--ink);
  }

  @media (max-width: 860px) {
    .final .h2 {
      font-size: 10.8vw;
    }
  }
</style>
