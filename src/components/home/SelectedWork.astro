---
/**
 * Selected work grid. The hero screens (scripts/home/flight.ts) fly to the exact rect of each .wc__media slot,
 * and clone the same image URL, so the swap at landing is seamless.
 */
import { getImage } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { homeCopy } from '../../i18n/pages/home';
import { pagePath, workPath } from '../../i18n/routes';
import { workSlug, type WorkEntry } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  lang: Lang;
  entries: WorkEntry[];
}
const { lang, entries } = Astro.props;
const copy = homeCopy[lang].work;

const cards = await Promise.all(
  entries.map(async (entry) => {
    const img = await getImage({ src: entry.data.cover, width: 1200, format: 'webp' });
    const metric = entry.data.metrics[0];
    return {
      slug: workSlug(entry),
      client: entry.data.client,
      industry: entry.data.industry,
      what: entry.data.services.slice(0, 2).join(' & '),
      alt: entry.data.coverAlt,
      metric,
      img,
    };
  }),
);
---

<section class="work" id="work" aria-labelledby="work-h">
  <div class="work-head">
    <div>
      <p class="label">{copy.label}</p>
      <h2 class="h2" id="work-h" data-split>
        {copy.heading}
      </h2>
    </div>
    <div class="work-meta">
      <p class="work-lede" data-rv>
        {copy.lede}
      </p>
    </div>
  </div>

  <ul class="work-grid" id="workGrid">
    {cards.map((card) => (
      <li class="wc">
        <div class="wc__media">
          <img
            src={card.img.src}
            width={card.img.attributes.width}
            height={card.img.attributes.height}
            alt={card.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="wc__glare" aria-hidden="true" />
          <span class="view" aria-hidden="true">
            {copy.view}{' '}
            <svg class="arr">
              <use href="#i-arr" />
            </svg>
          </span>
        </div>
        <div class="wc__cap">
          <div class="wc__info">
            <h3 class="wc__name">
              <a class="stretch" href={url(workPath(card.slug, lang))}>
                {card.client}
              </a>
            </h3>
            <p class="wc__what">
              <span>{card.industry}</span>
              <span>{card.what}</span>
            </p>
          </div>
          {card.metric && (
            <p class="wc__metric">
              <b>{card.metric.value}</b>
              <span>{card.metric.label}</span>
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>

  <div class="work-more" data-rv>
    <a class="btn btn-primary" data-magnetic href={url(pagePath('work', lang))}>
      {copy.all}{' '}
      <svg class="arr" aria-hidden="true">
        <use href="#i-arr"></use>
      </svg>
    </a>
  </div>
</section>

<style is:global>
  .work {
    padding: clamp(72px, 10vw, 150px) 0;
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding: 0 var(--pad);
    margin-bottom: clamp(40px, 6vw, 88px);
  }

  .work-head .h2 {
    font-size: clamp(2.4rem, 5.6vw, 6rem);
    margin-top: 14px;
  }

  .work-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    padding-bottom: 0.6em;
    text-align: right;
  }

  .work-lede {
    font: 700 clamp(1.05rem, 1.5vw, 1.5rem) / 1.1 var(--display);
    letter-spacing: -0.03em;
  }

  .work-grid {
    padding: 0 var(--pad);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(48px, 5vw, 80px) var(--gap);
  }

  .wc {
    position: relative;
  }

  .wc__media {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--bg-2);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .wc__media img,
  .wc__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .wc__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .wc__glare {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
    mix-blend-mode: overlay;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.9),
      rgb(255 255 255 / 0) 52%
    );
  }

  .js .wc__media img {
    opacity: 0;
    transition: opacity 0.9s var(--out);
  }

  .js .wc__media img.is-ld {
    opacity: 1;
  }

  /* during the flight the slot image waits; at landing it appears in the same frame the flyer leaves */
  .js.fly-on .wc:not(.is-landed) .wc__media img {
    opacity: 0;
    transition: none;
  }

  .js.fly-on .wc.is-landed .wc__media img {
    opacity: 1;
    transition: none;
  }

  .view {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 4;
    overflow: hidden;
    border-radius: 999px;
    background: var(--ink);
    color: #0a0a0f;
    font: 500 0.8125rem / 1 var(--sans);
    padding: 0 16px;
    height: 36px;
    display: flex;
    align-items: center;
    gap: 0.6em;
    transform: translateY(160%);
    transition: transform 0.8s var(--out);
  }

  .wc:focus-within .view {
    transform: none;
  }

  @media (hover: hover) {
    .wc:hover .view {
      transform: none;
    }

    .wc:hover .wc__glare {
      opacity: 0.55;
    }

    .wc:hover .wc__metric b {
      background: var(--lime);
      color: #0a0a0f;
      transform: scale(1.1) rotate(-3deg);
    }
  }

  @media (hover: none) {
    .view {
      transform: none;
    }
  }

  .wc__cap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    row-gap: 14px;
    padding-top: clamp(14px, 1.5vw, 20px);
    align-items: start;
  }

  .wc__name {
    font: 700 clamp(1.35rem, 2vw, 2rem) / 1 var(--display);
    letter-spacing: -0.035em;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  .wc__what {
    margin-top: 10px;
    color: var(--mute);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .wc__what span {
    display: block;
  }

  .wc__what span + span {
    color: var(--dim);
  }

  .wc__metric {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    max-width: 230px;
    justify-self: end;
  }

  .wc__metric b {
    display: inline-block;
    font: 800 clamp(2rem, 3vw, 3.2rem) / 0.9 var(--display);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    padding: 0.1em 0.16em 0.12em;
    margin: -0.1em -0.16em 0 0;
    border-radius: 10px;
    transform-origin: 100% 0;
    transition:
      transform 0.8s var(--spring),
      background-color 0.4s,
      color 0.4s;
  }

  .wc:focus-within .wc__metric b {
    background: var(--lime);
    color: #0a0a0f;
    transform: scale(1.1) rotate(-3deg);
  }

  .wc__metric span {
    color: var(--mute);
    font-size: 0.8125rem;
    line-height: 1.35;
    margin-top: 8px;
  }

  .work-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 7vw, 100px);
  }

  @media (min-width: 1200px) {
    .wc:nth-child(3n + 2) {
      margin-top: clamp(36px, 5vw, 84px);
    }
  }

  @media (min-width: 1024px) and (max-width: 1199px) {
    .wc:nth-child(2n) {
      margin-top: clamp(36px, 5vw, 64px);
    }
  }

  @media (max-width: 1199px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .work-head {
      align-items: flex-end;
    }
  }

  @media (max-width: 760px) {
    .work-grid {
      grid-template-columns: 1fr;
    }

    .work-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .work-meta {
      align-items: baseline;
      text-align: left;
      flex-direction: row;
      gap: 16px;
      padding-bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .wc__cap {
      grid-template-columns: minmax(0, 1fr);
    }

    .wc__metric {
      justify-self: start;
      flex-direction: row;
      align-items: baseline;
      text-align: left;
      gap: 12px;
      max-width: none;
    }

    .wc__metric b {
      margin: -0.1em 0 0 -0.16em;
    }

    .wc__metric span {
      margin-top: 0;
    }
  }
</style>
