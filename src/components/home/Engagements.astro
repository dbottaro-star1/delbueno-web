---
import { getEngagementsCopy } from '../../data/engagements';
import type { Lang } from '../../i18n/config';
import { translator } from '../../i18n';
import { homeCopy } from '../../i18n/pages/home';
import { pagePath } from '../../i18n/routes';
import { LINKS } from '../../lib/site';
import { url } from '../../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = homeCopy[lang].engagements;
const t = translator(lang);
const { engagements } = getEngagementsCopy(lang);
---

<section class="eng" id="engagements" aria-labelledby="eng-h">
  <div class="eng-head">
    <p class="label">{c.label}</p>
    <h2 class="h2" id="eng-h" data-split>
      {c.heading}
    </h2>
  </div>
  <div class="flip-grid" id="flipGrid">
    {engagements.map((e, i) => {
      const no = String(i + 1).padStart(2, '0');
      return (
        <article class="flip" data-flip>
          <div class="flip__in">
            <div class="flip__f flip__front">
              <span class="flip__no">{no}</span>
              <div>
                <h3>{e.name}</h3>
                <ul class="chips">
                  {e.chips.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                <p class="flip__hint" aria-hidden="true">
                  <svg class="arr">
                    <use href="#i-arr" />
                  </svg>
                  <span class="flip__hint-hover">{c.hoverHint}</span>
                  <span class="flip__hint-tap">{c.tapHint}</span>
                </p>
              </div>
            </div>
            <div class="flip__f flip__back">
              <div>
                <span class="flip__no">{no}</span>
                <p class="flip__name">{e.name}</p>
                <p class="flip__d">{e.summary}</p>
              </div>
              <a class="btn btn-primary btn-sm" href={LINKS.book} rel="noopener">
                {t('cta.book')}{' '}
                <svg class="arr" aria-hidden="true">
                  <use href="#i-arr" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <p class="eng-note" data-rv>
    <svg
      viewBox="0 0 100 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="5" cy="12" r="3.5" fill="currentColor" stroke="none"></circle>
      <path d="M12 12h80M85 5l7 7-7 7"></path>
    </svg>
    <span>
      {c.note}
      <a class="eng-link" href={url(pagePath('engagements', lang))}>
        {c.compare}
      </a>
    </span>
  </p>
</section>

<style is:global>
  .eng {
    padding: clamp(72px, 10vw, 150px) 0;
    background: var(--bg);
  }

  .eng-head {
    padding: 0 var(--pad);
    margin-bottom: clamp(40px, 5vw, 80px);
  }

  .eng-head .h2 {
    margin-top: 18px;
    max-width: 11ch;
  }

  .flip-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding: 0 var(--pad);
  }

  .flip {
    perspective: 1600px;
    height: clamp(390px, 31vw, 470px);
  }

  .flip__in {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1.1s var(--out);
  }

  .flip:focus-within .flip__in,
  .flip.is-flipped .flip__in {
    transform: rotateY(180deg);
  }

  @media (hover: hover) {
    .flip:hover .flip__in {
      transform: rotateY(180deg);
    }
  }

  .flip__f {
    position: absolute;
    inset: 0;
    border-radius: clamp(14px, 1.5vw, 22px);
    padding: clamp(24px, 2.6vw, 38px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip__front {
    background: var(--bg-1);
    border: 1px solid var(--line-2);
  }

  .flip__front::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1.2px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 100% 0%, #000, transparent 70%);
    mask-image: radial-gradient(ellipse 70% 60% at 100% 0%, #000, transparent 70%);
    opacity: 0.55;
  }

  .flip__front > *,
  .flip__back > * {
    position: relative;
  }

  .flip__back {
    background: var(--violet);
    color: #fff;
    transform: rotateY(180deg);
  }

  .flip__back::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1.2px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 0% 100%, #000, transparent 70%);
    mask-image: radial-gradient(ellipse 80% 70% at 0% 100%, #000, transparent 70%);
    opacity: 0.5;
  }

  .flip__no {
    font: 500 0.8125rem / 1 var(--mono);
    letter-spacing: 0.09em;
    color: var(--dim);
  }

  .flip__back .flip__no {
    color: rgb(255 255 255 / 0.7);
  }

  .flip h3 {
    font: 800 clamp(2rem, 3.3vw, 3.5rem) / 0.96 var(--display);
    letter-spacing: -0.045em;
  }

  .flip .chips {
    justify-content: flex-start;
    margin-top: 22px;
  }

  .flip__hint {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 24px;
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .flip__hint .arr {
    width: 1.25em;
    height: 1.25em;
    color: var(--lime);
  }

  .flip__hint-tap {
    display: none;
  }

  @media (hover: none) {
    .flip__hint-hover {
      display: none;
    }

    .flip__hint-tap {
      display: inline;
    }
  }

  .flip__name {
    font: 800 clamp(1.5rem, 2.2vw, 2.3rem) / 1 var(--display);
    letter-spacing: -0.04em;
    margin-top: 18px;
  }

  .flip__back p.flip__d {
    font-size: clamp(1rem, 1.2vw, 1.1875rem);
    line-height: 1.5;
    margin-top: 16px;
    max-width: 34ch;
  }

  .flip__back .btn {
    align-self: flex-start;
  }

  .eng-note {
    padding: clamp(32px, 4vw, 56px) var(--pad) 0;
    display: flex;
    align-items: center;
    gap: 20px;
    color: var(--mute);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    max-width: 90ch;
  }

  .eng-note svg {
    flex: none;
    width: clamp(56px, 7vw, 100px);
    height: auto;
    color: var(--lime);
  }

  .eng-link {
    display: inline-block;
    margin-left: 0.4em;
    padding-block: 12px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.4s;
  }

  .eng-link:hover {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 1023px) {
    .flip-grid {
      grid-template-columns: 1fr;
    }
  }

  /* phones: flat and stacked (text stays in the DOM on both faces) */
  @media (max-width: 760px) {
    .flip {
      height: auto;
      perspective: none;
    }

    .flip__in {
      transform: none !important;
      display: flex;
      flex-direction: column;
      height: auto;
    }

    .flip__f {
      position: relative;
      inset: auto;
      transform: none !important;
      backface-visibility: visible;
      -webkit-backface-visibility: visible;
    }

    .flip__front {
      border-radius: clamp(14px, 1.5vw, 22px) clamp(14px, 1.5vw, 22px) 0 0;
      padding-bottom: 18px;
      gap: 56px;
      border-bottom: 0;
    }

    .flip__back {
      border-radius: 0 0 clamp(14px, 1.5vw, 22px) clamp(14px, 1.5vw, 22px);
      gap: 24px;
    }

    .flip__back .flip__no,
    .flip__back .flip__name {
      display: none;
    }

    .flip__back p.flip__d {
      margin-top: 0;
    }

    .flip__hint {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .eng-note {
      align-items: flex-start;
    }
  }
</style>
