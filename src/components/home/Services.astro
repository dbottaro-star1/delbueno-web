---
import { services } from '../../data/services';
import { url } from '../../lib/url';
import ServiceArt from './ServiceArt.astro';

const total = String(services.length).padStart(2, '0');
---

<section class="services" id="services" aria-labelledby="svc-h">
  <div class="sec-head">
    <p class="label">Services</p>
    <h2 class="h2" id="svc-h" data-split>What we do</h2>
    <p class="sub" data-rv>Four disciplines, one team. Start with any of them.</p>
  </div>
  <div class="svc-stack">
    {
      services.map((s, i) => (
        <article class="svc" aria-labelledby={`svc${i + 1}`}>
          <div class="svc-in">
            <div class="svc-top">
              <span class="svc-num">
                <b>{String(i + 1).padStart(2, '0')}</b> / {total}
              </span>
              <span class="svc-num">{s.home.kicker}</span>
            </div>
            <h3 class="svc-title" id={`svc${i + 1}`} data-split>
              {s.home.title}
            </h3>
            <ServiceArt slug={s.slug} />
            <div class="svc-bottom">
              <p class="svc-desc">{s.home.description}</p>
              <ul class="chips">{s.home.chips.map((c) => <li>{c}</li>)}</ul>
              <a class="svc-more" href={url(`/services/${s.slug}/`)}>
                About {s.name}
                <svg class="arr" aria-hidden="true">
                  <use href="#i-arr" />
                </svg>
              </a>
            </div>
          </div>
          <div class="svc-dim" />
        </article>
      ))
    }
  </div>
</section>

<style is:global>
  .services {
    position: relative;
    background: var(--bg);
  }

  .svc-stack {
    position: relative;
  }

  .svc {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    border-radius: clamp(18px, 2.4vw, 32px) clamp(18px, 2.4vw, 32px) 0 0;
    border-top: 1px solid var(--line-2);
    transform-origin: 50% 0;
    background: var(--bg-1);
    will-change: transform;
  }

  .svc:nth-child(2) {
    background: var(--bg-2);
  }

  .svc:nth-child(3) {
    background: var(--bg-3);
  }

  .svc:nth-child(4) {
    background: #181821;
  }

  .svc::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1.2px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 50% 60% at 82% 38%, #000, transparent 70%);
    mask-image: radial-gradient(ellipse 50% 60% at 82% 38%, #000, transparent 70%);
    opacity: 0.5;
  }

  .svc-dim {
    position: absolute;
    inset: 0;
    background: #0a0a0f;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
  }

  .svc-in {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: var(--gap);
    padding: clamp(28px, 5vh, 56px) var(--pad) clamp(28px, 5.5vh, 60px);
  }

  .svc-top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--mute);
  }

  .svc-num {
    font: 500 0.8125rem / 1 var(--mono);
    letter-spacing: 0.08em;
  }

  .svc-num b {
    color: var(--ink);
    font-weight: 500;
  }

  .svc-title {
    grid-column: 1 / 10;
    align-self: center;
    font: 800 clamp(3rem, 8.8vw, 10rem) / 0.9 var(--display);
    letter-spacing: -0.05em;
    margin-left: -0.04em;
  }

  .svc-art {
    grid-column: 10 / 13;
    grid-row: 2;
    align-self: center;
    justify-self: end;
    width: min(100%, 380px);
  }

  .art .a-s {
    fill: none;
    stroke: rgb(255 255 255 / 0.28);
    stroke-width: 1;
  }

  .art .a-v {
    fill: none;
    stroke: #7b6bff;
    stroke-width: 1.2;
  }

  .art .a-l {
    fill: none;
    stroke: #bafb44;
    stroke-width: 1.2;
  }

  .art .a-fv {
    fill: #7b6bff;
    stroke: none;
  }

  .art .a-fl {
    fill: #bafb44;
    stroke: none;
  }

  .art text {
    font-family: var(--mono);
    font-size: 11px;
    fill: rgb(255 255 255 / 0.5);
  }

  .svc-bottom {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
    row-gap: 20px;
  }

  .svc-desc {
    grid-column: 1 / 7;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.45;
    max-width: 36ch;
    color: var(--ink);
  }

  .svc-bottom .chips {
    grid-column: 8 / 13;
    justify-content: flex-end;
  }

  .svc-more {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    width: fit-content;
    min-height: 44px;
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mute);
    transition: color 0.4s;
  }

  .svc-more .arr {
    width: 1.25em;
    height: 1.25em;
    color: var(--lime);
    transition: transform 0.7s var(--out);
  }

  .svc-more:hover {
    color: var(--ink);
  }

  .svc-more:hover .arr {
    transform: translateX(4px);
  }

  @media (max-width: 1100px) {
    .svc-art {
      width: 100%;
    }
  }

  @media (max-width: 860px) {
    .svc-art {
      display: none;
    }

    .svc-title {
      grid-column: 1 / -1;
      font-size: clamp(2.5rem, 12.4vw, 6rem);
    }

    .svc-desc,
    .svc-bottom .chips {
      grid-column: 1 / -1;
    }

    .svc-bottom .chips {
      justify-content: flex-start;
    }
  }

  @media (max-width: 860px) and (max-height: 760px) {
    .svc-title {
      font-size: clamp(2.4rem, 11.4vw, 4.4rem);
    }

    .svc-desc {
      font-size: 1rem;
    }

    .svc-bottom .chips li {
      padding: 8px 12px;
    }
  }
</style>
