---
const numbers = [
  { to: '10', unit: '+', label: 'years designing digital products' },
  { to: '58', unit: '+', label: 'products shipped' },
  { to: '85', unit: '%', label: 'of clients come back for more' },
  { to: '4.9', dec: 1, star: true, label: 'on Clutch' },
];
---

<section aria-labelledby="nums-h">
  <h2 class="sr-only" id="nums-h">
    delbueno in numbers
  </h2>
  <div class="nums">
    {numbers.map((n) => (
      <div class="num">
        <p class="num-v">
          <span data-count={n.to} data-dec={n.dec ?? 0}>
            {n.to}
          </span>
          {n.unit && <span class="u">{n.unit}</span>}
          {n.star && (
            <svg class="star" viewBox="0 0 24 24" aria-label="stars" role="img">
              <path d="M12 1.8l3 6.9 7.5.7-5.7 5 1.7 7.3L12 17.8 5.5 21.7l1.7-7.3-5.7-5 7.5-.7z" fill="currentColor" />
            </svg>
          )}
        </p>
        <p class="num-l">{n.label}</p>
      </div>
    ))}
  </div>
</section>

<style is:global>
  .nums {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin: 0 var(--pad);
  }

  .num {
    padding: clamp(28px, 4vw, 64px) clamp(16px, 2vw, 32px) clamp(28px, 4vw, 56px);
    border-left: 1px solid var(--line);
  }

  .num:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .num-v {
    font: 800 clamp(3rem, 6.9vw, 7.8rem) / 0.9 var(--display);
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .num-v .u,
  .num-v .star {
    color: var(--lime);
  }

  .num-v .star {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.06em;
    vertical-align: 0.12em;
  }

  .num-l {
    color: var(--mute);
    margin-top: clamp(14px, 1.6vw, 24px);
    max-width: 20ch;
  }

  @media (max-width: 860px) {
    .nums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .num:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }

    .num:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
