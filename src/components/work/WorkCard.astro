---
/**
 * One case study card on /work/. Layout size comes from the card's position in the grid (see the nth-child rules
 * below), so the same markup works as a large or a small card. scripts/work/list.ts drives the clip-path reveal and
 * the inner parallax on .wk-card__media.
 */
import { Image } from 'astro:assets';
import type { WorkEntry } from '../../lib/content';
import { url } from '../../lib/url';
import { CONCEPT_SLUGS } from './metric';

interface Props {
  entry: WorkEntry;
  index: number;
  total: number;
}
const { entry, index, total } = Astro.props;
const { data } = entry;
const metric = data.metrics[0];
const concept = CONCEPT_SLUGS.has(entry.id);
const pad = (n: number) => String(n).padStart(2, '0');
---

<li class="wk-card" data-card>
  <div class="wk-card__media" data-cursor="View" style={`--ar:${data.cover.width} / ${data.cover.height}`}>
    <div class="wk-card__par" data-par>
      <Image
        class="wk-card__img"
        src={data.cover}
        alt={data.coverAlt}
        widths={[560, 800, 1100, 1500]}
        sizes="(min-width: 1100px) 62vw, (min-width: 700px) 50vw, 100vw"
        loading={index < 2 ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
    <span class="wk-card__view" aria-hidden="true">
      View case{' '}
      <svg class="arr">
        <use href="#i-arr"></use>
      </svg>
    </span>
  </div>

  <div class="wk-card__cap" data-cap>
    <p class="wk-card__no" aria-hidden="true">
      <span>
        <b>{pad(index + 1)}</b> / {pad(total)}
      </span>
      <span>{data.year}</span>
    </p>
    <div class="wk-card__info">
      <h2 class="wk-card__h">
        <a class="wk-card__a" href={url(`/work/${entry.id}/`)}>
          <span class="wk-card__client">{data.client}</span>
          <span class="sr-only">: </span>
          <span class="wk-card__title">{data.title}</span>
        </a>
      </h2>
      <p class="wk-card__ind">
        <span>{data.industry}</span>
        {concept && <span class="wk-chip">Concept</span>}
      </p>
    </div>
    {metric && (
      <p class="wk-card__metric">
        <b>{metric.value}</b>
        <span>{metric.label}</span>
      </p>
    )}
  </div>
</li>

<style is:global>
  .wk-card {
    position: relative;
    container-type: inline-size;
    min-width: 0;
  }

  .wk-card__media {
    position: relative;
    aspect-ratio: var(--ar, 3 / 2); /* the cover's own ratio, so UI screenshots are never cropped sideways */
    border-radius: var(--r);
    overflow: hidden;
    background: var(--bg-2);
    isolation: isolate;
  }

  .wk-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  /* Taller than the frame so the parallax has room to travel without ever showing an edge. */
  .wk-card__par {
    position: absolute;
    inset: -3% 0;
    will-change: transform;
  }

  .wk-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transform-origin: 50% 30%;
    transition: transform 1.4s var(--out);
  }

  .wk-card__view {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.6em;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #0a0a0f;
    font: 500 0.8125rem / 1 var(--sans);
    transform: translateY(160%);
    transition: transform 0.8s var(--out);
  }

  .wk-card:focus-within .wk-card__view {
    transform: none;
  }

  .wk-card:has(:focus-visible) .wk-card__media {
    outline: 2px solid var(--violet-2);
    outline-offset: 4px;
  }

  @media (hover: none) {
    .wk-card__view {
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .wk-card__view {
      display: none;
    }

    .wk-card:hover .wk-card__img {
      transform: scale(1.06);
    }

    .wk-card:hover .wk-card__metric b {
      background: var(--lime);
      color: #0a0a0f;
      transform: scale(1.08) rotate(-3deg);
    }

    .wk-card:hover .wk-card__client {
      color: var(--ink);
    }
  }

  .wk-card__cap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 20px;
    row-gap: 16px;
    align-items: start;
    padding-top: clamp(14px, 1.4vw, 20px);
  }

  .wk-card__no {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font: 400 var(--fs-xs) / 1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .wk-card__no b {
    font-weight: 500;
    color: var(--ink);
  }

  .wk-card__h {
    font: inherit;
    letter-spacing: inherit;
  }

  .wk-card__client {
    display: block;
    font: 800 clamp(1.6rem, 4.6cqi, 3rem) / 0.98 var(--display);
    overflow-wrap: anywhere;
    letter-spacing: -0.04em;
    transition: color 0.5s;
  }

  .wk-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin-top: 12px;
    max-width: 36ch;
    color: var(--mute);
    font: 400 clamp(0.9375rem, 0.85rem + 0.4cqi, 1.0625rem) / 1.4 var(--sans);
    letter-spacing: -0.005em;
  }

  /* The whole card is the target: the link's box stretches over it. */
  .wk-card__a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  .wk-card__ind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 16px;
    color: var(--dim);
    font: 400 var(--fs-xs) / 1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wk-card__metric {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    max-width: 200px;
    text-align: right;
  }

  .wk-card__metric b {
    display: inline-block;
    padding: 0.1em 0.16em 0.12em;
    margin: -0.1em -0.16em 0 0;
    border-radius: 10px;
    font: 800 clamp(2.25rem, 9cqi, 4.75rem) / 0.9 var(--display);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    transform-origin: 100% 0;
    transition:
      transform 0.8s var(--spring),
      background-color 0.4s,
      color 0.4s;
  }

  .wk-card:focus-within .wk-card__metric b {
    background: var(--lime);
    color: #0a0a0f;
    transform: scale(1.08) rotate(-3deg);
  }

  .wk-card__metric span {
    margin-top: 8px;
    color: var(--mute);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  @container (max-width: 430px) {
    .wk-card__cap {
      grid-template-columns: minmax(0, 1fr);
    }

    .wk-card__metric {
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      max-width: none;
      text-align: left;
    }

    .wk-card__metric b {
      margin: -0.1em 0 0 -0.16em;
      font-size: clamp(2.25rem, 13cqi, 3.2rem);
    }

    .wk-card__metric span {
      margin-top: 0;
    }
  }
</style>
