---
import { BRAND, LINKS } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  heading?: string;
}
const { heading = 'Have a product that needs to feel obvious?' } = Astro.props;
---

<section class="section cta" aria-labelledby="cta-heading">
  <div class="wrap stack">
    <h2 id="cta-heading" data-reveal>
      {heading}
    </h2>
    <p class="lede">{BRAND.speed}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={LINKS.book} rel="noopener">
        Book a 15 minute call
      </a>
      <a class="btn btn-ghost" href={url('/free-ux-audit/')}>
        Get a free UX audit
      </a>
    </div>
  </div>
</section>
