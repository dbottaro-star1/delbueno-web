---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist or has moved." noindex>
  <section class="page-top section">
    <div class="wrap stack">
      <p class="label">Error 404</p>
      <h1>This page has moved or never existed.</h1>
      <p class="lede">Try one of these instead.</p>
      <ul class="tags">
        <li><a class="tag" href={url('/')}>Home</a></li>
        <li><a class="tag" href={url('/work/')}>Work</a></li>
        <li><a class="tag" href={url('/services/')}>Services</a></li>
        <li><a class="tag" href={url('/journal/')}>Journal</a></li>
        <li><a class="tag" href={url('/contact/')}>Contact</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
