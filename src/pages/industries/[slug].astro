---
import type { GetStaticPaths } from 'astro';
import { getIndustries, type Industry } from '../../data/industries';
import IndustryDetail from '../../views/IndustryDetail.astro';

export const getStaticPaths = (() =>
  getIndustries('en').map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }))) satisfies GetStaticPaths;

interface Props {
  industry: Industry;
}
const { industry } = Astro.props;
---

<IndustryDetail lang="en" industry={industry} />
