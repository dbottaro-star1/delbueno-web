---
import type { GetStaticPaths } from 'astro';
import Faq from '../../components/Faq.astro';
import IndustryArt from '../../components/industries/IndustryArt.astro';
import CaseCard from '../../components/services/CaseCard.astro';
import InnerCta from '../../components/services/InnerCta.astro';
import InnerHero from '../../components/services/InnerHero.astro';
import NextRows from '../../components/services/NextRows.astro';
import PostLink from '../../components/services/PostLink.astro';
import { casesFor, postsFor } from '../../components/services/related';
import '../../components/services/inner.css';
import { industries, type Industry } from '../../data/industries';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { crumbs, serviceSchema } from '../../lib/schema';
import { url } from '../../lib/url';

export const getStaticPaths = (() =>
  industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }))) satisfies GetStaticPaths;

interface Props {
  industry: Industry;
}
const { industry } = Astro.props;
const path = `/industries/${industry.slug}/`;
const trail = crumbs({ name: 'Industries', path: '/industries/' }, { name: industry.name, path });
const no = String(industries.findIndex((i) => i.slug === industry.slug) + 1).padStart(2, '0');

const cases = await casesFor(industry.cases);
const linked = industry.problems.flatMap((p) => (p.post ? [p.post] : []));
const posts = await postsFor([...new Set([...linked, ...industry.posts])], industry.keywords, 3);
const others = industries.filter((i) => i.slug !== industry.slug);
---

<BaseLayout
  title={industry.title}
  description={industry.seoDescription}
  breadcrumbs={trail}
  jsonLd={[serviceSchema({ path, name: industry.title, description: industry.answer, serviceType: 'Product design' })]}
>
  <InnerHero
    crumbs={trail}
    label={`Industry ${no} / 0${industries.length}`}
    title={industry.title}
    size="md"
    answer={industry.answer}
    secondary={{ label: 'See our services', href: '/services/' }}
  >
    <div class="in-hero__art">
      <IndustryArt slug={industry.slug} />
    </div>
  </InnerHero>

  <section class="in-sec" aria-labelledby="prob-h">
    <div class="in-split">
      <div class="in-split__a ind-sticky">
        <p class="label" data-rv>
          Typical problems
        </p>
        <h2 class="in-h2" id="prob-h" data-split>
          What goes wrong in {industry.name}.
        </h2>
      </div>
      <div class="in-split__b">
        <ol class="ind-problems">
          {industry.problems.map((p) => (
            <li class="ind-problem" data-rv>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="in-sec" aria-labelledby="des-h">
    <div class="in-head">
      <p class="label">What we design</p>
      <h2 class="in-h2" id="des-h" data-split>
        The screens that carry the weight.
      </h2>
    </div>
    <ul class="ind-designs" data-rv>
      {industry.designs.map((d, i) => (
        <li>
          <span>{String(i + 1).padStart(2, '0')}</span>
          {d}
        </li>
      ))}
    </ul>
  </section>

  {cases.length > 0 && (
    <section class="in-sec" aria-labelledby="case-h">
      <div class="in-head">
        <p class="label">Related work</p>
        <h2 class="in-h2" id="case-h" data-split>
          Work behind this page.
        </h2>
      </div>
      {industry.casesNote && (
        <p class="in-note" data-rv>
          {industry.casesNote}
        </p>
      )}
      <div class="in-cases">
        {cases.map((entry) => (
          <CaseCard entry={entry} />
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="in-sec" aria-labelledby="post-h">
      <div class="in-head">
        <p class="label">From the journal</p>
        <h2 class="in-h2" id="post-h" data-split>
          Go deeper.
        </h2>
      </div>
      <div class="in-posts">
        {posts.map((entry) => (
          <PostLink entry={entry} />
        ))}
      </div>
      <p style="margin-top: 24px" data-rv>
        <a class="in-more" href={url('/journal/')}>
          All journal posts
          <svg class="arr" aria-hidden="true">
            <use href="#i-arr" />
          </svg>
        </a>
      </p>
    </section>
  )}

  <section class="in-sec in-faq">
    <Faq items={industry.faqs} />
  </section>

  <NextRows
    label="Other industries"
    heading="Also in our field."
    items={others.map((i) => ({ name: i.name, summary: i.summary, href: `/industries/${i.slug}/` }))}
  />

  <InnerCta heading={industry.cta} />

  <script>
    import '../../scripts/services';
  </script>
</BaseLayout>

<style is:global>
  .ind-problems {
    counter-reset: prob;
    border-bottom: 1px solid var(--line);
  }

  .ind-problem {
    counter-increment: prob;
    position: relative;
    padding: clamp(22px, 2.8vw, 36px) 0 clamp(22px, 2.8vw, 36px) clamp(44px, 5vw, 72px);
    border-top: 1px solid var(--line);
  }

  .ind-problem::before {
    content: counter(prob, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: clamp(26px, 3.2vw, 42px);
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .ind-problem h3 {
    font: 700 clamp(1.4rem, 2.3vw, 2.2rem) / 1.08 var(--display);
    letter-spacing: -0.035em;
    margin-bottom: 12px;
    text-wrap: balance;
  }

  .ind-problem p {
    max-width: 54ch;
    color: var(--mute);
    line-height: 1.55;
  }

  .ind-designs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .ind-designs li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    min-height: clamp(150px, 16vw, 220px);
    padding: clamp(18px, 2vw, 28px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font: 700 clamp(1.25rem, 1.8vw, 1.75rem) / 1.12 var(--display);
    letter-spacing: -0.03em;
  }

  .ind-designs li span {
    font: 400 0.75rem / 1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  @media (min-width: 1024px) {
    .ind-sticky {
      position: sticky;
      top: calc(var(--nav-h) + 24px);
      align-self: start;
    }
  }
</style>
