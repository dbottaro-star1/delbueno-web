---
import IndustryArt from '../../components/industries/IndustryArt.astro';
import InnerCta from '../../components/services/InnerCta.astro';
import InnerHero from '../../components/services/InnerHero.astro';
import '../../components/services/inner.css';
import { industries } from '../../data/industries';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWork } from '../../lib/content';
import { crumbs } from '../../lib/schema';
import { url } from '../../lib/url';

const trail = crumbs({ name: 'Industries', path: '/industries/' });
const total = String(industries.length).padStart(2, '0');
const work = await getWork();

const answer =
  'delbueno™ Studio designs complex B2B software for five industries: cloud, cybersecurity, DevOps, AI and fintech. These are products where the interface carries real complexity, from alert queues and permission models to agent approvals and irreversible payments. Each page below covers the typical problems and the work we have done.';
---

<BaseLayout
  title="Industries: Cloud, Security, DevOps, AI, Fintech"
  description="delbueno™ Studio designs complex B2B software for cloud, cybersecurity, DevOps, AI and fintech teams. See the typical problems in each domain."
  breadcrumbs={trail}
>
  <InnerHero
    crumbs={trail}
    label="Where we specialize"
    title="Software where the interface carries real complexity."
    size="md"
    answer={answer}
  />

  <section class="in-sec in-sec--tight" aria-labelledby="ind-h">
    <h2 class="sr-only" id="ind-h">
      Industries we design for
    </h2>
    <div class="ind-list">
      {industries.map((ind, i) => (
        <a class="ind-row" href={url(`/industries/${ind.slug}/`)} data-rv>
          <span class="ind-no">
            {String(i + 1).padStart(2, '0')} / {total}
          </span>
          <h3 class="ind-name">{ind.name}</h3>
          <p class="ind-sum">{ind.summary}</p>
          <ul class="in-chips ind-chips">
            {ind.designs.slice(0, 3).map((d) => (
              <li>{d}</li>
            ))}
          </ul>
          <div class="ind-art">
            <IndustryArt slug={ind.slug} />
          </div>
          <svg class="arr ind-arr" aria-hidden="true">
            <use href="#i-arr" />
          </svg>
        </a>
      ))}
    </div>
  </section>

  <section class="in-sec in-sec--tight" aria-labelledby="oth-h">
    <div class="in-head">
      <p class="label">Beyond the five</p>
      <h2 class="in-h2" id="oth-h" data-split>
        Not on the list? Ask.
      </h2>
      <p class="in-sub" data-rv>
        The same approach has worked in other sectors. Here is the range of the case studies.
      </p>
    </div>
    <ul class="in-chips in-chips--links" data-rv>
      {work.map((w) => (
        <li>
          <a href={url(`/work/${w.id}/`)}>
            {w.data.client}: {w.data.industry}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <InnerCta heading="Building in one of these? Let’s talk." />

  <script>
    import '../../scripts/services';
  </script>
</BaseLayout>

<style is:global>
  .in-chips--links li {
    padding: 0;
  }

  .in-chips--links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    transition:
      color 0.4s,
      background 0.4s;
  }

  .in-chips--links li {
    transition: border-color 0.4s;
  }

  @media (hover: hover) and (pointer: fine) {
    .in-chips--links li:hover {
      border-color: rgb(255 255 255 / 0.4);
    }

    .in-chips--links a:hover {
      color: var(--ink);
    }
  }

  .ind-list {
    border-bottom: 1px solid var(--line);
  }

  .ind-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 220px);
    grid-template-areas:
      'no art'
      'name art'
      'sum art'
      'chips art';
    column-gap: var(--gap);
    row-gap: 14px;
    padding: clamp(28px, 4vw, 56px) 0;
    border-top: 1px solid var(--line);
    transition:
      padding-left 0.8s var(--out),
      background 0.6s;
  }

  .ind-no {
    grid-area: no;
    font: 500 0.8125rem / 1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .ind-name {
    grid-area: name;
    font: 800 clamp(1.5rem, 8vw, 8.4rem) / 0.92 var(--display);
    letter-spacing: -0.05em;
  }

  .ind-sum {
    grid-area: sum;
    max-width: 44ch;
    color: var(--mute);
    font-size: clamp(1.0625rem, 1.4vw, 1.3125rem);
  }

  .ind-chips {
    grid-area: chips;
    margin-top: 6px;
  }

  .ind-art {
    grid-area: art;
    align-self: center;
    opacity: 0.9;
  }

  .ind-arr {
    position: absolute;
    right: 0;
    top: clamp(28px, 4vw, 56px);
    width: 1.5rem;
    height: 1.5rem;
    color: var(--lime);
    transition: transform 0.7s var(--out);
  }

  @media (hover: hover) and (pointer: fine) {
    .ind-row:hover {
      padding-left: 16px;
    }

    .ind-row:hover .ind-arr {
      transform: translate(4px, -4px) rotate(-45deg);
    }
  }

  @media (min-width: 1100px) {
    .ind-row {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }

  @media (max-width: 700px) {
    .ind-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'no'
        'name'
        'sum'
        'chips'
        'art';
    }

    .ind-art {
      width: min(100%, 300px);
      margin-top: 12px;
    }

    .ind-arr {
      display: none;
    }
  }
</style>
