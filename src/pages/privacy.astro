---
import LegalLayout from '../components/info/LegalLayout.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { crumbs } from '../lib/schema';
import { BRAND, LINKS } from '../lib/site';
import { url } from '../lib/url';

const trail = crumbs({ name: 'Privacy', path: '/privacy/' });
const sections = [
  { id: 'summary', title: 'In short' },
  { id: 'collect', title: 'Information we receive' },
  { id: 'use', title: 'How we use it' },
  { id: 'sharing', title: 'Sharing' },
  { id: 'cookies', title: 'Cookies and tracking' },
  { id: 'third-parties', title: 'Third party services' },
  { id: 'security', title: 'Data security' },
  { id: 'rights', title: 'Your rights' },
  { id: 'children', title: 'Children' },
  { id: 'changes', title: 'Changes' },
  { id: 'contact', title: 'Contact' },
];
---

<BaseLayout
  title="Privacy policy"
  description="delbuenostudio.com is a static site with no cookies, analytics, tracking pixels or forms. Here is what little personal information we receive, and why."
  breadcrumbs={trail}
>
  <LegalLayout
    title="Privacy policy"
    lede="This site sets no cookies, runs no analytics and has no forms. Here is the small amount of personal information we do receive."
    updated="Last updated: October 13, 2026"
    crumbs={trail}
    sections={sections}
  >
    <section id="summary">
      <h2>In short</h2>
      <p>
        This Privacy Policy describes how {BRAND.name} (“we”, “us” or “our”) handles personal information in connection
        with delbuenostudio.com (the “Website”).
      </p>
      <ul>
        <li>The Website is a static site. It has no forms, no accounts and no comments.</li>
        <li>It sets no cookies, runs no analytics and loads no tracking pixels.</li>
        <li>Scripts, styles and fonts are served from the Website itself.</li>
        <li>Calls are booked on Lemcal, a third party with its own privacy policy.</li>
        <li>
          Email goes to <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
        </li>
      </ul>
    </section>

    <section id="collect">
      <h2>Information we receive</h2>
      <p>
        The Website itself does not ask you for personal information. We receive it only when you choose to share it:
      </p>
      <ul>
        <li>
          <strong>Email.</strong> If you write to us, we receive your email address, your name if you include it, and
          whatever you put in the message.
        </li>
        <li>
          <strong>Booking.</strong> If you book a call, Lemcal collects the details you enter there, such as your name,
          email address and chosen time, and shares them with us so we can meet you.
        </li>
      </ul>
      <p>
        Like any website, ours is delivered by a hosting provider and a content delivery network. They may process
        technical data such as your IP address and request logs to serve pages and keep them secure. We do not use that
        data to profile or track visitors.
      </p>
    </section>

    <section id="use">
      <h2>How we use it</h2>
      <p>
        We use the information you send us to reply to you, to schedule and hold calls, to prepare proposals or a{' '}
        <a href={url('/free-ux-audit/')}>free UX audit</a> you ask for, and to meet our legal obligations. We do not use
        it for advertising and we do not sell it.
      </p>
    </section>

    <section id="sharing">
      <h2>Sharing</h2>
      <p>
        We share personal information only with service providers that help us run the studio, such as our email and
        calendar tools, and when the law requires it or to protect our rights, property or safety.
      </p>
    </section>

    <section id="cookies">
      <h2>Cookies and tracking</h2>
      <p>
        The Website does not set cookies and does not use analytics, tracking pixels, advertising tags or session
        recording, so there is no cookie banner. Your browser may keep ordinary cached files so pages load faster. You
        can clear them at any time in your browser settings.
      </p>
    </section>

    <section id="third-parties">
      <h2>Third party services</h2>
      <p>
        When you follow a link off the Website, the other service applies its own privacy policy. These links include:
      </p>
      <ul>
        <li>
          <strong>Lemcal</strong>, where you book a call (
          <a href={LINKS.book} rel="noopener noreferrer">
            open the booking page
          </a>
          ).
        </li>
        <li>
          <strong>Dribbble</strong>, which the Playground links to for each shot (
          <a href={LINKS.dribbble} rel="noopener noreferrer">
            our profile
          </a>
          ).
        </li>
        <li>Our profiles on LinkedIn, Instagram, YouTube and Clutch, linked from the footer and the contact page.</li>
      </ul>
      <p>
        We are not responsible for how these services handle your data. Please read their policies before you use them.
      </p>
    </section>

    <section id="security">
      <h2>Data security</h2>
      <p>
        We take reasonable measures to protect the information we hold from unauthorized access, disclosure, alteration
        or destruction. No method of transmission over the internet or of electronic storage is completely secure, so we
        cannot guarantee absolute security.
      </p>
    </section>

    <section id="rights">
      <h2>Your rights</h2>
      <p>
        You can ask to access, update or delete the personal information we hold about you, and you can ask us to stop
        contacting you at any time. To do so, write to <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
      </p>
    </section>

    <section id="children">
      <h2>Children</h2>
      <p>
        The Website is not intended for children under 13. We do not knowingly collect personal information from
        children, and if we learn that we have, we will delete it.
      </p>
    </section>

    <section id="changes">
      <h2>Changes</h2>
      <p>
        We may update this policy to reflect changes in our practices or legal requirements. The updated version is
        posted on this page with a new date at the top.
      </p>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p>
        Questions about this policy or our privacy practices? Write to{' '}
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>. See also our{' '}
        <a href={url('/terms/')}>terms and conditions</a>.
      </p>
    </section>
  </LegalLayout>
</BaseLayout>
