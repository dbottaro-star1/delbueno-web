---
import BookCta from '../components/BookCta.astro';
import Faq from '../components/Faq.astro';
import PageHeader from '../components/PageHeader.astro';
import { engagementFaqs, engagements } from '../data/engagements';
import BaseLayout from '../layouts/BaseLayout.astro';
import { crumbs } from '../lib/schema';

const trail = crumbs({ name: 'Engagements', path: '/engagements/' });
---

<BaseLayout
  title="Engagements: Launch Sprint, Design Partner, Designer on Demand"
  description="Three ways to work with delbueno™ Studio: a fixed-scope Launch Sprint, an ongoing Design Partner team or flexible Designer on Demand capacity."
  breadcrumbs={trail}
>
  <PageHeader
    title="Engagements"
    eyebrow="How we work together"
    lede="Pick the model that fits your stage. Kickoff is the same day and first concepts arrive in 48 hours."
    crumbs={trail}
  />

  <section class="section">
    <div class="wrap">
      <ul class="grid">
        {
          engagements.map((e) => (
            <li class="card" id={e.slug}>
              <h2>{e.name}</h2>
              <p>{e.summary}</p>
              <p><strong>Best for:</strong> {e.bestFor}</p>
              <p>{e.description}</p>
              <ul class="list-check">{e.includes.map((item) => <li>{item}</li>)}</ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Faq items={engagementFaqs} />
    </div>
  </section>

  <BookCta />
</BaseLayout>

<style>
  .card h2 {
    font-size: var(--fs-lg);
  }

  .card strong {
    color: var(--ink);
    font-weight: 500;
  }
</style>
