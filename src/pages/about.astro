---
import AboutClients from '../components/about/AboutClients.astro';
import AboutLocation from '../components/about/AboutLocation.astro';
import AboutNumbers from '../components/about/AboutNumbers.astro';
import AboutQuotes from '../components/about/AboutQuotes.astro';
import AboutValues from '../components/about/AboutValues.astro';
import InfoCta from '../components/info/InfoCta.astro';
import InfoHero from '../components/info/InfoHero.astro';
import Steps from '../components/info/Steps.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOUNDER_ID, ORG_ID, WEBSITE_ID, crumbs } from '../lib/schema';
import { BRAND, FOUNDER, LINKS } from '../lib/site';
import { canonicalUrl } from '../lib/url';

const trail = crumbs({ name: 'About', path: '/about/' });
const steps = [
  {
    when: 'Today',
    title: 'Strategic kickoff',
    text: 'One focused call to align on goals and scope. We start the moment we hang up.',
  },
  {
    when: 'Within 24h',
    title: 'Your Notion portal',
    text: 'A dedicated workspace with your backlog, so you always see what is moving.',
  },
  {
    when: 'In 48h',
    title: 'First concepts',
    text: 'High-fidelity concepts you can react to, instead of weeks of waiting for a big reveal.',
  },
  {
    when: 'Throughout',
    title: 'A shared Slack channel',
    text: 'Direct line to the people doing the work. No email chains.',
  },
];
const description =
  'delbueno™ Studio is a founder-led product design and development studio in Punta del Este, Uruguay, working remote in US hours for B2B SaaS and startups.';
---

<BaseLayout
  title="About delbueno: Founder-Led Product Design Studio"
  description={description}
  breadcrumbs={trail}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      '@id': `${canonicalUrl('/about/')}#webpage`,
      url: canonicalUrl('/about/'),
      name: `About ${BRAND.name}`,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': ORG_ID },
      mainEntity: { '@id': FOUNDER_ID },
    },
  ]}
>
  <InfoHero
    eyebrow="About / Founder-led studio"
    title="More than a service."
    accent="We are in it with you."
    lede={`${BRAND.name} is a product design and development studio led by ${BRAND.founder}. We work remote from ${BRAND.locality}, ${BRAND.country}, synced with US hours, for B2B SaaS teams and ambitious startups.`}
    crumbs={trail}
    size="clamp(2.3rem, 7.2vw, 8rem)"
    maxWidth="100%"
  />

  <AboutNumbers />

  <section class="ip-sec" aria-labelledby="fo-h">
    <div class="wrap fo">
      <div class="fo-lead">
        <p class="label">Founder</p>
        <h2 class="ip-h2" id="fo-h" data-lines>
          Led by {FOUNDER.name}.
        </h2>
      </div>
      <div class="fo-body" data-reveal>
        <p class="fo-bio">{FOUNDER.bio}</p>
        <p class="fo-links">
          <a class="btn btn-ghost btn-sm" href={FOUNDER.linkedin} rel="me noopener noreferrer">
            LinkedIn
          </a>
          <a class="btn btn-ghost btn-sm" href={LINKS.dribbble} rel="me noopener noreferrer">
            Dribbble
          </a>
          <a class="btn btn-ghost btn-sm" href={LINKS.clutch} rel="me noopener noreferrer">
            Clutch
          </a>
        </p>
      </div>
    </div>
  </section>

  <AboutValues />
  <section class="ip-sec" aria-labelledby="ap-h">
    <div class="wrap">
      <div class="ip-head">
        <p class="label">How we work</p>
        <h2 class="ip-h2" id="ap-h" data-lines>
          Kickoff today. Concepts in 48 hours.
        </h2>
      </div>
      <Steps steps={steps} />
    </div>
  </section>
  <AboutLocation />
  <AboutClients />
  <AboutQuotes />
  <InfoCta
    heading="Should we start working?"
    sub="Tell us what you are building. We will tell you how we would approach it, on a 15 minute call."
  />

  <script>
    import { initClock } from '../scripts/info/clock';
    import { initInfoReveals } from '../scripts/info/reveal';
    initInfoReveals();
    initClock();
  </script>
</BaseLayout>

<style>
  .fo {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(32px, 5vw, 64px);
  }

  .fo-lead {
    grid-column: 1 / 7;
  }

  .fo-lead .ip-h2 {
    grid-column: auto;
  }

  .fo-body {
    grid-column: 7 / 13;
    align-self: end;
  }

  .fo-bio {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.5;
    color: rgb(242 242 245 / 0.82);
    text-wrap: pretty;
  }

  .fo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  @media (max-width: 1000px) {
    .fo-lead,
    .fo-body {
      grid-column: 1 / -1;
    }
  }
</style>
