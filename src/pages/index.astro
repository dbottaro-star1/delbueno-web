---
import Backdrop from '../components/home/Backdrop.astro';
import Band from '../components/home/Band.astro';
import Engagements from '../components/home/Engagements.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Hero from '../components/home/Hero.astro';
import Numbers from '../components/home/Numbers.astro';
import Playground from '../components/home/Playground.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Services from '../components/home/Services.astro';
import Speed from '../components/home/Speed.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Trust from '../components/home/Trust.astro';
import ShotLightbox from '../components/playground/ShotLightbox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomeShots, getWork } from '../lib/content';
import { BRAND } from '../lib/site';
import '../styles/home.css';

const work = (await getWork()).slice(0, 6);
const shots = await getHomeShots(12);
---

<BaseLayout
  title={`${BRAND.name}: Product design and development for B2B SaaS and startups`}
  description="delbueno™ Studio designs and builds products, websites and design systems for B2B SaaS teams and startups. Kickoff today. First concepts in 48 hours."
>
  <Backdrop />
  <Hero />
  <Band />
  <SelectedWork entries={work} />
  <Playground shots={shots} />
  <Trust />
  <Services />
  <Speed />
  <Numbers />
  <Testimonials />
  <Engagements />
  <FinalCta />
  <ShotLightbox />

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
