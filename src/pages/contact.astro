---
import InfoHero from '../components/info/InfoHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalUrl } from '../lib/url';
import { FOUNDER_ID, ORG_ID, WEBSITE_ID, crumbs } from '../lib/schema';
import { BRAND, LINKS, SOCIALS } from '../lib/site';

const trail = crumbs({ name: 'Contact', path: '/contact/' });
const description =
  'Book a 15 minute call with delbueno™ Studio or write to hello@delbuenostudio.com. Same day kickoff, first concepts in 48 hours, synced with US hours.';

const expect = [
  { k: 'Same day', t: 'Kickoff', d: 'One focused call to align on goals and scope. We start the moment we hang up.' },
  {
    k: '48 hours',
    t: 'First concepts',
    d: 'High-fidelity concepts to react to, not weeks of waiting for a big reveal.',
  },
  {
    k: 'GMT-3',
    t: 'Synced with US hours',
    d: 'We work from Uruguay on Latin America time, so your day and ours overlap.',
  },
];
---

<BaseLayout
  title="Contact: Book a 15 Minute Call"
  description={description}
  breadcrumbs={trail}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      '@id': `${canonicalUrl('/contact/')}#webpage`,
      url: canonicalUrl('/contact/'),
      name: `Contact ${BRAND.name}`,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': ORG_ID },
      mainEntity: { '@id': ORG_ID },
      contributor: { '@id': FOUNDER_ID },
    },
  ]}
>
  <InfoHero
    eyebrow="Contact / Talk to us"
    title="You are one message away."
    lede="Tell us what you are building. The fastest way to start is a 15 minute call, or write to us and we will reply."
    crumbs={trail}
    size="clamp(2.3rem, 7.4vw, 8.4rem)"
    maxWidth="100%"
  >
    <div class="ct-book" data-reveal>
      <a class="btn btn-primary ip-cta-btn" data-magnetic href={LINKS.book} rel="noopener noreferrer">
        Book a call{' '}
        <svg class="arr" aria-hidden="true">
          <use href="#i-arr"></use>
        </svg>
      </a>
      <p class="ct-note">15 minutes, booked on Lemcal.</p>
    </div>
  </InfoHero>

  <section class="ip-sec" aria-labelledby="ct-mail-h">
    <div class="wrap">
      <p class="label" id="ct-mail-h">
        Or write to us
      </p>
      <div class="ct-mail" data-reveal>
        <a class="ct-addr" href={`mailto:${BRAND.email}?subject=Hello%20delbueno`} aria-label={`Email ${BRAND.email}`}>
          <span class="ct-a">
            hello@
            <wbr />
            delbuenostudio.com
            <span class="ct-fx" aria-hidden="true">
              hello@
              <wbr />
              delbuenostudio.com
            </span>
          </span>
        </a>
        <div class="ct-actions">
          <button
            class="btn btn-ghost btn-sm ct-copy"
            type="button"
            data-copy={BRAND.email}
            data-copy-status="ct-status"
            hidden
          >
            <svg class="ct-ico" viewBox="0 0 16 16" aria-hidden="true">
              <rect
                x="5.5"
                y="5.5"
                width="8"
                height="8"
                rx="1.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <path
                d="M10.5 3.5v-.2A1.8 1.8 0 0 0 8.7 1.5H3.3a1.8 1.8 0 0 0-1.8 1.8v5.4a1.8 1.8 0 0 0 1.8 1.8h.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              />
            </svg>
            <span data-copy-label>Copy email</span>
          </button>
          <a class="btn btn-ghost btn-sm" href={`mailto:${BRAND.email}?subject=Hello%20delbueno`}>
            Open in your mail app
          </a>
        </div>
        <p class="sr-only" id="ct-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="ip-sec" aria-labelledby="ct-exp-h">
    <div class="wrap">
      <div class="ip-head">
        <p class="label">What to expect</p>
        <h2 class="ip-h2" id="ct-exp-h" data-lines>
          Fast, and in your time zone.
        </h2>
      </div>
      <ol class="ct-exp">
        {expect.map((e) => (
          <li data-reveal>
            <p class="ct-k">{e.k}</p>
            <h3>{e.t}</h3>
            <p class="ct-d">{e.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ip-sec ct-where" aria-labelledby="ct-where-h">
    <div class="wrap ct-where-grid">
      <div>
        <p class="label">Where we are</p>
        <h2 class="ct-where-h" id="ct-where-h" data-lines>
          {BRAND.locality}, {BRAND.country}.
        </h2>
        <p class="ct-d" data-reveal>
          Remote first, GMT-3. It is{' '}
          <span class="ct-now" data-clock>
            --:--
          </span>{' '}
          here right now.
        </p>
      </div>
      <ul class="tags ct-tags" data-reveal>
        {SOCIALS.map((s) => (
          <li>
            <a class="tag ct-tag" href={s.href} rel="me noopener noreferrer">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script>
    import { initClock } from '../scripts/info/clock';
    import { initCopy } from '../scripts/info/copy';
    import { initInfoReveals } from '../scripts/info/reveal';
    initInfoReveals();
    initClock();
    initCopy();
  </script>
</BaseLayout>

<style>
  .ct-book {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px clamp(20px, 3vw, 40px);
    margin-top: clamp(32px, 4.4vw, 64px);
  }

  .ct-note {
    color: var(--mute);
  }

  .ct-mail {
    margin-top: clamp(24px, 3vw, 44px);
    container-type: inline-size;
  }

  .ct-addr {
    display: block;
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
  }

  .ct-a {
    position: relative;
    display: inline-block;
    font: 800 min(5.5cqw, 7rem) / 1.02 var(--display);
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }

  .ct-fx {
    position: absolute;
    inset: 0;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.1s var(--out);
  }

  .ct-addr:focus-visible .ct-fx {
    clip-path: inset(0 0 0 0);
  }

  @media (hover: hover) and (pointer: fine) {
    .ct-addr:hover .ct-fx {
      clip-path: inset(0 0 0 0);
    }
  }

  .ct-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .ct-copy[hidden] {
    display: none;
  }

  .ct-ico {
    width: 16px;
    height: 16px;
  }

  .ct-copy.is-done {
    border-color: var(--lime);
    color: var(--lime);
  }

  .ct-exp {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .ct-exp li {
    padding: clamp(28px, 3.4vw, 48px) clamp(16px, 2vw, 32px) 0 0;
    container-type: inline-size;
  }

  .ct-exp li + li {
    padding-left: clamp(16px, 2vw, 32px);
    border-left: 1px solid var(--line);
  }

  .ct-k {
    font: 800 clamp(1.6rem, 11cqw, 4.4rem) / 0.95 var(--display);
    letter-spacing: -0.05em;
    background: var(--grad-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    padding-right: 0.05em;
    overflow-wrap: anywhere;
  }

  .ct-exp h3 {
    margin-top: 22px;
  }

  .ct-d {
    margin-top: 10px;
    color: var(--mute);
    max-width: 34ch;
  }

  .ct-where-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    align-items: end;
  }

  .ct-where-grid > div {
    grid-column: 1 / 9;
    min-width: 0;
  }

  .ct-where-h {
    margin-top: 18px;
    font: 800 clamp(2rem, 1rem + 4.3vw, 5.2rem) / 0.96 var(--display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .ct-now {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .ct-tags {
    grid-column: 9 / 13;
    justify-content: flex-end;
  }

  .ct-tag {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 18px;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .ct-tag:hover {
    color: var(--ink);
    border-color: rgb(255 255 255 / 0.3);
  }

  @media (max-width: 900px) {
    .ct-exp {
      grid-template-columns: 1fr;
    }

    .ct-exp li,
    .ct-exp li + li {
      padding: 28px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }

    .ct-where-grid > div,
    .ct-tags {
      grid-column: 1 / -1;
    }

    .ct-tags {
      justify-content: flex-start;
    }
  }
</style>
