---
import LegalLayout from '../components/info/LegalLayout.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { crumbs } from '../lib/schema';
import { BRAND } from '../lib/site';
import { url } from '../lib/url';

const trail = crumbs({ name: 'Accessibility', path: '/accessibility/' });
const sections = [
  { id: 'commitment', title: 'Our commitment' },
  { id: 'approach', title: 'Our approach' },
  { id: 'features', title: 'What the site does' },
  { id: 'limits', title: 'Known limits' },
  { id: 'feedback', title: 'Feedback' },
  { id: 'updates', title: 'Updates to this statement' },
];
---

<BaseLayout
  title="Accessibility statement"
  description="How delbuenostudio.com approaches accessibility: keyboard use, reduced motion, semantic structure, known limits and how to tell us about a barrier."
  breadcrumbs={trail}
>
  <LegalLayout
    title="Accessibility statement"
    lede="We want everyone to be able to use this site. Here is what we do, where we fall short, and how to tell us."
    updated="Last updated: October 13, 2026"
    crumbs={trail}
    sections={sections}
  >
    <section id="commitment">
      <h2>Our commitment</h2>
      <p>
        {BRAND.name} is committed to digital accessibility for people of all abilities. We keep improving the experience
        for everyone and apply the relevant accessibility standards and guidelines to our own website.
      </p>
    </section>

    <section id="approach">
      <h2>Our approach</h2>
      <ul>
        <li>
          <strong>Standard.</strong> We aim to follow the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA,
          developed by the W3C.
        </li>
        <li>
          <strong>Ongoing checks.</strong> We review the site as we change it and fix the problems we find. The site has
          not yet had an independent accessibility audit.
        </li>
        <li>
          <strong>Design.</strong> Accessibility is part of how we design the pages, not a layer added afterward.
        </li>
      </ul>
    </section>

    <section id="features">
      <h2>What the site does</h2>
      <ul>
        <li>
          <strong>Keyboard navigation.</strong> Every link, button and menu works with a keyboard, with a visible focus
          outline and a skip to content link.
        </li>
        <li>
          <strong>Reduced motion.</strong> If your device asks for reduced motion, animations, smooth scrolling and
          pinned effects are turned off and all content is visible.
        </li>
        <li>
          <strong>Structure.</strong> Pages use one main heading, a logical heading order, landmarks, and breadcrumbs.
        </li>
        <li>
          <strong>Text alternatives.</strong> Meaningful images have descriptive alternative text, and decorative ones
          are hidden from screen readers.
        </li>
        <li>
          <strong>Readable and responsive.</strong> Text uses relative sizes, layouts adapt from phones to large
          screens, and controls are sized for touch.
        </li>
        <li>
          <strong>Plain interactions.</strong> There are no forms, no timed content and no sound that plays on its own.
        </li>
      </ul>
    </section>

    <section id="limits">
      <h2>Known limits</h2>
      <ul>
        <li>
          The booking page is run by Lemcal, and the Playground links to Dribbble. We do not control the accessibility
          of those services.
        </li>
        <li>
          Playground clips are short silent loops that show design motion. They come with a text title and description.
        </li>
        <li>
          Some older journal articles may have gaps, such as a short image description. We are working through them.
        </li>
      </ul>
    </section>

    <section id="feedback">
      <h2>Feedback</h2>
      <p>
        If you hit an accessibility barrier or have a suggestion, write to{' '}
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a> and tell us the page and what happened. We will look into it
        as soon as we can. Your feedback helps us make the site better for everyone.
      </p>
    </section>

    <section id="updates">
      <h2>Updates to this statement</h2>
      <p>
        We review this statement from time to time and update it when our practices or standards change. See also our{' '}
        <a href={url('/privacy/')}>privacy policy</a> and <a href={url('/terms/')}>terms</a>.
      </p>
    </section>
  </LegalLayout>
</BaseLayout>
