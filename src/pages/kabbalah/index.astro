---
import { Image } from 'astro:assets';
import fotoAmanecer from '../../assets/kabbalah/amanecer.jpg';
import fotoCuaderno from '../../assets/kabbalah/cuaderno.jpg';
import fotoCuenco from '../../assets/kabbalah/cuenco.jpg';
import fotoEscribir from '../../assets/kabbalah/escribir-ventana.jpg';
import Arbol from '../../components/kabbalah/Arbol.astro';
import ListaDeEspera from '../../components/kabbalah/ListaDeEspera.astro';
import LogoVasija from '../../components/kabbalah/LogoVasija.astro';
import Telefono from '../../components/kabbalah/Telefono.astro';
import VasijaProgreso from '../../components/kabbalah/VasijaProgreso.astro';
import KabbalahLayout from '../../layouts/KabbalahLayout.astro';
import { APP, DAAT, ENERGIAS, KABBALAH_PATHS, TESTIMONIOS, VOZ_DE_KEVIN, ZONAS } from '../../kabbalah/app';
import { url } from '../../lib/url';

const title = `${APP.fullName}, con ${APP.teacher}`;
const description =
  'Vasija, la app de Kabbalah de Kevin Jakter para iPhone y Android: recorrés las diez energías del Árbol de la Vida y ves cómo se pinta tu Árbol.';

const nav = [
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Tu mapa', href: '#mapa' },
  { label: 'Preguntas', href: '#preguntas' },
];

// The start of the app, with real screens (public/kabbalah/pantallas/).
const comienzo = [
  {
    pantalla: 'vasija',
    titulo: 'Somos una vasija',
    texto: 'Tres preguntas para ver cómo llegás: más completo o más vacío, qué se te desborda, qué querés cambiar.',
    alt: 'Pantalla "Somos una vasija" de la app, con las respuestas elegidas.',
    nota: undefined as string | undefined,
  },
  {
    pantalla: 'radar',
    titulo: 'Dónde estás hoy',
    texto: 'Puntuás del 1 al 10 las diez áreas de tu vida. El radar se dibuja mientras respondés.',
    alt: 'Pantalla del radar inicial de la app, con las diez áreas puntuadas.',
    nota: 'se dibuja mientras respondés',
  },
  {
    pantalla: 'tu-arbol',
    titulo: 'Tu Árbol, hoy',
    texto: 'Con el radar y 24 situaciones cotidianas, la app pinta una primera lectura de tu Árbol.',
    alt: 'Pantalla "Tu Árbol, hoy" de la app: el Árbol pintado y una primera lectura.',
    nota: 'tu primera lectura',
  },
];

const pasos = [
  {
    titulo: 'Autodiagnóstico',
    texto:
      '¿Esa energía está en exceso, en falta o en equilibrio? La mirás con una situación concreta de tu vida, no en abstracto.',
  },
  {
    titulo: 'Ejercicio',
    texto:
      'Cada energía tiene el suyo, con nombre propio: “Qué me controla”, “La máscara”, “Un día limpio”, “La doble balanza”.',
  },
  {
    titulo: 'Compromiso',
    texto:
      'Una acción concreta para los próximos días, con recordatorio. Después la app te pregunta cómo te fue: lo hice, a medias o todavía no.',
  },
];

const estados = [
  { clase: 'equilibrio', nombre: 'En equilibrio' },
  { clase: 'falta', nombre: 'En falta' },
  { clase: 'exceso', nombre: 'En exceso' },
  { clase: 'sin', nombre: 'Sin recorrer' },
];

// The energies in a loop for the moving band under the hero.
const cinta = [...ENERGIAS, DAAT];

const principios = [
  {
    titulo: 'Hacer, no leer',
    texto: 'Cada pantalla te pide algo: responder, elegir, comprometerte. Lo que hay para leer es corto y va al punto.',
  },
  {
    titulo: 'A tu ritmo y sin culpa',
    texto: 'No hay rachas que se rompen ni avisos que te retan. Como mucho un recordatorio por día, y lo elegís vos.',
  },
  {
    titulo: 'Lenguaje universal',
    texto: 'No hace falta saber hebreo, ni conocer los nombres, ni creer en nada en particular para empezar.',
  },
  {
    titulo: 'Tu diario es tuyo',
    texto:
      'Lo que escribís lo ves solo vos. No se usa para publicidad ni para entrenar inteligencia artificial, y lo borrás cuando quieras.',
  },
];

const extras = [
  {
    titulo: 'Radar al principio y al final',
    texto: 'Del 1 al 10 en cada área, para ver cuánto cambiaste al completar el recorrido.',
  },
  {
    titulo: 'Diario con cierre del día',
    texto: 'Escribís lo que quieras y, a la noche, dos preguntas para cerrar el día.',
  },
  { titulo: 'Inventario de Luz', texto: 'Cinco preguntas una vez por mes, con tu historial a la vista.' },
];

const preguntas = [
  {
    q: '¿Necesito saber de Kabbalah para usarla?',
    a: 'No. La app no da nada por sabido: no hace falta conocer los nombres de las energías, saber hebreo ni tener una creencia en particular.',
  },
  {
    q: '¿Por qué se llama Vasija?',
    a: 'En la Kabbalah, la vasija es lo que recibe la luz. El recorrido empieza ahí: la primera pregunta es si hoy te sentís más completo o más vacío.',
  },
  { q: '¿Cuánto cuesta?', a: 'La app es gratis.' },
  {
    q: '¿Tengo que seguir un orden?',
    a: 'Te sugerimos ir de abajo hacia arriba, empezando por Maljut, como en el cuaderno de trabajo. Pero todo está abierto: podés ir a la energía que más te llame.',
  },
  {
    q: '¿Quién puede leer lo que escribo?',
    a: 'Solo vos. Tus respuestas y tu diario se guardan en tu cuenta y nunca se mandan a herramientas de análisis. Podés borrar tu cuenta y todo lo que escribiste desde la app.',
  },
  {
    q: '¿Cuándo sale y para qué teléfonos?',
    a: 'Sale para iPhone y Android. Estamos en las últimas pruebas: anotate en la lista de espera y te avisamos el día que esté en las tiendas.',
  },
];

// Example radar: where someone starts and where they end the first walk through the tree.
const RADAR_INICIAL = [6, 4, 5, 7, 3, 5, 4, 6, 5, 3];
const RADAR_FINAL = [7, 6, 6, 7, 5, 6, 6, 7, 6, 5];
const R = 92;
const punto = (i: number, valor: number) => {
  const angulo = -Math.PI / 2 + (i * 2 * Math.PI) / 10;
  const r = (R * valor) / 10;
  return `${(120 + r * Math.cos(angulo)).toFixed(1)},${(120 + r * Math.sin(angulo)).toFixed(1)}`;
};
const poligono = (valores: number[]) => valores.map((v, i) => punto(i, v)).join(' ');
const anillos = [2, 4, 6, 8, 10].map((v) => poligono(Array(10).fill(v)));
const ejes = ENERGIAS.map((_, i) => punto(i, 10));
const etiquetas = ENERGIAS.map((e, i) => {
  const [x, y] = punto(i, 12.4).split(',').map(Number);
  return { nombre: e.nombre, x, y };
});
---

<KabbalahLayout title={title} description={description} nav={nav}>
  <a slot="cta" class="k-boton k-boton-chico" href="#lista">
    Lista de espera
  </a>

  <section class="banda banda-gris banda-hero">
    <div class="hero k-envoltura">
      <div class="hero-texto">
        <p class="k-etiqueta hero-kicker">
          <span class="pastilla">
            <span class="pastilla-punto" aria-hidden="true"></span>Muy pronto
          </span>{' '}
          App para iPhone y Android
        </p>
        <h1>
          Kabbalah para <mark class="k-resalte">hacer</mark>, no para leer.
        </h1>
        <p class="hero-lede">
          El cuaderno de trabajo de {APP.teacher}, vivo en tu teléfono. Recorrés las diez energías del Árbol de la Vida,
          te autodiagnosticás, hacés un ejercicio y asumís un compromiso. A medida que respondés, tu Árbol se pinta.
        </p>
        <div class="hero-acciones" data-hero-cta>
          <a class="k-boton" href="#lista">
            Sumarme a la lista{' '}
            <span class="k-flecha" aria-hidden="true">
              →
            </span>
          </a>
          <a class="k-boton k-boton-secundario" href="#como-funciona">
            Ver cómo funciona
          </a>
        </div>
        <ul class="hero-sellos">
          <li>Gratis</li>
          <li>Sin rachas que se rompen</li>
          <li>No hace falta creer en nada</li>
        </ul>
      </div>

      <div class="hero-visual" data-parallax>
        <figure class="hero-hoja" aria-label="Así se ve tu Árbol a medida que avanzás">
          <Arbol animated note class="hero-arbol" />
          <figcaption class="k-etiqueta">Tu Árbol, en el recorrido</figcaption>
        </figure>
        <Telefono
          pantalla="bienvenida"
          oscura
          eager
          class="hero-telefono"
          alt="Pantalla de bienvenida de Vasija: el Árbol de la Vida, un mensaje de Kevin y el botón para empezar."
        />
        <div class="postit" aria-hidden="true">
          <span class="k-etiqueta">La pregunta que abre</span>
          <span class="k-mano">¿Qué parte de tu vida te está pidiendo atención?</span>
        </div>
      </div>
    </div>
  </section>

  <div class="cinta" aria-hidden="true">
    <div class="cinta-pista">
      {[0, 1].map(() => (
        <ul>
          {cinta.map((e) => (
            <li>
              <span class="cinta-nombre">{e.nombre}</span>
              <span class="cinta-hebreo" lang="he" dir="rtl">
                {e.hebreo}
              </span>
              <span class="cinta-luz" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <section class="banda banda-celeste" id="como-funciona" aria-labelledby="como-funciona-h">
    <div class="k-envoltura">
      <div class="seccion-cabeza" data-revelar>
        <p class="k-etiqueta">Cómo funciona</p>
        <h2 id="como-funciona-h">
          Diez minutos y tu Árbol <mark class="k-resalte">ya tiene color</mark>.
        </h2>
        <p>Así empieza la app. Son las pantallas reales, con las respuestas de alguien que recién arranca.</p>
      </div>
      <ol class="comienzo" data-revelar-grupo>
        {comienzo.map((c, i) => (
          <li>
            {c.nota && (
              <span class:list={['anota', `anota-${i + 1}`]} aria-hidden="true">
                <span class="k-mano">{c.nota}</span>
                <svg viewBox="0 0 60 40" width="60" height="40">
                  <path d="M4 6 C 24 4, 44 14, 52 32" />
                  <path d="M44 30 L 53 34 L 54 24" />
                </svg>
              </span>
            )}
            <Telefono pantalla={c.pantalla} alt={c.alt} class="comienzo-telefono" />
            <div class="comienzo-texto">
              <span class="paso-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="despues" data-revelar>
        <p class="k-mano despues-titulo">y después, en cada energía:</p>
        <ol class="pasos" data-revelar-grupo>
          {pasos.map((p, i) => (
            <li class="k-tarjeta paso">
              <span class="paso-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))}
        </ol>
        <ul class="estados-lista">
          {estados.map((e) => (
            <li>
              <span class:list={['estado-punto', e.clase]} aria-hidden="true" />
              {e.nombre}
            </li>
          ))}
        </ul>
      </div>

      <div class="k-llamado" data-revelar>
        <p class="k-llamado-texto">¿Querés ver tu Árbol pintarse?</p>
        <a class="k-boton" href="#lista">
          Quiero probarla{' '}
          <span class="k-flecha" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="banda banda-blanca" id="mapa" aria-labelledby="mapa-h">
    <div class="k-envoltura">
      <div class="seccion-cabeza" data-revelar>
        <p class="k-etiqueta">Tu mapa</p>
        <h2 id="mapa-h">Tres zonas, diez energías y un hilo.</h2>
        <p>
          El Árbol de la Vida ordena tu vida en tres zonas. Se recorre desde los cimientos, lo material, hasta el
          sentido.
        </p>
      </div>
      <ul class="cifras" data-revelar-grupo>
        <li>
          <span class="cifra" data-contar="10">
            10
          </span>{' '}
          energías
        </li>
        <li>
          <span class="cifra" data-contar="3">
            3
          </span>{' '}
          zonas
        </li>
        <li>
          <span class="cifra" data-contar="22">
            22
          </span>{' '}
          senderos
        </li>
        <li>
          <span class="cifra">1</span> Árbol, el tuyo
        </li>
      </ul>
      <div class="zonas" data-revelar-grupo>
        {ZONAS.map((z) => (
          <div class:list={['zona', `zona-${z.n}`]}>
            <p class="k-etiqueta">Zona {z.n}</p>
            <h3>{z.nombre}</h3>
            <ul>
              {ENERGIAS.filter((e) => e.zona === z.n).map((e) => (
                <li>
                  <span class="zona-nombre">{e.nombre}</span>
                  <span class="zona-hebreo" lang="he" dir="rtl">
                    {e.hebreo}
                  </span>
                  <span class="zona-area">{e.area}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="daat">
        <span class="zona-hebreo" lang="he" dir="rtl">
          {DAAT.hebreo}
        </span>
        <span>
          <strong>{DAAT.nombre}</strong> no se trabaja: es el hilo que une todo. Te espera con una sola pregunta.
        </span>
      </p>
      <div class="k-llamado" data-revelar>
        <p class="k-llamado-texto">Se empieza por los cimientos: Maljut.</p>
        <a class="k-boton" href="#lista">
          Avisame cuando salga{' '}
          <span class="k-flecha" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="banda banda-sol voz" aria-labelledby="voz-h">
    <div class="k-envoltura voz-in">
      <div class="voz-foto">
        <span class="voz-rayos" aria-hidden="true"></span>
        <Image
          src={fotoCuenco}
          alt="Un cuenco de cerámica blanca, vacío, sobre una mesa gris."
          widths={[360, 560, 800]}
          sizes="(min-width: 760px) 280px, 70vw"
          loading="lazy"
        />
        <span class="voz-sello" aria-hidden="true">
          <LogoVasija size={54} />
        </span>
      </div>
      <figure class="voz-cita" data-revelar>
        <h2 id="voz-h" class="k-etiqueta">
          La voz de {APP.teacher}
        </h2>
        <blockquote>
          <p class="voz-lema">
            {VOZ_DE_KEVIN.lema[0]}
            <span>{VOZ_DE_KEVIN.lema[1]}</span>
          </p>
          <p class="voz-texto">“{VOZ_DE_KEVIN.vasija}”</p>
        </blockquote>
        <figcaption>
          <strong>{APP.teacher}</strong>, maestro de Kabbalah. En la app, sus textos y sus audios te acompañan en cada
          energía.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="banda banda-noche principios" aria-labelledby="principios-h">
    <div class="k-envoltura">
      <div class="principios-cabeza">
        <div data-revelar>
          <p class="k-etiqueta">Cómo está pensada</p>
          <h2 id="principios-h">Hecha para acompañarte, no para engancharte.</h2>
        </div>
        <div class="principios-foto" data-revelar>
          <Image
            src={fotoCuaderno}
            alt="Una persona escribe a mano en un cuaderno, con el teléfono boca abajo sobre la mesa."
            widths={[480, 760, 1100]}
            sizes="(min-width: 960px) 520px, 92vw"
            loading="lazy"
          />
        </div>
      </div>
      <ul class="principios-lista" data-revelar-grupo>
        {principios.map((p, i) => (
          <li>
            <span class="principio-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
      <div class="k-llamado" data-revelar>
        <p class="k-llamado-texto">Gratis, a tu ritmo y sin culpa.</p>
        <a class="k-boton" href="#lista">
          Anotarme gratis{' '}
          <span class="k-flecha" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="banda banda-gris" aria-labelledby="seguir-h">
    <div class="k-envoltura seguir">
      <div class="seguir-texto" data-revelar>
        <p class="k-etiqueta">Con {APP.teacher}</p>
        <h2 id="seguir-h">Lo que el cuaderno en papel no puede hacer.</h2>
        <p>
          {APP.teacher} es maestro de Kabbalah uruguayo. Su cuaderno de trabajo, “{APP.workbook}”, propone recorrer el
          Árbol de la Vida escribiendo, no leyendo. La app es ese cuaderno, vivo: te recuerda tus compromisos, mide cómo
          cambiás con el tiempo y te muestra tu Árbol completo.
        </p>
        <ul class="extras" data-revelar-grupo>
          {extras.map((e) => (
            <li>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </li>
          ))}
        </ul>
        <div class="k-llamado">
          <a class="k-boton" href="#lista">
            Quiero el cuaderno vivo{' '}
            <span class="k-flecha" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>
      <div class="seguir-visual">
        <figure class="radar k-tarjeta" data-revelar>
          <svg
            viewBox="-40 -24 320 288"
            role="img"
            aria-label="Ejemplo de radar: al final del recorrido, el área cubierta es más grande que al principio."
          >
            {anillos.map((a) => (
              <polygon class="radar-anillo" points={a} />
            ))}
            {ejes.map((e) => (
              <line class="radar-eje" x1="120" y1="120" x2={e.split(',')[0]} y2={e.split(',')[1]} />
            ))}
            <polygon class="radar-inicial" points={poligono(RADAR_INICIAL)} />
            <polygon class="radar-final" points={poligono(RADAR_FINAL)} />
            {etiquetas.map((t) => (
              <text x={t.x} y={t.y + 3} text-anchor={t.x < 115 ? 'end' : t.x > 125 ? 'start' : 'middle'}>
                {t.nombre}
              </text>
            ))}
          </svg>
          <figcaption class="radar-leyenda">
            <span>
              <i class="radar-muestra inicial" aria-hidden="true"></i> Radar inicial
            </span>
            <span>
              <i class="radar-muestra final" aria-hidden="true"></i> Radar final
            </span>
          </figcaption>
        </figure>
        <Telefono
          pantalla="diagnostico"
          class="seguir-telefono"
          alt="Pantalla del diagnóstico de la app: una situación cotidiana con tres respuestas posibles."
        />
      </div>
    </div>
  </section>

  {TESTIMONIOS.length > 0 && (
    <section class="banda banda-blanca" aria-labelledby="testimonios-h">
      <div class="k-envoltura">
        <div class="seccion-cabeza" data-revelar>
          <p class="k-etiqueta">Quienes ya la probaron</p>
          <h2 id="testimonios-h">Lo que cuentan.</h2>
        </div>
        <ul class="testimonios" data-revelar-grupo>
          {TESTIMONIOS.map((t) => (
            <li class="k-tarjeta">
              <blockquote>
                <p>“{t.texto}”</p>
              </blockquote>
              <p class="testimonio-quien">
                <strong>{t.nombre}</strong>
                <span>{t.contexto}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="banda banda-pizarra" id="lista" aria-labelledby="lista-h">
    <div class="k-envoltura">
      <div class="lista-in">
        <div class="lista-texto">
          <p class="k-etiqueta">Lista de espera</p>
          <h2 id="lista-h">
            Enterate <mark class="k-resalte">primero</mark>.
          </h2>
          <p>
            La app está en las últimas pruebas para iPhone y Android. Dejanos tu correo y te avisamos el día que esté en
            las tiendas.
          </p>
          <ul class="lista-tiendas" aria-label="Sale para">
            <li>
              <span class="lista-tienda-n">iPhone</span> App Store, muy pronto
            </li>
            <li>
              <span class="lista-tienda-n">Android</span> Google Play, muy pronto
            </li>
          </ul>
          <p class="k-mano lista-mano">un solo correo, cuando salga</p>
          <div class="lista-foto">
            <Image
              src={fotoEscribir}
              alt="Una mujer escribe en su cuaderno junto a una ventana."
              widths={[420, 640, 900]}
              sizes="(min-width: 860px) 400px, 92vw"
              loading="lazy"
            />
          </div>
        </div>
        <div class="k-tarjeta lista-tarjeta">
          <ListaDeEspera />
        </div>
      </div>
    </div>
  </section>

  <section class="banda banda-celeste" id="preguntas" aria-labelledby="preguntas-h">
    <div class="k-envoltura preguntas">
      <div class="seccion-cabeza" data-revelar>
        <p class="k-etiqueta">Preguntas</p>
        <h2 id="preguntas-h">Lo que suelen preguntar.</h2>
      </div>
      <div class="k-preguntas">
        {preguntas.map((p) => (
          <details>
            <summary>{p.q}</summary>
            <div>
              <p>{p.a}</p>
            </div>
          </details>
        ))}
      </div>
      <p class="preguntas-mas">
        ¿Algo más? Mirá la página de <a href={url(KABBALAH_PATHS.support)}>soporte</a> o escribinos a{' '}
        <a href={`mailto:${APP.email}`}>{APP.email}</a>.
      </p>
    </div>
  </section>

  <section class="banda cierre" aria-labelledby="final-h">
    <Image src={fotoAmanecer} alt="" class="final-fondo" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
