---
import Arbol from '../../components/kabbalah/Arbol.astro';
import ListaDeEspera from '../../components/kabbalah/ListaDeEspera.astro';
import KabbalahLayout from '../../layouts/KabbalahLayout.astro';
import { APP, DAAT, ENERGIAS, KABBALAH_PATHS, ZONAS } from '../../kabbalah/app';
import { url } from '../../lib/url';

const title = `${APP.name}: el cuaderno vivo de ${APP.teacher}`;
const description =
  'App de Kabbalah con Kevin Jakter para iPhone y Android: recorrés las diez energías del Árbol de la Vida, hacés ejercicios y ves tu Árbol pintarse.';

const nav = [
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Tu mapa', href: '#mapa' },
  { label: 'Preguntas', href: '#preguntas' },
];

const pasos = [
  {
    titulo: 'Autodiagnóstico',
    texto:
      '¿Esa energía está en exceso, en falta o en equilibrio? La mirás con una situación concreta de tu vida, no en abstracto.',
  },
  {
    titulo: 'Ejercicio',
    texto:
      'Cada energía tiene el suyo, con nombre propio: “Qué me controla”, “La máscara”, “Un día limpio”, “La doble balanza”.',
  },
  {
    titulo: 'Compromiso',
    texto:
      'Una acción concreta para los próximos días, con recordatorio. Después la app te pregunta cómo te fue: lo hice, a medias o todavía no.',
  },
];

const estados = [
  { clase: 'equilibrio', nombre: 'En equilibrio' },
  { clase: 'falta', nombre: 'En falta' },
  { clase: 'exceso', nombre: 'En exceso' },
  { clase: 'sin', nombre: 'Sin recorrer' },
];

const principios = [
  {
    titulo: 'Hacer, no leer',
    texto: 'Cada pantalla te pide algo: responder, elegir, comprometerte. Lo que hay para leer es corto y va al punto.',
  },
  {
    titulo: 'A tu ritmo y sin culpa',
    texto: 'No hay rachas que se rompen ni avisos que te retan. Como mucho un recordatorio por día, y lo elegís vos.',
  },
  {
    titulo: 'Lenguaje universal',
    texto: 'No hace falta saber hebreo, ni conocer los nombres, ni creer en nada en particular para empezar.',
  },
  {
    titulo: 'Tu diario es tuyo',
    texto:
      'Lo que escribís lo ves solo vos. No se usa para publicidad ni para entrenar inteligencia artificial, y lo borrás cuando quieras.',
  },
];

const extras = [
  {
    titulo: 'Radar al principio y al final',
    texto: 'Del 1 al 10 en cada área, para ver cuánto cambiaste al completar el recorrido.',
  },
  {
    titulo: 'Diario con cierre del día',
    texto: 'Escribís lo que quieras y, a la noche, dos preguntas para cerrar el día.',
  },
  { titulo: 'Inventario de Luz', texto: 'Cinco preguntas una vez por mes, con tu historial a la vista.' },
];

const preguntas = [
  {
    q: '¿Necesito saber de Kabbalah para usarla?',
    a: 'No. La app no da nada por sabido: no hace falta conocer los nombres de las energías, saber hebreo ni tener una creencia en particular.',
  },
  { q: '¿Cuánto cuesta?', a: 'La app es gratis.' },
  {
    q: '¿Tengo que seguir un orden?',
    a: 'Te sugerimos ir de abajo hacia arriba, empezando por Maljut, como en el cuaderno de trabajo. Pero todo está abierto: podés ir a la energía que más te llame.',
  },
  {
    q: '¿Quién puede leer lo que escribo?',
    a: 'Solo vos. Tus respuestas y tu diario se guardan en tu cuenta y nunca se mandan a herramientas de análisis. Podés borrar tu cuenta y todo lo que escribiste desde la app.',
  },
  {
    q: '¿Cuándo sale y para qué teléfonos?',
    a: 'Sale para iPhone y Android. Estamos en las últimas pruebas: anotate en la lista de espera y te avisamos el día que esté en las tiendas.',
  },
];

// Example radar: where someone starts and where they end the first walk through the tree.
const RADAR_INICIAL = [6, 4, 5, 7, 3, 5, 4, 6, 5, 3];
const RADAR_FINAL = [7, 6, 6, 7, 5, 6, 6, 7, 6, 5];
const R = 92;
const punto = (i: number, valor: number) => {
  const angulo = -Math.PI / 2 + (i * 2 * Math.PI) / 10;
  const r = (R * valor) / 10;
  return `${(120 + r * Math.cos(angulo)).toFixed(1)},${(120 + r * Math.sin(angulo)).toFixed(1)}`;
};
const poligono = (valores: number[]) => valores.map((v, i) => punto(i, v)).join(' ');
const anillos = [2, 4, 6, 8, 10].map((v) => poligono(Array(10).fill(v)));
const ejes = ENERGIAS.map((_, i) => punto(i, 10));
const etiquetas = ENERGIAS.map((e, i) => {
  const [x, y] = punto(i, 12.4).split(',').map(Number);
  return { nombre: e.nombre, x, y };
});
---

<KabbalahLayout title={title} description={description} nav={nav}>
  <a slot="cta" class="k-boton k-boton-chico" href="#lista">
    Lista de espera
  </a>

  <section class="hero k-envoltura">
    <div class="hero-texto">
      <p class="k-etiqueta hero-kicker">
        <span class="pastilla">Muy pronto</span> App para iPhone y Android
      </p>
      <h1>Kabbalah para hacer, no para leer.</h1>
      <p class="hero-lede">
        El cuaderno de trabajo de {APP.teacher}, vivo en tu teléfono. Recorrés las diez energías del Árbol de la Vida,
        te autodiagnosticás, hacés un ejercicio y asumís un compromiso. A medida que respondés, tu Árbol se pinta.
      </p>
      <div class="hero-acciones">
        <a class="k-boton" href="#lista">
          Sumarme a la lista
        </a>
        <a class="k-boton k-boton-secundario" href="#como-funciona">
          Cómo funciona
        </a>
      </div>
      <p class="hero-nota">Gratis. Sin rachas que se rompen. No hace falta creer en nada.</p>
    </div>

    <figure class="hero-hoja" aria-label="Así se ve tu Árbol a medida que avanzás">
      <div class="postit" aria-hidden="true">
        <span class="k-etiqueta">La pregunta que abre</span>
        <span class="k-mano">¿Qué parte de tu vida te está pidiendo atención?</span>
      </div>
      <Arbol animated note class="hero-arbol" />
      <figcaption class="k-etiqueta">Tu Árbol, en el recorrido</figcaption>
    </figure>
  </section>

  <section class="seccion k-envoltura" id="como-funciona" aria-labelledby="como-funciona-h">
    <div class="seccion-cabeza">
      <p class="k-etiqueta">Cómo funciona</p>
      <h2 id="como-funciona-h">Diez energías, de abajo hacia arriba.</h2>
      <p>
        Empezás con un radar: del 1 al 10, cómo estás hoy en cada área de tu vida. Con eso tu Árbol aparece prepintado,
        como una primera hipótesis. Después, en cada energía:
      </p>
    </div>
    <ol class="pasos">
      {pasos.map((p, i) => (
        <li class="k-tarjeta paso">
          <span class="paso-n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
    <div class="estados">
      <p class="k-mano estados-titulo">y tu Árbol se pinta</p>
      <ul class="estados-lista">
        {estados.map((e) => (
          <li>
            <span class:list={['estado-punto', e.clase]} aria-hidden="true" />
            {e.nombre}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion k-envoltura" id="mapa" aria-labelledby="mapa-h">
    <div class="seccion-cabeza">
      <p class="k-etiqueta">Tu mapa</p>
      <h2 id="mapa-h">Tres zonas, diez energías y un hilo.</h2>
      <p>
        El Árbol de la Vida ordena tu vida en tres zonas. Se recorre desde los cimientos, lo material, hasta el sentido.
      </p>
    </div>
    <div class="zonas">
      {ZONAS.map((z) => (
        <div class:list={['zona', `zona-${z.n}`]}>
          <p class="k-etiqueta">Zona {z.n}</p>
          <h3>{z.nombre}</h3>
          <ul>
            {ENERGIAS.filter((e) => e.zona === z.n).map((e) => (
              <li>
                <span class="zona-nombre">{e.nombre}</span>
                <span class="zona-hebreo" lang="he" dir="rtl">
                  {e.hebreo}
                </span>
                <span class="zona-area">{e.area}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="daat">
      <span class="zona-hebreo" lang="he" dir="rtl">
        {DAAT.hebreo}
      </span>
      <span>
        <strong>{DAAT.nombre}</strong> no se trabaja: es el hilo que une todo. Te espera con una sola pregunta.
      </span>
    </p>
  </section>

  <section class="principios" aria-labelledby="principios-h">
    <div class="k-envoltura">
      <p class="k-etiqueta">Cómo está pensada</p>
      <h2 id="principios-h">Hecha para acompañarte, no para engancharte.</h2>
      <ul class="principios-lista">
        {principios.map((p) => (
          <li>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion k-envoltura seguir" aria-labelledby="seguir-h">
    <div class="seguir-texto">
      <p class="k-etiqueta">Con {APP.teacher}</p>
      <h2 id="seguir-h">Lo que el cuaderno en papel no puede hacer.</h2>
      <p>
        {APP.teacher} es maestro de Kabbalah uruguayo. Su cuaderno de trabajo, “{APP.tagline}”, propone recorrer el
        Árbol de la Vida escribiendo, no leyendo. La app es ese cuaderno, vivo: te recuerda tus compromisos, mide cómo
        cambiás con el tiempo y te muestra tu Árbol completo.
      </p>
      <ul class="extras">
        {extras.map((e) => (
          <li>
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </li>
        ))}
      </ul>
    </div>
    <figure class="radar k-tarjeta">
      <svg
        viewBox="-40 -24 320 288"
        role="img"
        aria-label="Ejemplo de radar: al final del recorrido, el área cubierta es más grande que al principio."
      >
        {anillos.map((a) => (
          <polygon class="radar-anillo" points={a} />
        ))}
        {ejes.map((e) => (
          <line class="radar-eje" x1="120" y1="120" x2={e.split(',')[0]} y2={e.split(',')[1]} />
        ))}
        <polygon class="radar-inicial" points={poligono(RADAR_INICIAL)} />
        <polygon class="radar-final" points={poligono(RADAR_FINAL)} />
        {etiquetas.map((t) => (
          <text x={t.x} y={t.y + 3} text-anchor={t.x < 115 ? 'end' : t.x > 125 ? 'start' : 'middle'}>
            {t.nombre}
          </text>
        ))}
      </svg>
      <figcaption class="radar-leyenda">
        <span>
          <i class="radar-muestra inicial" aria-hidden="true"></i> Radar inicial
        </span>
        <span>
          <i class="radar-muestra final" aria-hidden="true"></i> Radar final
        </span>
      </figcaption>
    </figure>
  </section>

  <section class="seccion lista-seccion" id="lista" aria-labelledby="lista-h">
    <div class="k-envoltura">
      <div class="lista-in">
        <div class="lista-texto">
          <p class="k-etiqueta">Lista de espera</p>
          <h2 id="lista-h">Enterate primero.</h2>
          <p>
            La app está en las últimas pruebas para iPhone y Android. Dejanos tu correo y te avisamos el día que esté en
            las tiendas.
          </p>
          <p class="k-mano lista-mano">un solo correo, cuando salga</p>
        </div>
        <div class="k-tarjeta lista-tarjeta">
          <ListaDeEspera />
        </div>
      </div>
    </div>
  </section>

  <section class="seccion k-envoltura preguntas" id="preguntas" aria-labelledby="preguntas-h">
    <div class="seccion-cabeza">
      <p class="k-etiqueta">Preguntas</p>
      <h2 id="preguntas-h">Lo que suelen preguntar.</h2>
    </div>
    <div class="k-preguntas">
      {preguntas.map((p) => (
        <details>
          <summary>{p.q}</summary>
          <div>
            <p>{p.a}</p>
          </div>
        </details>
      ))}
    </div>
    <p class="preguntas-mas">
      ¿Algo más? Mirá la página de <a href={url(KABBALAH_PATHS.support)}>soporte</a> o escribinos a{' '}
      <a href={`mailto:${APP.email}`}>{APP.email}</a>.
    </p>
  </section>
</KabbalahLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }

  .hero-texto {
    display: grid;
    gap: 24px;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pastilla {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--k-acento);
    color: var(--k-papel);
    font-size: 0.6875rem;
  }

  h1 {
    font-size: clamp(3rem, 1.6rem + 5.4vw, 5.75rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .hero-lede {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.4;
    color: var(--k-tinta-cuerpo);
    max-width: 34ch;
  }

  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-nota {
    font-style: italic;
    color: var(--k-tinta-suave);
  }

  .hero-hoja {
    position: relative;
    margin: 0;
    padding: clamp(28px, 4vw, 44px) clamp(18px, 3vw, 34px) 22px;
    background: var(--k-papel-tarjeta);
    border: 1px solid rgba(30, 37, 48, 0.08);
    border-radius: 3px;
    box-shadow:
      var(--k-sombra),
      0 40px 60px -50px rgba(30, 37, 48, 0.55);
    transform: rotate(1.2deg);
    display: grid;
    gap: 6px;
    justify-items: center;
  }

  .hero-hoja :global(.hero-arbol) {
    max-width: 440px;
  }

  .hero-hoja figcaption {
    font-size: 0.6875rem;
  }

  .postit {
    position: absolute;
    top: -26px;
    right: clamp(-10px, -1vw, 0px);
    width: 196px;
    display: grid;
    gap: 6px;
    padding: 14px 16px 18px;
    background: var(--k-postit);
    color: var(--k-postit-tinta);
    transform: rotate(-4deg);
    box-shadow: 0 16px 24px -18px rgba(58, 31, 42, 0.8);
    z-index: 2;
  }

  .postit .k-etiqueta {
    color: var(--k-postit-tinta);
    font-size: 0.625rem;
  }

  .postit .k-mano {
    color: var(--k-postit-tinta);
    font-size: 1.5rem;
    line-height: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .postit {
      animation: pegar 0.7s cubic-bezier(0.22, 1, 0.36, 1) 2.4s backwards;
    }
  }

  @keyframes pegar {
    from {
      opacity: 0;
      transform: translateY(-10px) rotate(-9deg);
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-hoja {
      margin-top: 24px;
    }

    .postit {
      position: relative;
      top: auto;
      right: auto;
      justify-self: end;
      width: 190px;
      margin: -58px -14px 6px 0;
    }
  }

  /* Sections */
  .seccion {
    padding-top: clamp(64px, 9vw, 128px);
  }

  .seccion-cabeza {
    display: grid;
    gap: 16px;
    max-width: 640px;
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .seccion-cabeza > p:not(.k-etiqueta) {
    color: var(--k-tinta-cuerpo);
    font-size: 1.25rem;
  }

  h2 {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1;
  }

  /* How it works */
  .pasos {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .paso {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .paso-n {
    font: 500 0.8125rem/1 var(--k-mono);
    letter-spacing: 0.12em;
    color: var(--k-acento);
  }

  .paso h3 {
    font-size: 1.625rem;
    line-height: 1.1;
  }

  .paso p {
    color: var(--k-tinta-cuerpo);
  }

  @media (max-width: 820px) {
    .pasos {
      grid-template-columns: 1fr;
    }
  }

  .estados {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 30px;
  }

  .estados-titulo {
    font-size: 2rem;
    line-height: 1;
  }

  .estados-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    padding: 0;
    font: 500 0.75rem/1 var(--k-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-tinta-suave);
  }

  .estados-lista li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .estado-punto {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex: none;
  }

  .estado-punto.equilibrio {
    background: var(--k-zona1);
    border: 1.5px solid var(--k-tinta);
  }

  .estado-punto.falta {
    background: var(--k-papel);
    border: 1.5px dashed var(--k-pizarra);
  }

  .estado-punto.exceso {
    background: var(--k-pizarra);
    box-shadow:
      0 0 0 4px rgba(47, 69, 96, 0.16),
      0 0 0 8px rgba(47, 69, 96, 0.07);
  }

  .estado-punto.sin {
    background: var(--k-papel-claro);
    border: 1px solid rgba(30, 37, 48, 0.45);
  }

  /* Map */
  .zonas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--k-tinta);
  }

  .zona {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px clamp(16px, 2.4vw, 30px) 28px;
    border-right: 1px solid var(--k-borde);
  }

  .zona:first-child {
    padding-left: 0;
  }

  .zona:last-child {
    border-right: 0;
  }

  .zona h3 {
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .zona ul {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .zona li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'nombre hebreo'
      'area area';
    column-gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--k-borde);
  }

  .zona-nombre {
    grid-area: nombre;
    font-size: 1.375rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .zona-nombre::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid var(--k-tinta);
  }

  .zona-1 .zona-nombre::before {
    background: var(--k-zona1);
  }

  .zona-2 .zona-nombre::before {
    background: var(--k-zona2);
  }

  .zona-3 .zona-nombre::before {
    background: var(--k-zona3);
  }

  .zona-hebreo {
    grid-area: hebreo;
    font: 400 1.375rem/1.2 var(--k-hebreo);
    color: var(--k-tinta-suave);
  }

  .zona-area {
    grid-area: area;
    padding-left: 22px;
    font: 400 0.75rem/1.6 var(--k-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-tinta-secundaria);
  }

  @media (max-width: 820px) {
    .zonas {
      grid-template-columns: 1fr;
    }

    .zona {
      padding-left: 0;
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--k-borde);
    }
  }

  .daat {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 22px;
    color: var(--k-tinta-suave);
    font-style: italic;
  }

  .daat strong {
    font-style: normal;
    font-weight: 500;
    color: var(--k-tinta);
  }

  /* Principles: the dark night blue of the welcome screen. */
  .principios {
    margin-top: clamp(64px, 8vw, 112px);
    padding: clamp(64px, 9vw, 120px) 0;
    background: var(--k-noche);
    color: var(--k-papel);
  }

  .principios .k-etiqueta {
    color: var(--k-acento-noche);
  }

  .principios h2 {
    margin-top: 16px;
    max-width: 16ch;
  }

  .principios-lista {
    list-style: none;
    padding: 0;
    margin-top: clamp(36px, 5vw, 60px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .principios-lista li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 18px;
