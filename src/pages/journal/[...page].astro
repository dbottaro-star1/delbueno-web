---
import type { GetStaticPaths, Page } from 'astro';
import BookCta from '../../components/BookCta.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournal, type JournalEntry } from '../../lib/content';
import { crumbs } from '../../lib/schema';
import { url } from '../../lib/url';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getJournal();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<JournalEntry>;
}
const { page } = Astro.props;

const trail = crumbs({ name: 'Journal', path: '/journal/' });
const pageTrail = page.currentPage > 1 ? [...trail, { name: `Page ${page.currentPage}`, path: `/journal/${page.currentPage}/` }] : trail;
const suffix = page.currentPage > 1 ? ` (page ${page.currentPage})` : '';
// Pagination links are built from the page number so they honour the base path.
const pageUrl = (n: number) => url(n === 1 ? '/journal/' : `/journal/${n}/`);
---

<BaseLayout
  title={`Journal${suffix}: notes on designing complex software`}
  description="Articles from delbueno™ Studio on UX for cloud, cybersecurity, DevOps and AI products, design systems and building B2B SaaS."
  breadcrumbs={pageTrail}
>
  <PageHeader title="Journal" eyebrow="Notes from the studio" lede="Practical writing on designing complex B2B software." crumbs={pageTrail} />

  <section class="section">
    <div class="wrap stack">
      {
        page.data.length > 0 ? (
          <div class="grid">{page.data.map((entry) => <PostCard entry={entry} />)}</div>
        ) : (
          <p class="lede">The first articles are on the way.</p>
        )
      }

      {
        page.lastPage > 1 && (
          <nav class="pager" aria-label="Journal pages">
            {page.currentPage > 1 && (
              <a class="btn btn-ghost btn-sm" href={pageUrl(page.currentPage - 1)} rel="prev">
                Newer posts
              </a>
            )}
            <span class="label">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.currentPage < page.lastPage && (
              <a class="btn btn-ghost btn-sm" href={pageUrl(page.currentPage + 1)} rel="next">
                Older posts
              </a>
            )}
          </nav>
        )
      }
    </div>
  </section>
  <BookCta />
</BaseLayout>

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }
</style>
