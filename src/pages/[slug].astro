---
/**
 * Journal posts live at the site root to keep the exact old WordPress URLs.
 * Static routes always win over this dynamic route, and getStaticPaths refuses
 * any post whose slug equals a built-in top-level route. The Spanish translations
 * are served from src/pages/es/blog/[slug].astro. Both render the Post view.
 */
import type { GetStaticPaths } from 'astro';
import { getAllJournal, getJournalEs, type JournalEntry } from '../lib/content';
import { assertSlugFree } from '../lib/routes';
import Post from '../views/Post.astro';

export const getStaticPaths = (async () => {
  const posts = await getAllJournal();
  // Checks that the Spanish posts and the table of translations agree before any page links to a twin.
  await getJournalEs();
  return posts.map((entry) => {
    assertSlugFree(entry.id);
    const legacy = entry.data.legacyPath.replace(/^\/?/, '/').replace(/\/?$/, '/');
    if (legacy !== `/${entry.id}/`) {
      console.warn(`[journal] ${entry.id}: legacyPath "${entry.data.legacyPath}" does not match the file name`);
    }
    return { params: { slug: entry.id }, props: { entry } };
  });
}) satisfies GetStaticPaths;

interface Props {
  entry: JournalEntry;
}
const { entry } = Astro.props;
---

<Post lang="en" entry={entry} />
